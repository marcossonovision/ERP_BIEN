async function unassignLicenseAjax(id) {

    showToast("Quitando asignación...", "info");

    try {
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        const fd = new FormData();
        fd.append("licenseId", id);
        if (token) fd.append("__RequestVerificationToken", token);

        const res = await fetch("/License/Unassign", {
            method: "POST",
            body: fd,
            credentials: "same-origin"
        });

        if (!res.ok) {
            showToast("Error al desasignar ❌", "error");
            return;
        }

        // ✅ ACTUALIZAR UI
        const row = document.querySelector(`tr[data-id="${id}"]`);
        if (!row) return;

        // Usuario → "-"
        row.children[7].textContent = "-";

        // Cambiar pills
        const assigned = row.children[5].querySelector("span");
        const available = row.children[6].querySelector("span");

        assigned.textContent = "Libre";
        assigned.className = "pill pill-inactive";

        available.textContent = "Disponible";
        available.className = "pill pill-active";

        // Cambiar botón
        const actions = row.querySelector(".actions-wrap");
        const code = row.children[0].textContent.trim();

actions.innerHTML = `
    <button type="button"
        class="btn-action"
        style="background: var(--c-success);"
        onclick="event.stopPropagation(); openAssignModal(${id});">
        👤 Asignar
    </button>

    <button type="button"
        class="btn-action btn-edit btn-history"
        onclick="event.stopPropagation(); loadHistoryLicense(${id}, ${JSON.stringify(code)});">
        🔍 Histórico
    </button>

    <button type="button"
        class="btn-action btn-delete"
        data-id="${id}"
        data-bs-toggle="modal"
        data-bs-target="#deleteModal"
        onclick="event.stopPropagation();">
        🗑️ Eliminar
    </button>
`;

     

        showToast("Licencia desasignada ✅", "success");

    } catch (e) {
        console.error(e);
        showToast("Error inesperado ❌", "error");
    }
}
const assignModalInstance = new bootstrap.Modal(document.getElementById("assignModal"));

function openAssignModal(id) {

    const assignLicenseId = document.getElementById("assignLicenseId");
    const assignUserId = document.getElementById("assignUserId");
    const assignSearch = document.getElementById("assignUserSearch");
    const assignResults = document.getElementById("assignUserResults");
    const assignSubmit = document.getElementById("assignSubmit");

    assignLicenseId.value = id;

    assignUserId.value = "";
    assignSubmit.disabled = true;
    assignSearch.value = "";
    assignResults.innerHTML = "";

    renderUserResults(window.usersList.slice(0, 15));

    assignModalInstance.show();
}

function renderUserResults(list) {

    const assignResults = document.getElementById("assignUserResults");
    const assignUserId = document.getElementById("assignUserId");
    const assignSubmit = document.getElementById("assignSubmit");
    const empty = document.getElementById("assignEmptyState");

    assignResults.innerHTML = "";

    if (!list.length) {
        empty.classList.remove("d-none");
        return;
    }

    empty.classList.add("d-none");

    list.forEach(u => {
        const b = document.createElement("button");
        b.type = "button";
        b.className = "list-group-item list-group-item-action";
        b.textContent = u.name;

        b.onclick = () => {
            assignUserId.value = u.id;
            assignSubmit.disabled = false;

            assignResults.querySelectorAll(".active")
                .forEach(x => x.classList.remove("active"));
            b.classList.add("active");
        };

        assignResults.appendChild(b);
    });
}



