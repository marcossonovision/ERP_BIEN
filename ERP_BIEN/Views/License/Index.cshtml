@using System.Text.Json
@model ERP_BIEN.ViewModels.LicenseIndexMvcViewModel

<link rel="stylesheet" href="~/css/licenses.css" asp-append-version="true">

@{
    ViewData["Title"] = "Licenses";

    void RenderQpHidden()
    {
        <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
        <input type="hidden" name="PageSize" value="@Model.PageSize" />
        <input type="hidden" name="Search" value="@Model.Search" />
        <input type="hidden" name="SearchProveedor" value="@Model.SearchProveedor" />
        <input type="hidden" name="SearchProducto" value="@Model.SearchProducto" />
        <input type="hidden" name="SearchAsignada" value="@Model.SearchAsignada" />
    }
   
    var highlightId = TempData["HighlightId"]?.ToString();

}

<div class="d-flex justify-content-between align-items-center mb-3">
  <div>
    <h2 class="mb-0 fw-semibold">Gestión de Licencias</h2>
    <small class="text-muted">
      Mostrando @(Model?.Licenses?.Count ?? 0) licencias
    </small>
  </div>

  <button type="button"
          class="btn-save-pro"
          data-bs-toggle="modal"
          data-bs-target="#createEditModal">
    ➕ Crear licencia
  </button>
</div>
<div class="row mb-3">

    <div class="col-md-3">
        <div class="card p-2 text-center">
            <h6>Total</h6>
            <h4>@Model.TotalLicenses</h4>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-2 text-center">
            <h6>Asignadas</h6>
            <h4 class="text-success">@Model.AssignedLicenses</h4>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-2 text-center">
            <h6>Libres</h6>
            <h4 class="text-secondary">@Model.FreeLicenses</h4>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-2 text-center">
            <h6>Uso</h6>
            <h4>@Model.UsagePercentage %</h4>
        </div>
    </div>

</div>

<!-- FILTROS -->
<form method="get" asp-action="Index" asp-controller="License">

    <div class="filters-shell mb-4">

        <!-- HEADER TOGGLE -->
        <div class="filters-head" onclick="toggleFilters()">

    <div>
        <div class="filters-title">Filtros de búsqueda</div>
        <div class="filters-sub">Refina los resultados</div>
    </div>

    <div id="filterArrow" class="filters-arrow">▼</div>

</div>

        <!-- BODY -->
        <div id="filtersBody" class="filters-body" style="display:none;">


            <div class="row g-3">

                <!-- BUSQUEDA -->
                <div class="col-md-3">
                    <label class="form-label text-muted small">
                        Búsqueda
                    </label>

                    <input type="text"
                           name="Search"
                           value="@Model.Search"
                           class="form-control"
                           placeholder="Código o producto" />
                </div>

                <!-- PROVEEDOR -->
                <div class="col-md-2">
                    <label class="form-label text-muted small">
                        Proveedor
                    </label>

                    <input type="text"
                           name="SearchProveedor"
                           value="@Model.SearchProveedor"
                           class="form-control" />
                </div>

                <!-- PRODUCTO -->
                <div class="col-md-2">
                    <label class="form-label text-muted small">
                        Producto
                    </label>

                    <input type="text"
                           name="SearchProducto"
                           value="@Model.SearchProducto"
                           class="form-control" />
                </div>

                <!-- ASIGNADA -->
                <div class="col-md-2">
                    <label class="form-label text-muted small">
                        Asignada
                    </label>

                    <select name="SearchAsignada" class="form-select">
                        <option value="">Todas</option>
                        <option value="true" selected="@(Model.SearchAsignada == "true")">Sí</option>
                        <option value="false" selected="@(Model.SearchAsignada == "false")">No</option>
                    </select>
                </div>

                <!-- PAGE SIZE -->
                <div class="col-md-2">
                    <label class="form-label text-muted small">
                        Page Size
                    </label>

                    <select name="PageSize" class="form-select">
                        <option value="5" selected="@(Model.PageSize == 5)">5</option>
                        <option value="10" selected="@(Model.PageSize == 10)">10</option>
                        <option value="25" selected="@(Model.PageSize == 25)">25</option>
                        <option value="50" selected="@(Model.PageSize == 50)">50</option>
                    </select>
                </div>

            </div>

            <!-- BOTONES -->
            <div class="filters-actions">


                <div>

                    <button type="submit"
                            class="btn-filter-pro">
                        🔎 Filtrar
                    </button>

                
                </div>

                
            </div>

        </div>

    </div>

</form>

<!-- ========================= -->
<!-- CHIPS FILTROS ACTIVOS -->
<!-- ========================= -->
<div class="mb-3 d-flex flex-wrap gap-2">

    @if (!string.IsNullOrWhiteSpace(Model.Search))
    {
        <span class="chip">
            Búsqueda: @Model.Search
            <a class="x"
               href="@Url.Action("Index", new {
                   Search = (string)null,
                   SearchProveedor = Model.SearchProveedor,
                   SearchProducto = Model.SearchProducto,
                   SearchAsignada = Model.SearchAsignada
               })">✕</a>
        </span>
    }

    @if (!string.IsNullOrWhiteSpace(Model.SearchProveedor))
    {
        <span class="chip">
            Proveedor: @Model.SearchProveedor
            <a class="x"
               href="@Url.Action("Index", new {
                   Search = Model.Search,
                   SearchProveedor = (string)null,
                   SearchProducto = Model.SearchProducto,
                   SearchAsignada = Model.SearchAsignada
               })">✕</a>
        </span>
    }

    @if (!string.IsNullOrWhiteSpace(Model.SearchProducto))
    {
        <span class="chip">
            Producto: @Model.SearchProducto
            <a class="x"
               href="@Url.Action("Index", new {
                   Search = Model.Search,
                   SearchProveedor = Model.SearchProveedor,
                   SearchProducto = (string)null,
                   SearchAsignada = Model.SearchAsignada
               })">✕</a>
        </span>
    }

    @if (!string.IsNullOrWhiteSpace(Model.SearchAsignada))
    {
        <span class="chip">
            Asignada: @(Model.SearchAsignada == "true" ? "Sí" : "No")
            <a class="x"
               href="@Url.Action("Index", new {
                   Search = Model.Search,
                   SearchProveedor = Model.SearchProveedor,
                   SearchProducto = Model.SearchProducto,
                   SearchAsignada = (string)null
               })">✕</a>
        </span>
    }

    @{
        var hasFilters =
            !string.IsNullOrWhiteSpace(Model.Search) ||
            !string.IsNullOrWhiteSpace(Model.SearchProveedor) ||
            !string.IsNullOrWhiteSpace(Model.SearchProducto) ||
            !string.IsNullOrWhiteSpace(Model.SearchAsignada);
    }

    @if (hasFilters)
    {
        <a class="btn btn-sm btn-ortec btn-ortec-danger ms-2"
           href="@Url.Action("Index")">
            ✖ Limpiar todo
        </a>
    }

</div>

<!-- TABLA -->
<!-- TABLA -->
<div class="table-shell mb-3">
  <div class="table-responsive" style="overflow: visible;">
    <table class="table-style align-middle text-center">

      <thead>
        <tr>
          <th>Código</th>
          <th>Producto</th>
          <th>Proveedor</th>
          <th>Precio</th>
          <th>Caducidad</th>
          <th>Asignada</th>
          <th>Disponible</th>
          <th>Usuario</th>
          <th>Acciones</th>
        </tr>
      </thead>

      <tbody>
        @if (Model.Licenses == null || !Model.Licenses.Any())
        {
          <tr>
            <td colspan="9" class="text-center text-muted">No hay registros</td>
          </tr>
        }
        else
        {
          foreach (var item in Model.Licenses)
          {
            <tr class="clickable-row @(highlightId == item.Id.ToString() ? "highlight-row" : "")"
                data-id="@item.Id"
                style="cursor:pointer">

              <td>@item.Code</td>
              <td>@item.Producto</td>
              <td>@item.Proveedor</td>
              <td>@item.Price</td>
              <td>@(item.Caducidad?.ToString("yyyy-MM-dd") ?? "-")</td>

              <td>
                <span class="pill @(item.UserId != null ? "pill-active" : "pill-inactive")">
                  @(item.UserId.HasValue ? "Asignada" : "Libre")
                </span>
              </td>

              <td>
                <span class="pill @(item.UserId == null ? "pill-active" : "pill-inactive")">
                  @(item.UserId.HasValue ? "Ocupada" : "Disponible")
                </span>
              </td>

              <td>@(item.User != null ? $"{item.User.Name} {item.User.LastName}" : "-")</td>

              <td>
                <div class="actions-wrap">

                  <button type="button"
    class="btn-action btn-edit btn-history"
    onclick="event.stopPropagation(); loadHistoryLicense(@item.Id, '@item.Code');">
    🔍 Histórico
</button>


                  @if (!item.UserId.HasValue)
                  {
                    <button type="button"
    class="btn-action"
    style="background: var(--c-success);"
    onclick="event.stopPropagation(); openAssignModal(@item.Id);">
    👤 Asignar
</button>
    }
                  else
                  {
                    <form class="d-inline"
      method="post"
      asp-action="Unassign"
      asp-controller="License"
      onclick="event.stopPropagation();"
      onsubmit="showToast('Quitando asignación...', 'info')">

    <button type="button"
        class="btn-action"
        style="background:#6c757d;"
        onclick="event.stopPropagation(); unassignLicenseAjax(@item.Id);">
    ❌ Quitar
</button>


</form>
                  }

                  <button type="button"
                          class="btn-action btn-delete"
                          data-id="@item.Id"
                          data-bs-toggle="modal"
                          data-bs-target="#deleteModal"
                          onclick="event.stopPropagation();">
                    🗑️ Eliminar
                  </button>

                </div>
              </td>

            </tr>
          }
        }
      </tbody>

    </table>
  </div>
</div>  

<!-- PAGINACIÓN -->
<nav aria-label="Page navigation" class="mt-3">
    <ul class="pagination justify-content-center">

        <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
            @if (Model.PageNumber > 1)
            {
                <a class="page-link"
                       asp-action="Index"
                       asp-controller="License"
                       asp-route-PageNumber="@(Model.PageNumber - 1)"
                       asp-route-PageSize="@Model.PageSize"
                       asp-route-Search="@Model.Search"
                       asp-route-SearchProveedor="@Model.SearchProveedor"
                       asp-route-SearchProducto="@Model.SearchProducto"
                       asp-route-SearchAsignada="@Model.SearchAsignada">
                    Anterior
                </a>
            }
            else
            {
                <span class="page-link">Anterior</span>
            }
        </li>

        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(Model.PageNumber == i ? "active" : "")">
                <a class="page-link"
                       asp-action="Index"
                       asp-controller="License"
                       asp-route-PageNumber="@i"
                       asp-route-PageSize="@Model.PageSize"
                       asp-route-Search="@Model.Search"
                       asp-route-SearchProveedor="@Model.SearchProveedor"
                       asp-route-SearchProducto="@Model.SearchProducto"
                       asp-route-SearchAsignada="@Model.SearchAsignada">
                    @i
                </a>
            </li>
        }

        <li class="page-item @(Model.PageNumber == Model.TotalPages || Model.TotalPages == 0 ? "disabled" : "")">
            @if (Model.TotalPages > 0 && Model.PageNumber < Model.TotalPages)
            {
                <a class="page-link"
                       asp-action="Index"
                       asp-controller="License"
                       asp-route-PageNumber="@(Model.PageNumber + 1)"
                       asp-route-PageSize="@Model.PageSize"
                       asp-route-Search="@Model.Search"
                       asp-route-SearchProveedor="@Model.SearchProveedor"
                       asp-route-SearchProducto="@Model.SearchProducto"
                       asp-route-SearchAsignada="@Model.SearchAsignada">
                    Siguiente
                </a>
            }
            else
            {
                <span class="page-link">Siguiente</span>
            }
        </li>

    </ul>
</nav>

<!-- MODAL: DETALLES (PRO) -->
<div class="modal fade modal-pro" id="detailsModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content modal-pro-card">

      <!-- HEADER PRO -->
      <div class="modal-header modal-pro-header">
        <div class="d-flex align-items-center gap-3">
          <div class="modal-pro-icon">🔎</div>
          <div>
            <h5 class="modal-title fw-bold mb-0">Detalles de la licencia</h5>
            <div class="small opacity-75" id="detailsSubtitle">Información completa</div>
          </div>
        </div>

        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>

      <!-- BODY -->
      <div class="modal-body" id="detailsBody">
        <div class="text-center text-muted py-3">Cargando...</div>
      </div>

      <!-- FOOTER PRO -->
      <div class="modal-footer modal-pro-footer">
        <button type="button"
                class="btn-save-pro"
                onclick="openEditLicenseFromDetails()">
          ✏️ Editar
        </button>

        <button type="button"
                class="btn-cancel-pro"
                data-bs-dismiss="modal">
          Cerrar
        </button>
      </div>

    </div>
  </div>
</div>


<!-- HISTORY MODAL (PRO - IGUAL QUE DEVICES) -->
<div class="modal fade modal-pro" id="historyModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content modal-pro-card">

      <div class="modal-header modal-pro-header">
        <div class="d-flex align-items-center gap-3">
          <div class="modal-pro-icon">📜</div>
          <div>
            <h5 class="modal-title fw-bold mb-0">Histórico</h5>
            <div class="small opacity-75" id="history-license-name">—</div>
          </div>
        </div>

        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body p-4">
        <div id="historyTimeline" class="history-timeline"></div>

        <div id="historyEmpty"
             class="text-center text-muted py-5"
             style="display:none;">
          Sin histórico disponible
        </div>
      </div>

      <div class="modal-footer modal-pro-footer">
        <button type="button" class="btn-cancel-pro" data-bs-dismiss="modal">
          Cerrar
        </button>
      </div>

    </div>
  </div>
</div>


<!-- MODAL: CREATE / EDIT (PRO) -->
<div class="modal fade modal-pro" id="createEditModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content modal-pro-card">

      <form id="createEditForm"
            method="post"
            asp-action="Create"
            asp-controller="License"
            onsubmit="showToast('Guardando licencia...', 'info')">

        <!-- HEADER -->
        <div class="modal-header modal-pro-header d-flex align-items-center justify-content-between">

          <div class="d-flex align-items-center gap-3">

            <div class="modal-pro-icon">🧾</div>

            <div>
              <h5 class="modal-title fw-bold mb-0" id="createEditTitle">
                Crear licencia
              </h5>
              <div class="small opacity-75" id="createEditSubtitle">
                Alta de licencia en el inventario
              </div>
            </div>

          </div>

          <button type="button"
                  class="btn-close btn-close-white"
                  data-bs-dismiss="modal"
                  aria-label="Cerrar">
          </button>

        </div>

        <!-- BODY PRO -->
        <div class="modal-body">

          <!-- PREVIEW PRO -->
          <div class="edit-preview">
            <div class="edit-preview-name" id="lic-preview-title">—</div>
            <div class="edit-preview-domain" id="lic-preview-sub">
              Completa los campos para guardar
            </div>
          </div>

          <input type="hidden" id="LicenseId" name="Id" value="0" />

          <div class="row g-3 form-pro">

            <div class="col-md-6">
              <label class="form-label">Código</label>
              <input class="form-control" id="Code" name="Code" placeholder="Ej: LIC-0001" />
            </div>

            <div class="col-md-6">
              <label class="form-label">Proveedor</label>
              <input class="form-control" id="Proveedor" name="Proveedor" placeholder="Ej: Microsoft" />
            </div>

            <div class="col-md-8">
              <label class="form-label">Producto</label>
              <input class="form-control" id="Producto" name="Producto" placeholder="Ej: Microsoft 365 E3" />
            </div>

            <div class="col-md-4">
              <label class="form-label">Precio</label>
              <input type="text" class="form-control" id="Price" name="Price" placeholder="Ej: 150.00" />
            </div>

            <div class="col-md-6">
              <label class="form-label">Caducidad</label>
              <input type="date" class="form-control" id="Caducidad" name="Caducidad" />
            </div>

            <div class="col-md-6">
              <label class="form-label">Usuario asignado (opcional)</label>

              <input class="form-control"
                     id="UserId"
                     name="UserId"
                     type="number"
                     min="1"
                     placeholder="Id usuario (opcional)" />

              <div class="text-muted small mt-1">
                Si indicas UserId, se asigna y se marca no disponible.
              </div>

            </div>

          </div>
        </div>

        <!-- FOOTER PRO -->
        <div class="modal-footer modal-pro-footer">

          <button type="button"
                  class="btn-cancel-pro"
                  data-bs-dismiss="modal">
            Cancelar
          </button>

          <button type="submit"
                  class="btn-save-pro"
                  id="createEditSubmit">
            💾 Guardar
          </button>

        </div>

      </form>

    </div>
  </div>
</div>


<!-- DELETE MODAL PRO (ESTILO LIMPIO) -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-md">
    <div class="modal-content"
         style="border-radius:16px; box-shadow:0 12px 40px rgba(0,0,0,.2); overflow:hidden; border:1px solid #E6EAF2;">

      <form id="deleteForm"
            method="post"
            asp-action="Delete"
            asp-controller="License"
            onsubmit="showToast('Eliminando licencia...', 'info')">

        <!-- HEADER -->
        <div class="modal-header d-flex align-items-center justify-content-between">

          <div class="d-flex align-items-center gap-3">

            <div style="width:40px;height:40px;border-radius:999px;background:#F2F4F8;display:flex;align-items:center;justify-content:center;">
              🗑️
            </div>

            <div>
              <h5 class="modal-title fw-bold mb-0">Eliminar licencia</h5>
              <div class="text-muted small">
                Esta acción no se puede deshacer
              </div>
            </div>

          </div>

          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>

        </div>

        <!-- BODY -->
        <div class="modal-body text-center pt-2 pb-2">

          <input type="hidden" name="id" id="deleteId" />

          <div class="mb-3" style="font-size:1.1rem;">
            ⚠️ ¿Seguro que deseas eliminar esta licencia?
          </div>

          <div class="text-muted small">
            El registro se eliminará permanentemente
          </div>

        </div>

        <!-- FOOTER -->
        <div class="modal-footer border-0 pt-0">

          <button type="button"
                  class="btn-cancel-pro"
                  data-bs-dismiss="modal">
            Cancelar
          </button>

          <button type="submit"
                  class="btn-pill"
                  style="background:#DC3545; color:#fff;">
            🗑️ Eliminar
          </button>

        </div>

      </form>

    </div>
  </div>
</div>
<!-- ✅ MODAL: ASIGNAR (BUSCADOR) -->
<div class="modal fade" id="assignModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <form id="assignForm" method="post" asp-action="Assign" asp-controller="License" onsubmit="showToast('Asignando licencia...', 'info')">
                @Html.AntiForgeryToken()
                @{
                    RenderQpHidden();
                }

                <div class="modal-header">
                    <h5 class="modal-title">Asignar licencia</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" name="id" id="assignLicenseId" />
                    <input type="hidden" name="userId" id="assignUserId" />

                    <label class="form-label">Buscar usuario</label>
                    <input type="text" class="form-control" id="assignUserSearch"
                           placeholder="Escribe nombre o apellido..." autocomplete="off" />

                    <div class="list-group mt-2" id="assignUserResults" style="max-height:260px; overflow:auto;">
                    </div>
                    <div id="assignEmptyState" class="text-muted small mt-2 d-none">
                        No hay usuarios que coincidan.
                    </div>

                    <div class="text-muted small mt-2">
                        Selecciona un usuario de la lista para habilitar “Asignar”.
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary" id="assignSubmit" disabled>Asignar</button>
                </div>
            </form>

        </div>
    </div>
</div>

<div class="position-fixed top-0 end-0 p-3" style="z-index: 9999">

    <div id="appToast" class="toast align-items-center text-white border-0" role="alert">

        <div class="d-flex">

            <div id="toastMessage" class="toast-body">
                Mensaje
            </div>

            <button type="button"
                    class="btn-close btn-close-white me-2 m-auto"
                    data-bs-dismiss="toast">
            </button>

        </div>

    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            window.usersList = @Html.Raw(JsonSerializer.Serialize(
                                                    (Model.Users ?? new List<ERP_BIEN.Models.User>())
                                                                    .Select(u => new { id = u.Id, name = ((u.Name ?? "") + " " + (u.LastName ?? "")).Trim() })
                                                                    .OrderBy(x => x.name)
                                                                    .ToList()
                                    ));

            // CLICK FILA -> detalles
            document.querySelectorAll(".clickable-row").forEach(row => {
                row.addEventListener("click", function (e) {
                    if (e.target.closest("button") || e.target.closest("form") || e.target.closest("input")) return;
                    loadDetails(row.dataset.id);
                });
            });

            // Eliminar
            document.querySelectorAll(".btn-delete").forEach(btn => {
                btn.addEventListener("click", function (e) {
                    e.stopPropagation();
                    document.getElementById("deleteId").value = this.dataset.id;
                });
            });


// =========================
// HISTÓRICO PRO (IGUAL QUE DEVICES)
// =========================
const historyModalEl = document.getElementById("historyModal");
const historyModal = historyModalEl ? bootstrap.Modal.getOrCreateInstance(historyModalEl) : null;

document.querySelectorAll(".btn-history").forEach(btn => {
  btn.addEventListener("click", async function (e) {
    e.stopPropagation();

    const licenseId = this.dataset.id;
    const code = this.dataset.code || "Licencia";

    await loadHistoryLicense(licenseId, code);
  });
});

async function loadHistoryLicense(licenseId, code) {

  const nameEl   = document.getElementById("history-license-name");
  const timeline = document.getElementById("historyTimeline");
  const empty    = document.getElementById("historyEmpty");

  if (nameEl) nameEl.innerText = code;

  if (timeline) timeline.innerHTML = "";
  if (empty) { empty.style.display = "none"; empty.innerText = "Sin histórico disponible"; }

  const url = `/License/HistoryJson?licenseId=${encodeURIComponent(licenseId)}`;

  try {
    const res = await fetch(url, { headers: { "Accept": "application/json" } });

    if (!res.ok) throw new Error(`HTTP ${res.status}`);

    // ✅ Si devuelve HTML (redirect/login), no rompas
    const ct = res.headers.get("content-type") || "";
    if (!ct.includes("application/json")) {
      const txt = await res.text();
      console.error("History License NO JSON:", ct, txt);
      throw new Error("El histórico no devolvió JSON (posible redirect/vista HTML).");
    }

    const rows = await res.json();

    if (!rows || rows.length === 0) {
      if (empty) empty.style.display = "block";
      historyModal?.show();
      return;
    }

    rows.forEach(r => {
      // soporta camelCase y PascalCase
      const user = r.userName ?? r.UserName ?? "-";
      const start = r.startDate ?? r.StartDate ?? "-";
      const end = r.endDate ?? r.EndDate ?? null;
      const duration = r.duration ?? r.Duration ?? (end ? "" : "ACTUAL");

      const title = `Asignado a ${user}`;
      const date  = start;
      const desc  = end
        ? `Desde ${start} → ${end} · ${duration}`
        : `Desde ${start} → ACTUAL · ${duration}`;

      const item = document.createElement("div");
      item.className = "history-item";
      item.innerHTML = `
        <div class="dot"></div>
        <div class="content">
          <div class="d-flex justify-content-between">
            <div class="fw-bold">${escapeHtml(title)}</div>
            <div class="text-muted small">${escapeHtml(date)}</div>
          </div>
          <div class="text-muted small">${escapeHtml(desc)}</div>
        </div>
      `;

      timeline.appendChild(item);
    });

    historyModal?.show();

  } catch (err) {
    console.error("Error cargando histórico licencia:", err);

    if (empty) {
      empty.style.display = "block";
      empty.innerText = "Error cargando histórico ❌";
    }

    historyModal?.show();
  }
}

         


