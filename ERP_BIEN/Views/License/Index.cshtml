        // ✅ 👉 ESTA ES LA FUNCIÓN QUE TE FALTABA
        function openEditLicenseFromDetails() {

            const id = window.currentLicenseId;

            if (!id) return;

            fetch('/License/DetailsJson?id=' + id)
                .then(r => r.json())
                .then(d => {

                    document.getElementById("LicenseId").value = d.id;
                    document.getElementById("Code").value = d.code ?? "";
                    document.getElementById("Producto").value = d.producto ?? "";
                    document.getElementById("Proveedor").value = d.proveedor ?? "";
                    document.getElementById("Price").value = d.price ?? "";
                    document.getElementById("Caducidad").value = d.caducidad ?? "";
                    document.getElementById("UserId").value = d.userId ?? "";

                    // modo editar
                    document.getElementById("createEditForm").action = "/License/Edit";
                    document.getElementById("createEditTitle").innerText = "Editar licencia";

                    // cerrar details
                    bootstrap.Modal.getInstance(document.getElementById("detailsModal")).hide();

                    // abrir modal editar
                    new bootstrap.Modal(document.getElementById("createEditModal")).show();
                });
        }

        // limpiar filtros
        window.erpClearFiltersAndSubmit = function (form) {
            if (!form) return;
            form.querySelectorAll("input[type='text']").forEach(i => i.value = "");
            form.querySelectorAll("select").forEach(s => s.selectedIndex = 0);
            form.submit();
        };
                function toggleFilters() {

            const body = document.getElementById("filtersBody");
            const arrow = document.getElementById("filterArrow");

            if (body.style.display === "none") {
                body.style.display = "block";
                arrow.innerText = "▲";
            } else {
                body.style.display = "none";
                arrow.innerText = "▼";
            }
        }

     
