@using System.Text.Json
@model ERP_BIEN.ViewModels.LicenseIndexMvcViewModel

<link rel="stylesheet" href="~/css/licenses.css" asp-append-version="true">

@{
    ViewData["Title"] = "Licenses";

    void RenderQpHidden()
    {
        <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
        <input type="hidden" name="PageSize" value="@Model.PageSize" />
        <input type="hidden" name="Search" value="@Model.Search" />
        <input type="hidden" name="SearchProveedor" value="@Model.SearchProveedor" />
        <input type="hidden" name="SearchProducto" value="@Model.SearchProducto" />
        <input type="hidden" name="SearchAsignada" value="@Model.SearchAsignada" />
    }
   
    var highlightId = TempData["HighlightId"]?.ToString();

}
<div class="header-pro d-flex justify-content-between align-items-center mb-3">

    <div>
        <h2 class="mb-0 fw-bold">Gestión de Licencias</h2>
        <small class="text-muted">
            Mostrando @(Model?.Licenses?.Count ?? 0) licencias
        </small>
    </div>

    <button type="button"
            class="btn-save-pro"
            data-bs-toggle="modal"
            data-bs-target="#createEditModal">
        ➕ Crear licencia
    </button>

</div>

<div class="row mb-4">

    <div class="col-md-3">
        <div class="stat-card total">
            <div class="stat-title">Total</div>
            <div class="stat-value">@Model.TotalLicenses</div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="stat-card asignadas">
            <div class="stat-title">Asignadas</div>
            <div class="stat-value">@Model.AssignedLicenses</div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="stat-card libres">
            <div class="stat-title">Libres</div>
            <div class="stat-value">@Model.FreeLicenses</div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="stat-card uso">
            <div class="stat-title">Uso</div>
            <div class="stat-value">@Model.UsagePercentage %</div>
        </div>
    </div>

</div>



<!-- FILTROS -->
<form method="get" asp-action="Index" asp-controller="License">

    <div class="filters-shell mb-4">

        <!-- HEADER TOGGLE -->
        <div class="filters-head" onclick="toggleFilters()">

    <div>
        <div class="filters-title">Filtros de búsqueda</div>
        <div class="filters-sub">
    Filtra por código, proveedor, producto o estado
</div>

    </div>

    <div id="filterArrow" class="filters-arrow">▼</div>

</div>

        <!-- BODY -->
        <div id="filtersBody" class="filters-body" style="display:none;">


            <div class="row g-3">

                <!-- BUSQUEDA -->
                <div class="col-md-3">
                    <label class="form-label text-muted small">
                        Búsqueda
                    </label>

                    <input type="text"
                           name="Search"
                           value="@Model.Search"
                           class="form-control"
                           placeholder="Código o producto" />
                </div>

                <!-- PROVEEDOR -->
                <div class="col-md-2">
                    <label class="form-label text-muted small">
                        Proveedor
                    </label>

                    <input type="text"
                           name="SearchProveedor"
                           value="@Model.SearchProveedor"
                           class="form-control" />
                </div>

                <!-- PRODUCTO -->
                <div class="col-md-2">
                    <label class="form-label text-muted small">
                        Producto
                    </label>

                    <input type="text"
                           name="SearchProducto"
                           value="@Model.SearchProducto"
                           class="form-control" />
                </div>

                <!-- ASIGNADA -->
                <div class="col-md-2">
                    <label class="form-label text-muted small">
                        Asignada
                    </label>

                    <select name="SearchAsignada" class="form-select">
                        <option value="">Todas</option>
                        <option value="true" selected="@(Model.SearchAsignada == "true")">Sí</option>
                        <option value="false" selected="@(Model.SearchAsignada == "false")">No</option>
                    </select>
                </div>

                <!-- PAGE SIZE -->
                <div class="col-md-2">
                    <label class="form-label text-muted small">
                        Page Size
                    </label>

                    <select name="PageSize" class="form-select">
                        <option value="5" selected="@(Model.PageSize == 5)">5</option>
                        <option value="10" selected="@(Model.PageSize == 10)">10</option>
                        <option value="25" selected="@(Model.PageSize == 25)">25</option>
                        <option value="50" selected="@(Model.PageSize == 50)">50</option>
                    </select>
                </div>

            </div>

            <!-- BOTONES -->
            <div class="filters-actions">


                <div>

                    <button type="submit"
                            class="btn-filter-pro">
                        🔎 Filtrar
                    </button>

                
                </div>

                
            </div>

        </div>

    </div>

</form>

<!-- ========================= -->
<!-- CHIPS FILTROS ACTIVOS -->
<!-- ========================= -->
<div class="mb-3 d-flex flex-wrap gap-2">

    @if (!string.IsNullOrWhiteSpace(Model.Search))
    {
        <span class="chip">
            Búsqueda: @Model.Search
            <a class="x"
               href="@Url.Action("Index", new {
                   Search = (string)null,
                   SearchProveedor = Model.SearchProveedor,
                   SearchProducto = Model.SearchProducto,
                   SearchAsignada = Model.SearchAsignada
               })">✕</a>
        </span>
    }

    @if (!string.IsNullOrWhiteSpace(Model.SearchProveedor))
    {
        <span class="chip">
            Proveedor: @Model.SearchProveedor
            <a class="x"
               href="@Url.Action("Index", new {
                   Search = Model.Search,
                   SearchProveedor = (string)null,
                   SearchProducto = Model.SearchProducto,
                   SearchAsignada = Model.SearchAsignada
               })">✕</a>
        </span>
    }

    @if (!string.IsNullOrWhiteSpace(Model.SearchProducto))
    {
        <span class="chip">
            Producto: @Model.SearchProducto
            <a class="x"
               href="@Url.Action("Index", new {
                   Search = Model.Search,
                   SearchProveedor = Model.SearchProveedor,
                   SearchProducto = (string)null,
                   SearchAsignada = Model.SearchAsignada
               })">✕</a>
        </span>
    }

    @if (!string.IsNullOrWhiteSpace(Model.SearchAsignada))
    {
        <span class="chip">
            Asignada: @(Model.SearchAsignada == "true" ? "Sí" : "No")
            <a class="x"
               href="@Url.Action("Index", new {
                   Search = Model.Search,
                   SearchProveedor = Model.SearchProveedor,
                   SearchProducto = Model.SearchProducto,
                   SearchAsignada = (string)null
               })">✕</a>
        </span>
    }

    @{
        var hasFilters =
            !string.IsNullOrWhiteSpace(Model.Search) ||
            !string.IsNullOrWhiteSpace(Model.SearchProveedor) ||
            !string.IsNullOrWhiteSpace(Model.SearchProducto) ||
            !string.IsNullOrWhiteSpace(Model.SearchAsignada);
    }

    @if (hasFilters)
    {
        <a class="btn btn-sm btn-ortec btn-ortec-danger ms-2"
           href="@Url.Action("Index")">
            ✖ Limpiar todo
        </a>
    }

</div>

<!-- TABLA -->
<div class="table-shell mb-3">
  <div class="table-responsive">
    <table class="table-style align-middle text-center">

      <thead>
        <tr>
          <th>Código</th>
          <th>Producto</th>
          <th>Proveedor</th>
          <th>Precio</th>
          <th>Caducidad</th>
          <th>Asignada</th>
          <th>Disponible</th>
          <th>Usuario</th>
          <th>Acciones</th>
        </tr>
      </thead>

      <tbody>

        @foreach (var item in Model.Licenses)
        {
            <tr class="clickable-row licence-row"
                data-id="@item.Id">

              <td>@item.Code</td>
              <td>@item.Producto</td>
              <td>@item.Proveedor</td>
              <td>@item.Price</td>
              <td>@(item.Caducidad?.ToString("yyyy-MM-dd") ?? "-")</td>

              <!-- ESTADO -->
              <td>
                <span class="pill @(item.UserId != null ? "pill-active" : "pill-inactive")">
                  @(item.UserId != null ? "Asignada" : "Libre")
                </span>
              </td>

              <td>
                <span class="pill @(item.UserId == null ? "pill-active" : "pill-inactive")">
                  @(item.UserId != null ? "Ocupada" : "Disponible")
                </span>
              </td>

              <td>
                @(item.User != null ? $"{item.User.Name} {item.User.LastName}" : "-")
              </td>

              <td>
                <div class="actions-wrap">

                  <!-- HISTORICO -->
                  <button type="button"
                          class="btn-action btn-edit btn-history"
                          data-id="@item.Id"
                          data-code="@item.Code"
                          onclick="event.stopPropagation();">
                      🔍 Histórico
                  </button>

                  <!-- ASIGNAR / QUITAR -->
                  @if (!item.UserId.HasValue)
                  {
                      <button type="button"
                              class="btn-action btn-success"
                              onclick="event.stopPropagation(); openAssignModal(@item.Id);">
                          👤 Asignar
                      </button>
                  }
                  else
                  {
                      <button type="button"
                              class="btn-action btn-gray"
                              onclick="event.stopPropagation(); unassignLicenseAjax(@item.Id);">
                          ❌ Quitar
                      </button>
                  }

                  <!-- DELETE -->
                  <button type="button"
                          class="btn-action btn-delete"
                          data-bs-toggle="modal"
                          data-bs-target="#deleteModal"
                          data-id="@item.Id"
                          onclick="event.stopPropagation();">
                      🗑️ Eliminar
                  </button>

                </div>
              </td>

            </tr>
        }

      </tbody>

    </table>
  </div>
</div>


<!-- PAGINACIÓN -->
<nav aria-label="Page navigation" class="mt-3">
    <ul class="pagination justify-content-center">

        <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
            @if (Model.PageNumber > 1)
            {
                <a class="page-link"
                       asp-action="Index"
                       asp-controller="License"
                       asp-route-PageNumber="@(Model.PageNumber - 1)"
                       asp-route-PageSize="@Model.PageSize"
                       asp-route-Search="@Model.Search"
                       asp-route-SearchProveedor="@Model.SearchProveedor"
                       asp-route-SearchProducto="@Model.SearchProducto"
                       asp-route-SearchAsignada="@Model.SearchAsignada">
                    Anterior
                </a>
            }
            else
            {
                <span class="page-link">Anterior</span>
            }
        </li>

        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(Model.PageNumber == i ? "active" : "")">
                <a class="page-link"
                       asp-action="Index"
                       asp-controller="License"
                       asp-route-PageNumber="@i"
                       asp-route-PageSize="@Model.PageSize"
                       asp-route-Search="@Model.Search"
                       asp-route-SearchProveedor="@Model.SearchProveedor"
                       asp-route-SearchProducto="@Model.SearchProducto"
                       asp-route-SearchAsignada="@Model.SearchAsignada">
                    @i
                </a>
            </li>
        }

        <li class="page-item @(Model.PageNumber == Model.TotalPages || Model.TotalPages == 0 ? "disabled" : "")">
            @if (Model.TotalPages > 0 && Model.PageNumber < Model.TotalPages)
            {
                <a class="page-link"
                       asp-action="Index"
                       asp-controller="License"
                       asp-route-PageNumber="@(Model.PageNumber + 1)"
                       asp-route-PageSize="@Model.PageSize"
                       asp-route-Search="@Model.Search"
                       asp-route-SearchProveedor="@Model.SearchProveedor"
                       asp-route-SearchProducto="@Model.SearchProducto"
                       asp-route-SearchAsignada="@Model.SearchAsignada">
                    Siguiente
                </a>
            }
            else
            {
                <span class="page-link">Siguiente</span>
            }
        </li>

    </ul>
</nav>

<!-- MODAL: DETALLES (PRO) -->
<div class="modal fade modal-pro" id="detailsModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content modal-pro-card">

      <!-- HEADER PRO -->
      <div class="modal-header modal-pro-header">
        <div class="d-flex align-items-center gap-3">
          <div class="modal-pro-icon">🔎</div>
          <div>
            <h5 class="modal-title fw-bold mb-0">Detalles de la licencia</h5>
            <div class="small opacity-75" id="detailsSubtitle">Información completa</div>
          </div>
        </div>

        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>

      <!-- BODY -->
      <div class="modal-body" id="detailsBody">
        <div class="text-center text-muted py-3">Cargando...</div>
      </div>

      <!-- FOOTER PRO -->
      <div class="modal-footer modal-pro-footer">
        <button type="button"
                class="btn-save-pro"
                onclick="openEditLicenseFromDetails()">
          ✏️ Editar
        </button>

        <button type="button"
                class="btn-cancel-pro"
                data-bs-dismiss="modal">
          Cerrar
        </button>
      </div>

    </div>
  </div>
</div>


<!-- HISTORY MODAL (PRO - IGUAL QUE DEVICES) -->
<div class="modal fade modal-pro" id="historyModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content modal-pro-card">

      <div class="modal-header modal-pro-header">
        <div class="d-flex align-items-center gap-3">
          <div class="modal-pro-icon">📜</div>
          <div>
            <h5 class="modal-title fw-bold mb-0">Histórico</h5>
            <div class="small opacity-75" id="history-license-name">—</div>
          </div>
        </div>

        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body p-4">
        <div id="historyTimeline" class="history-timeline"></div>

        <div id="historyEmpty"
             class="text-center text-muted py-5"
             style="display:none;">
          Sin histórico disponible
        </div>
      </div>

      <div class="modal-footer modal-pro-footer">
        <button type="button" class="btn-cancel-pro" data-bs-dismiss="modal">
          Cerrar
        </button>
      </div>

    </div>
  </div>
</div>


<!-- MODAL: CREATE / EDIT (PRO) -->
<div class="modal fade modal-pro" id="createEditModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content modal-pro-card">

      <form id="createEditForm"
            method="post"
            asp-action="Create"
            asp-controller="License"
            onsubmit="showToast('Guardando licencia...', 'info')">

        <!-- HEADER -->
        <div class="modal-header modal-pro-header d-flex align-items-center justify-content-between">

          <div class="d-flex align-items-center gap-3">

            <div class="modal-pro-icon">🧾</div>

            <div>
              <h5 class="modal-title fw-bold mb-0" id="createEditTitle">
                Crear licencia
              </h5>
              <div class="small opacity-75" id="createEditSubtitle">
                Alta de licencia en el inventario
              </div>
            </div>

          </div>

          <button type="button"
                  class="btn-close btn-close-white"
                  data-bs-dismiss="modal"
                  aria-label="Cerrar">
          </button>

        </div>

        <!-- BODY PRO -->
        <div class="modal-body">

          <!-- PREVIEW PRO -->
          <div class="edit-preview">
            <div class="edit-preview-name" id="lic-preview-title">—</div>
            <div class="edit-preview-domain" id="lic-preview-sub">
              Completa los campos para guardar
            </div>
          </div>

          <input type="hidden" id="LicenseId" name="Id" value="0" />

          <div class="row g-3 form-pro">

            <div class="col-md-6">
              <label class="form-label">Código</label>
              <input class="form-control" id="Code" name="Code" placeholder="Ej: LIC-0001" />
            </div>

            <div class="col-md-6">
              <label class="form-label">Proveedor</label>
              <input class="form-control" id="Proveedor" name="Proveedor" placeholder="Ej: Microsoft" />
            </div>

            <div class="col-md-8">
              <label class="form-label">Producto</label>
              <input class="form-control" id="Producto" name="Producto" placeholder="Ej: Microsoft 365 E3" />
            </div>

            <div class="col-md-4">
              <label class="form-label">Precio</label>
              <input type="text" class="form-control" id="Price" name="Price" placeholder="Ej: 150.00" />
            </div>

            <div class="col-md-6">
              <label class="form-label">Caducidad</label>
              <input type="date" class="form-control" id="Caducidad" name="Caducidad" />
            </div>

            <div class="col-md-6">
              <label class="form-label">Usuario asignado (opcional)</label>

              <input class="form-control"
                     id="UserId"
                     name="UserId"
                     type="number"
                     min="1"
                     placeholder="Id usuario (opcional)" />

              <div class="text-muted small mt-1">
                Si indicas UserId, se asigna y se marca no disponible.
              </div>

            </div>

          </div>
        </div>

        <!-- FOOTER PRO -->
        <div class="modal-footer modal-pro-footer">

          <button type="button"
                  class="btn-cancel-pro"
                  data-bs-dismiss="modal">
            Cancelar
          </button>

          <button type="submit"
                  class="btn-save-pro"
                  id="createEditSubmit">
            💾 Guardar
          </button>

        </div>

      </form>

    </div>
  </div>
</div>


<!-- DELETE MODAL PRO (ESTILO LIMPIO) -->
<div class="modal fade modal-pro" id="deleteModal" tabindex="-1" aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-md">

        <div class="modal-content modal-pro-card border-0 overflow-hidden"
             style="border-radius:22px;">

            <form method="post"
                  asp-action="Delete"
                  asp-controller="License"
                  onsubmit="showToast('Eliminando licencia...', 'info')">

                <!-- HEADER -->
                <div class="modal-header border-0 px-4 py-4"
                     style="background:#003B82;">

                    <div class="d-flex align-items-center gap-3">

                        <!-- ICON -->
                        <div class="modal-pro-icon d-flex align-items-center justify-content-center"
                             style="
                                width:52px;
                                height:52px;
                                border-radius:50%;
                                background:#dc3545;
                                color:white;
                                font-size:1.3rem;
                             ">
                            🗑️
                        </div>

                        <!-- TITLE -->
                        <div class="text-white">

                            <h5 class="modal-title fw-bold mb-0">
                                Eliminar licencia
                            </h5>

                            <div class="modal-subtitle">
                            Esta acción no se puede deshacer
                            </div>
                        </div>

                    </div>

                    <!-- CLOSE -->
                    <button type="button"
                            class="btn-close btn-close-white"
                            data-bs-dismiss="modal"
                            aria-label="Cerrar">
                    </button>

                </div>

                <!-- BODY -->
                <div class="modal-body p-4"
                     style="background:#F4F5F7;">

                    <!-- HIDDEN ID -->
                    <input type="hidden"
                           name="id"
                           id="deleteId" />

                    <!-- ALERT -->
                    <div class="mb-4 p-4"
                         style="
                            background:#F7EFCF;
                            border:1px solid #E6D38A;
                            border-radius:18px;
                         ">

                        <div class="fw-semibold mb-1"
                             style="font-size:1.1rem; color:#111827;">

                            ¿Seguro que deseas eliminar esta licencia?

                        </div>

                        <div class="small"
                             style="color:#4B5563;">

                            Se eliminará el registro permanentemente.

                        </div>

                    </div>

                    <!-- LICENSE INFO -->
                    <div id="deleteLicenseInfo"
                         class="p-4"
                         style="
                            background:white;
                            border:1px solid #D7DCE3;
                            border-radius:18px;
                         ">

                        <div class="small text-muted mb-2">
                            Licencia seleccionada
                        </div>

                        <div id="deleteLicenseName"
                             class="fw-bold"
                             style="font-size:1.1rem;">
                            —
                        </div>

                        <div id="deleteLicenseSub"
                             class="small text-muted">
                            —
                        </div>

                    </div>

                </div>

                <!-- FOOTER -->
                <div class="modal-footer border-0 px-4 pb-4 bg-white d-flex justify-content-end gap-3">

                    <!-- CANCEL -->
                    <button type="button"
                            data-bs-dismiss="modal"
                            style="
                                border-radius:999px;
                                padding:.75rem 1.8rem;
                                border:1px solid #BFC6CF;
                                background:white;
                                color:#6B7280;
                                font-weight:600;
                            ">
                        Cancelar
                    </button>

                    <!-- DELETE -->
                    <button type="submit"
                            style="
                                border:none;
                                border-radius:999px;
                                padding:.75rem 2rem;
                                background:#dc3545;
                                color:white;
                                font-weight:700;
                                box-shadow:0 4px 10px rgba(220,53,69,.25);
                            ">
                        Eliminar
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>
<!-- ✅ MODAL: ASIGNAR (BUSCADOR) -->
<div class="modal fade modal-pro" id="assignModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content modal-pro-card">

      <form id="assignForm" onsubmit="event.preventDefault(); assignLicenseAjax();">

        @Html.AntiForgeryToken()
        @{
            RenderQpHidden();
        }

        <!-- HEADER -->
        <div class="modal-header modal-pro-header d-flex align-items-center justify-content-between">

          <div class="d-flex align-items-center gap-3">
            <div class="modal-pro-icon navy">👤</div>

            <div>
              <h5 class="modal-title fw-bold mb-0">
                Asignar licencia
              </h5>
              <div class="small opacity-75">
                Selecciona un usuario para asignar la licencia
              </div>
            </div>
          </div>

          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>

        <!-- BODY -->
        <div class="modal-body modal-pro-body">

          <input type="hidden" id="assignLicenseId" name="id" />
          <input type="hidden" id="assignUserId" name="userId" />

          <!-- BUSCADOR -->
          <div class="mb-3">
            <label class="tiny-label">Buscar usuario🔎</label>

            <div class="search-pro">
              <input type="text"
                     class="form-control input-pro"
                     id="assignUserSearch"
                     placeholder="Escribe nombre..." />
              <span class="search-icon"></span>
            </div>
          </div>

          <!-- RESULTADOS -->
          <div id="assignUserResults" class="assign-results"></div>

          <div class="text-muted small mt-2">
            Selecciona un usuario para habilitar la asignación
          </div>

        </div>

        <!-- FOOTER -->
        <div class="modal-footer modal-pro-footer d-flex justify-content-between">

          <button type="button"
                  class="btn-pill btn-cancel-pro"
                  data-bs-dismiss="modal">
            Cancelar
          </button>

          <button type="submit"
                  id="assignSubmit"
                  class="btn-pill btn-save-pro"
                  disabled>
            Asignar licencia
          </button>

        </div>

      </form>

    </div>
  </div>
</div>

<div class="position-fixed top-0 end-0 p-3" style="z-index: 9999">

    <div id="appToast" class="toast align-items-center text-white border-0" role="alert">

        <div class="d-flex">

            <div id="toastMessage" class="toast-body">
                Mensaje
            </div>

            <button type="button"
                    class="btn-close btn-close-white me-2 m-auto"
                    data-bs-dismiss="toast">
            </button>

        </div>

    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            window.usersList = @Html.Raw(JsonSerializer.Serialize(
                                                    (Model.Users ?? new List<ERP_BIEN.Models.User>())
                                                                    .Select(u => new { id = u.Id, name = ((u.Name ?? "") + " " + (u.LastName ?? "")).Trim() })
                                                                    .OrderBy(x => x.name)
                                                                    .ToList()
                                    ));

            // CLICK FILA -> detalles
            document.querySelectorAll(".clickable-row").forEach(row => {
                row.addEventListener("click", function (e) {
                    if (e.target.closest("button") || e.target.closest("form") || e.target.closest("input")) return;
                    loadDetails(row.dataset.id);
                });
            });

            // Eliminar
            document.querySelectorAll(".btn-delete").forEach(btn => {
    btn.addEventListener("click", function (e) {

        e.stopPropagation();

        const id = this.dataset.id;

        // ✅ coger fila completa
        const row = this.closest("tr");
        if (!row) return;

        // ✅ columnas reales de TU tabla
        const code = row.children[0].textContent.trim();
        const producto = row.children[1].textContent.trim();
        const proveedor = row.children[2].textContent.trim();

        // ✅ guardar id
        document.getElementById("deleteId").value = id;

        // ✅ meter datos en el modal
        document.getElementById("deleteLicenseName").textContent = producto;

        document.getElementById("deleteLicenseSub").textContent =
            `Código: ${code} · Proveedor: ${proveedor}`;
    });
});
            // ✅ HISTÓRICO CLICK
document.querySelectorAll(".btn-history").forEach(btn => {
    btn.addEventListener("click", function (e) {

        e.stopPropagation();

        const id = this.dataset.id;
        const code = this.dataset.code;

        loadHistoryLicense(id, code);
    });
});
    

// ✅ DETAILS NIVEL EMPRESA
function loadDetails(id) {
    window.currentLicenseId = id;

    const body = document.getElementById("detailsBody");
    body.innerHTML = '<div class="text-center text-muted">Cargando...</div>';

    fetch(`/License/DetailsJson?id=${id}`)
        .then(r => r.json())
        .then(d => {

            body.innerHTML = `
  <div class="detail-hero">
    <div class="d-flex justify-content-between align-items-start gap-3">
      <div>
        <div class="detail-name">${escapeHtml(d.producto ?? "Licencia")}</div>
        <div class="detail-domain">${escapeHtml(d.code ?? "-")}</div>
      </div>

      <div class="text-end">
        <div class="pill ${d.userId ? "pill-active" : "pill-inactive"}">
          ${d.userId ? "Asignada" : "Libre"}
        </div>
        <div class="mt-2 pill ${d.userId ? "pill-inactive" : "pill-active"}">
          ${d.userId ? "Ocupada" : "Disponible"}
        </div>
      </div>
    </div>
  </div>

  <div class="info-grid">

    <div class="info-card">
      <div class="info-label">Proveedor</div>
      <div class="info-value">${escapeHtml(d.proveedor ?? "-")}</div>
    </div>

    <div class="info-card">
      <div class="info-label">Producto</div>
      <div class="info-value">${escapeHtml(d.producto ?? "-")}</div>
    </div>

    <div class="info-card">
      <div class="info-label">Precio</div>
      <div class="info-value">${escapeHtml(d.price ?? "-")}</div>
    </div>

    <div class="info-card">
      <div class="info-label">Caducidad</div>
      <div class="info-value">${escapeHtml(d.caducidad ?? "-")}</div>
    </div>

    <div class="info-card" style="grid-column: 1 / -1;">
      <div class="info-label">Usuario asignado</div>
      <div class="info-value">${escapeHtml(d.userName ?? "-")}</div>
    </div>

  </div>
`;


            new bootstrap.Modal(document.getElementById("detailsModal")).show();
        });
}

        });

        // ✅ 👉 ESTA ES LA FUNCIÓN QUE TE FALTABA
        function openEditLicenseFromDetails() {

    const id = window.currentLicenseId;
    if (!id) return;

    fetch('/License/DetailsJson?id=' + id)
        .then(r => r.json())
        .then(d => {

            // =========================
            // 1) RELLENAR INPUTS (lo que ya tienes)
            // =========================
            document.getElementById("LicenseId").value = d.id;
            document.getElementById("Code").value = d.code ?? "";
            document.getElementById("Producto").value = d.producto ?? "";
            document.getElementById("Proveedor").value = d.proveedor ?? "";
            document.getElementById("Price").value = d.price ?? "";
            document.getElementById("Caducidad").value = d.caducidad ?? "";
            document.getElementById("UserId").value = d.userId ?? "";

            // =========================
            // 2) ✅ AQUÍ PEGAS EL BLOQUE PRO (DESPUÉS DE RELLENAR)
            // =========================

            // modo editar
            document.getElementById("createEditForm").action = "/License/Edit";
            document.getElementById("createEditTitle").innerText = "Editar licencia";
            document.getElementById("createEditSubtitle").innerText = "Actualiza la información de la licencia";

            // preview pro
            const title = (d.producto ?? "Licencia").toString();
            const sub = `Código: ${(d.code ?? "-")} · Proveedor: ${(d.proveedor ?? "-")}`;
            document.getElementById("lic-preview-title").textContent = title;
            document.getElementById("lic-preview-sub").textContent = sub;

            // botón texto pro
            document.getElementById("createEditSubmit").textContent = "💾 Guardar cambios";

            // =========================
            // 3) CERRAR DETAILS Y ABRIR MODAL EDIT (lo que ya tenías)
            // =========================
            bootstrap.Modal.getInstance(document.getElementById("detailsModal"))?.hide();
            new bootstrap.Modal(document.getElementById("createEditModal")).show();
        });
}

        function escapeHtml(str) {
  return (str ?? "").toString()
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#039;");
}


        // limpiar filtros
        window.erpClearFiltersAndSubmit = function (form) {
            if (!form) return;
            form.querySelectorAll("input[type='text']").forEach(i => i.value = "");
            form.querySelectorAll("select").forEach(s => s.selectedIndex = 0);
            form.submit();
        };
                function toggleFilters() {

            const body = document.getElementById("filtersBody");
            const arrow = document.getElementById("filterArrow");

            if (body.style.display === "none") {
                body.style.display = "block";
                arrow.innerText = "▲";
            } else {
                body.style.display = "none";
                arrow.innerText = "▼";
            }
        }

     
// ==============================
// ✅ TOAST FUNCION GLOBAL
// ==============================
function showToast(message, type = "success") {

    const toastEl = document.getElementById('appToast');
    const toastMessage = document.getElementById('toastMessage');

    if (!toastEl || !toastMessage) return;

    toastMessage.innerText = message;

    toastEl.className = "toast align-items-center text-white border-0";

    if (type === "success") toastEl.classList.add("bg-success");
    if (type === "error") toastEl.classList.add("bg-danger");
    if (type === "info") toastEl.classList.add("bg-primary");

    new bootstrap.Toast(toastEl).show();
}


// ==============================
// ✅ TOAST DESPUÉS DE RECARGA
// ==============================
window.addEventListener("load", function () {

    const msg = '@TempData["ToastMsg"]';
    const type = '@TempData["ToastType"]';

    if (msg && msg !== "") {
        showToast(msg, type || "success");
    }

});
async function unassignLicenseAjax(id) {

    showToast("Quitando asignación...", "info");

    try {
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        const fd = new FormData();
        fd.append("id", id);

        if (token) fd.append("__RequestVerificationToken", token);

        const res = await fetch("/License/Unassign", {
            method: "POST",
            body: fd,
            credentials: "same-origin"
        });

        if (!res.ok) {
            showToast("Error al desasignar ❌", "error");
            return;
        }

        // ✅ ACTUALIZAR UI
        const row = document.querySelector(`tr[data-id="${id}"]`);
        if (!row) return;

        // Usuario → "-"
        row.children[7].textContent = "-";

        // Cambiar pills
        const assigned = row.children[5].querySelector("span");
        const available = row.children[6].querySelector("span");

        assigned.textContent = "Libre";
        assigned.className = "pill pill-inactive";

        available.textContent = "Disponible";
        available.className = "pill pill-active";

        // Cambiar botón
        const actions = row.querySelector(".actions-wrap");
        const code = row.children[0].textContent.trim();

actions.innerHTML = `
    <button type="button"
        class="btn-action"
        style="background: var(--c-success);"
        onclick="event.stopPropagation(); openAssignModal(${id});">
        👤 Asignar
    </button>

    <button type="button"
        class="btn-action btn-edit btn-history"
        data-id="${id}"
        data-code="${code}">
        🔍 Histórico
    </button>

    <button type="button"
        class="btn-action btn-delete"
        data-id="${id}"
        data-bs-toggle="modal"
        data-bs-target="#deleteModal"
        onclick="event.stopPropagation();">
        🗑️ Eliminar
    </button>
`;
     

        showToast("Licencia desasignada ✅", "success");

    } catch (e) {
        console.error(e);
        showToast("Error inesperado ❌", "error");
    }
}

const assignModalInstance = new bootstrap.Modal(document.getElementById("assignModal"));

function openAssignModal(id) {

    const assignLicenseId = document.getElementById("assignLicenseId");
    const assignUserId = document.getElementById("assignUserId");
    const assignSearch = document.getElementById("assignUserSearch");
    const assignResults = document.getElementById("assignUserResults");
    const assignSubmit = document.getElementById("assignSubmit");

    assignLicenseId.value = id;

    assignUserId.value = "";
    assignSubmit.disabled = true;
    assignSearch.value = "";
    assignResults.innerHTML = "";

    renderUserResults(window.usersList.slice(0, 15));

    assignModalInstance.show();
}

function renderUserResults(list) {

    const assignResults = document.getElementById("assignUserResults");
    const assignUserId = document.getElementById("assignUserId");
    const assignSubmit = document.getElementById("assignSubmit");

    assignResults.innerHTML = "";

    if (!list || list.length === 0) {
        assignResults.innerHTML = `
            <div class="text-muted small p-2">
                No hay usuarios
            </div>
        `;
        return;
    }

    list.forEach(u => {

        const b = document.createElement("button");
        b.type = "button";
        b.className = "assign-user-card";
        b.textContent = u.name;

        b.onclick = () => {

            assignUserId.value = u.id;

            // ✅ ACTIVAR BOTÓN (CLAVE)
            assignSubmit.disabled = false;

            assignResults.querySelectorAll(".active")
                .forEach(x => x.classList.remove("active"));

            b.classList.add("active");
        };

        assignResults.appendChild(b);
    });
}
async function assignLicenseAjax() {

    const id = document.getElementById("assignLicenseId").value;
    const userId = document.getElementById("assignUserId").value;

    const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

    const fd = new FormData();
    fd.append("id", id);
    fd.append("userId", userId);
    fd.append("__RequestVerificationToken", token);

    try {

        const res = await fetch("/License/Assign", {
            method: "POST",
            body: fd
        });

        if (!res.ok) {
            showToast("Error al asignar ❌", "error");
            return;
        }

        showToast("Asignado correctamente ✅", "success");

        // cerrar modal
        bootstrap.Modal.getInstance(document.getElementById("assignModal")).hide();

        // recargar página
        location.reload();

    } catch (e) {
        console.error(e);
        showToast("Error inesperado ❌", "error");
    }
}
// =========================
// HISTÓRICO PRO (IGUAL QUE DEVICES)
// =========================
window.loadHistoryLicense = async function (licenseId, code) {

    const nameEl = document.getElementById("history-license-name");
    const timeline = document.getElementById("historyTimeline");
    const empty = document.getElementById("historyEmpty");

    if (nameEl) nameEl.innerText = code;

    timeline.innerHTML = "";
    empty.style.display = "none";
    empty.innerText = "Sin histórico disponible";

    try {

        const res = await fetch(`/License/HistoryJson?licenseId=${licenseId}`);

        if (!res.ok) {
            throw new Error("Error HTTP");
        }

        const rows = await res.json();

        if (!rows || rows.length === 0) {
            empty.style.display = "block";
            new bootstrap.Modal(document.getElementById("historyModal")).show();
            return;
        }

        rows.forEach(r => {

            const item = document.createElement("div");
            item.className = "history-item";

            const isActive = !r.endDate;

item.innerHTML = `
    <div class="history-item-inner ${isActive ? "active" : ""}">
        
        <div class="history-dot"></div>

        <div class="history-card">

            <div class="d-flex justify-content-between align-items-center mb-1">
                <div class="history-user fw-bold">
                    👤 ${r.userName ?? "-"}
                </div>

                ${isActive 
                    ? `<span class="badge bg-success">Actual</span>` 
                    : ""
                }
            </div>

            <div class="history-dates text-muted small">
                ${r.startDate ?? "-"} → ${r.endDate ?? "Actual"}
            </div>

        </div>
    </div>
`;
            timeline.appendChild(item);
        });

        new bootstrap.Modal(document.getElementById("historyModal")).show();

    } catch (e) {
        console.error(e);

        empty.style.display = "block";
        empty.innerText = "Error cargando histórico ❌";

        new bootstrap.Modal(document.getElementById("historyModal")).show();
    }
}
document.getElementById("assignUserSearch")?.addEventListener("input", function () {

    const texto = this.value.toLowerCase().trim();

    // ✅ si no escribe nada → mostrar primeros usuarios
    if (!texto) {
        renderUserResults(window.usersList.slice(0, 15));
        return;
    }

    // ✅ filtrar usuarios
    const filtrados = window.usersList.filter(u =>
        u.name.toLowerCase().includes(texto)
    );

    // ✅ pintar resultados
    renderUserResults(filtrados.slice(0, 20));
});





    </script>
}