@using System.Text.Json
@model ERP_BIEN.ViewModels.LicenseIndexMvcViewModel

@{
    ViewData["Title"] = "Licenses";

    void RenderQpHidden()
    {
        <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
        <input type="hidden" name="PageSize" value="@Model.PageSize" />
        <input type="hidden" name="Search" value="@Model.Search" />
        <input type="hidden" name="SearchProveedor" value="@Model.SearchProveedor" />
        <input type="hidden" name="SearchProducto" value="@Model.SearchProducto" />
        <input type="hidden" name="SearchAsignada" value="@Model.SearchAsignada" />
    }
}

<h2 class="mb-3">Licenses</h2>
<div class="row mb-3">

    <div class="col-md-3">
        <div class="card p-2 text-center">
            <h6>Total</h6>
            <h4>@Model.TotalLicenses</h4>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-2 text-center">
            <h6>Asignadas</h6>
            <h4 class="text-success">@Model.AssignedLicenses</h4>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-2 text-center">
            <h6>Libres</h6>
            <h4 class="text-secondary">@Model.FreeLicenses</h4>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card p-2 text-center">
            <h6>Uso</h6>
            <h4>@Model.UsagePercentage %</h4>
        </div>
    </div>

</div>

<!-- FILTROS -->
<form method="get" asp-action="Index" asp-controller="License">

    <div class="card shadow-sm border-0 mb-4">

        <!-- HEADER TOGGLE -->
        <div class="d-flex justify-content-between align-items-center p-3 border-bottom"
             style="cursor:pointer;"
             onclick="toggleFilters()">

            <h6 class="fw-bold text-muted mb-0">
                Filtros de búsqueda
            </h6>

            <span id="filterArrow">▼</span>
        </div>

        <!-- BODY -->
        <div id="filtersBody" class="p-4" style="display:none;">

            <div class="row g-3">

                <!-- BUSQUEDA -->
                <div class="col-md-3">
                    <label class="form-label text-muted small">
                        Búsqueda
                    </label>

                    <input type="text"
                           name="Search"
                           value="@Model.Search"
                           class="form-control"
                           placeholder="Código o producto" />
                </div>

                <!-- PROVEEDOR -->
                <div class="col-md-2">
                    <label class="form-label text-muted small">
                        Proveedor
                    </label>

                    <input type="text"
                           name="SearchProveedor"
                           value="@Model.SearchProveedor"
                           class="form-control" />
                </div>

                <!-- PRODUCTO -->
                <div class="col-md-2">
                    <label class="form-label text-muted small">
                        Producto
                    </label>

                    <input type="text"
                           name="SearchProducto"
                           value="@Model.SearchProducto"
                           class="form-control" />
                </div>

                <!-- ASIGNADA -->
                <div class="col-md-2">
                    <label class="form-label text-muted small">
                        Asignada
                    </label>

                    <select name="SearchAsignada" class="form-select">
                        <option value="">Todas</option>
                        <option value="true" selected="@(Model.SearchAsignada == "true")">Sí</option>
                        <option value="false" selected="@(Model.SearchAsignada == "false")">No</option>
                    </select>
                </div>

                <!-- PAGE SIZE -->
                <div class="col-md-2">
                    <label class="form-label text-muted small">
                        Page Size
                    </label>

                    <select name="PageSize" class="form-select">
                        <option value="5" selected="@(Model.PageSize == 5)">5</option>
                        <option value="10" selected="@(Model.PageSize == 10)">10</option>
                        <option value="25" selected="@(Model.PageSize == 25)">25</option>
                        <option value="50" selected="@(Model.PageSize == 50)">50</option>
                    </select>
                </div>

            </div>

            <!-- BOTONES -->
            <div class="d-flex justify-content-between align-items-center mt-4">

                <div>

                    <button type="submit"
                            class="btn btn-primary px-4">
                        Filtrar
                    </button>

                
                </div>

                
            </div>

        </div>

    </div>

</form>

<!-- ========================= -->
<!-- CHIPS FILTROS ACTIVOS -->
<!-- ========================= -->
<div class="mb-3 d-flex flex-wrap gap-2">

    @if (!string.IsNullOrWhiteSpace(Model.Search))
    {
        <span class="chip">
            Búsqueda: @Model.Search
            <a class="x"
               href="@Url.Action("Index", new {
                   Search = (string)null,
                   SearchProveedor = Model.SearchProveedor,
                   SearchProducto = Model.SearchProducto,
                   SearchAsignada = Model.SearchAsignada
               })">✕</a>
        </span>
    }

    @if (!string.IsNullOrWhiteSpace(Model.SearchProveedor))
    {
        <span class="chip">
            Proveedor: @Model.SearchProveedor
            <a class="x"
               href="@Url.Action("Index", new {
                   Search = Model.Search,
                   SearchProveedor = (string)null,
                   SearchProducto = Model.SearchProducto,
                   SearchAsignada = Model.SearchAsignada
               })">✕</a>
        </span>
    }

    @if (!string.IsNullOrWhiteSpace(Model.SearchProducto))
    {
        <span class="chip">
            Producto: @Model.SearchProducto
            <a class="x"
               href="@Url.Action("Index", new {
                   Search = Model.Search,
                   SearchProveedor = Model.SearchProveedor,
                   SearchProducto = (string)null,
                   SearchAsignada = Model.SearchAsignada
               })">✕</a>
        </span>
    }

    @if (!string.IsNullOrWhiteSpace(Model.SearchAsignada))
    {
        <span class="chip">
            Asignada: @(Model.SearchAsignada == "true" ? "Sí" : "No")
            <a class="x"
               href="@Url.Action("Index", new {
                   Search = Model.Search,
                   SearchProveedor = Model.SearchProveedor,
                   SearchProducto = Model.SearchProducto,
                   SearchAsignada = (string)null
               })">✕</a>
        </span>
    }

    @{
        var hasFilters =
            !string.IsNullOrWhiteSpace(Model.Search) ||
            !string.IsNullOrWhiteSpace(Model.SearchProveedor) ||
            !string.IsNullOrWhiteSpace(Model.SearchProducto) ||
            !string.IsNullOrWhiteSpace(Model.SearchAsignada);
    }

    @if (hasFilters)
    {
        <a class="btn btn-sm btn-outline-danger ms-2"
           href="@Url.Action("Index")">
            ✖ Limpiar todo
        </a>
    }

</div>


<!-- BOTÓN CREAR -->
<div class="d-flex justify-content-end mb-2">
    <button type="button"
            class="btn btn-success"
            data-bs-toggle="modal"
            data-bs-target="#createEditModal">
        + Crear licencia
    </button>
</div>
<style>

/* ===== TABLA EXACTA DEVICES ===== */

.table.table-ortec {
    border-radius: 6px;
    overflow: hidden;
}

.table.table-ortec thead {
    background-color: #0d2f6f !important;
}

.table.table-ortec thead th {
    color: white !important;
    text-align: center !important;
}

.table.table-ortec tbody tr:nth-child(odd) {
    background-color: #a9c4d2 !important;
}

.table.table-ortec tbody tr:nth-child(even) {
    background-color: #d2d2d2 !important;
}

/* ===== BOTONES ===== */

button.btn-edit {
    background-color: #0d2f6f !important;
    color: white !important;
    border: none !important;
}

button.btn-delete {
    background-color: #d60000 !important;
    color: white !important;
    border: none !important;
}

/* 🔥 MUY IMPORTANTE: quitar estilo raro de tus CSS antiguos */
.btn-delete,
.btn-edit {
    text-decoration: none !important;
}
.table-ortec thead {
    display: table-header-group !important;
    visibility: visible !important;
}
thead.thead-ortec {
    display: table-header-group !important;
    position: relative !important;
    z-index: 2;
    background-color: #0d2f6f !important;
}

thead.thead-ortec th {
    color: white !important;
    text-align: center;
    background-color: #0d2f6f !important;
}
.timeline {
    position: relative;
    border-left: 2px solid #ddd;
    margin-left: 20px;
    padding-left: 20px;
}

.timeline-item {
    position: relative;
    margin-bottom: 20px;
}

.timeline-dot {
    position: absolute;
    left: -9px;
    top: 5px;
    width: 12px;
    height: 12px;
    background-color: #0d2f6f; /* azul empresa */
    border-radius: 50%;
}

.timeline-content {
    padding: 8px 10px;
    background: #f8f9fa;
    border-radius: 6px;
    font-size: 13px;
}
.timeline-item {
    margin-bottom: 12px;
}



</style>

<!-- TABLA -->
<div class="table-responsive" style="overflow: visible;">
    <table class="table table-ortec table-hover align-middle text-center">
        
<thead class="thead-ortec">
    <tr>
        <th>Código</th>
        <th>Producto</th>
        <th>Proveedor</th>
        <th>Precio</th>
        <th>Caducidad</th>
        <th>Asignada</th>
        <th>Disponible</th>
        <th>Usuario</th>
        <th>Acciones</th>
    </tr>
</thead>


        <tbody>
            @if (Model.Licenses == null || !Model.Licenses.Any())
            {
                <tr>
                    <td colspan="9" class="text-center text-muted">No hay registros</td>
                </tr>
            }
            else
            {
                foreach (var item in Model.Licenses)
                {
                    <tr class="clickable-row" data-id="@item.Id" style="cursor:pointer">
                        <td>@item.Code</td>
                        <td>@item.Producto</td>
                        <td>@item.Proveedor</td>
                        <td>@item.Price</td>
                        <td>@(item.Caducidad?.ToString("yyyy-MM-dd") ?? "-")</td>

                        <td>
                            @if (item.UserId != null)
                            {
                                <span class="badge bg-success">Asignada</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Libre</span>
                            }
                        </td>

                        <td>
                            @if (item.UserId == null)
                            {
                                <span class="badge bg-success">Disponible</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Ocupada</span>
                            }
                        </td>

                        <td>@(item.User != null ? $"{item.User.Name} {item.User.LastName}" : "-")</td>

                        <td>
                            <div class="device-actions">

                           

                            <!-- HISTÓRICO -->
                            <button type="button"
                                    class="btn btn-sm btn-edit btn-history"
                                    data-id="@item.Id"
                                    data-code="@item.Code">
                                Histórico
                            </button>

                            <!-- ASIGNAR / QUITAR -->
                            @if (item.UserId == null)
                            {
                                <button type="button"
                                        class="btn btn-sm btn-success me-1 btn-open-assign"
                                        data-id="@item.Id">
                                    Asignar
                                </button>
                            }
                            else
                            {
                                <form class="d-inline" method="post" asp-action="Unassign" asp-controller="License" onsubmit="showToast('Quitando asignación...', 'info')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    @{
                                        RenderQpHidden();
                                    }
                                    <button type="submit" class="btn btn-sm btn-secondary me-1">
                                        Quitar
                                    </button>
                                </form>
                            }

                            <!-- ELIMINAR -->
                            <button type="button"
                                        class="btn btn-sm btn-delete"
                                    data-id="@item.Id"
                                    data-bs-toggle="modal"
                                    data-bs-target="#deleteModal">
                                Eliminar
                            </button>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<!-- PAGINACIÓN -->
<nav aria-label="Page navigation" class="mt-3">
    <ul class="pagination justify-content-center">

        <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
            @if (Model.PageNumber > 1)
            {
                <a class="page-link"
                       asp-action="Index"
                       asp-controller="License"
                       asp-route-PageNumber="@(Model.PageNumber - 1)"
                       asp-route-PageSize="@Model.PageSize"
                       asp-route-Search="@Model.Search"
                       asp-route-SearchProveedor="@Model.SearchProveedor"
                       asp-route-SearchProducto="@Model.SearchProducto"
                       asp-route-SearchAsignada="@Model.SearchAsignada">
                    Anterior
                </a>
            }
            else
            {
                <span class="page-link">Anterior</span>
            }
        </li>

        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(Model.PageNumber == i ? "active" : "")">
                <a class="page-link"
                       asp-action="Index"
                       asp-controller="License"
                       asp-route-PageNumber="@i"
                       asp-route-PageSize="@Model.PageSize"
                       asp-route-Search="@Model.Search"
                       asp-route-SearchProveedor="@Model.SearchProveedor"
                       asp-route-SearchProducto="@Model.SearchProducto"
                       asp-route-SearchAsignada="@Model.SearchAsignada">
                    @i
                </a>
            </li>
        }

        <li class="page-item @(Model.PageNumber == Model.TotalPages || Model.TotalPages == 0 ? "disabled" : "")">
            @if (Model.TotalPages > 0 && Model.PageNumber < Model.TotalPages)
            {
                <a class="page-link"
                       asp-action="Index"
                       asp-controller="License"
                       asp-route-PageNumber="@(Model.PageNumber + 1)"
                       asp-route-PageSize="@Model.PageSize"
                       asp-route-Search="@Model.Search"
                       asp-route-SearchProveedor="@Model.SearchProveedor"
                       asp-route-SearchProducto="@Model.SearchProducto"
                       asp-route-SearchAsignada="@Model.SearchAsignada">
                    Siguiente
                </a>
            }
            else
            {
                <span class="page-link">Siguiente</span>
            }
        </li>

    </ul>
</nav>

<!-- MODAL: DETALLES -->
<div class="modal fade" id="detailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Detalles de la licencia</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body" id="detailsBody">
                <div class="text-center text-muted">Cargando...</div>
            </div>

            <<div class="modal-footer">

                <button type="button"
                        class="btn btn-warning"
                        onclick="openEditLicenseFromDetails()">
                    Editar
                </button>

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cerrar
                </button>

            </div>

        </div>
    </div>
</div>

<!-- MODAL: HISTÓRICO -->
<div class="modal fade" id="historyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="historyTitle">Histórico</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div id="historyBody">
                    <div class="text-center text-muted">Cargando...</div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>

        </div>
    </div>
</div>

<!-- MODAL: CREATE / EDIT -->
<div class="modal fade" id="createEditModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <form id="createEditForm" method="post" asp-action="Create" asp-controller="License" onsubmit="showToast('Guardando licencia...', 'info')">
                @Html.AntiForgeryToken()
                @{
                    RenderQpHidden();
                }

                <div class="modal-header">
                    <h5 class="modal-title" id="createEditTitle">Crear licencia</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" id="LicenseId" name="Id" value="0" />

                    <div class="mb-2">
                        <label class="form-label">Código</label>
                        <input class="form-control" id="Code" name="Code" />
                    </div>

                    <div class="mb-2">
                        <label class="form-label">Producto</label>
                        <input class="form-control" id="Producto" name="Producto" />
                    </div>

                    <div class="mb-2">
                        <label class="form-label">Proveedor</label>
                        <input class="form-control" id="Proveedor" name="Proveedor" />
                    </div>

                    <div class="mb-2">
                        <label class="form-label">Precio</label>
                        <input type="number" step="0.01" class="form-control" id="Price" name="Price" />
                    </div>

                    <div class="mb-2">
                        <label class="form-label">Caducidad</label>
                        <input type="date" class="form-control" id="Caducidad" name="Caducidad" />
                    </div>

                    <div class="mb-2">
                        <label class="form-label">Usuario asignado (Id) (opcional)</label>
                        <input class="form-control" id="UserId" name="UserId" type="number" min="1" />
                        <small class="text-muted">Si pones UserId, se asigna y se marca no disponible automáticamente.</small>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary" id="createEditSubmit">Guardar</button>
                </div>
            </form>

        </div>
    </div>
</div>

<!-- MODAL: ELIMINAR -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Eliminar licencia</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                ¿Seguro que deseas eliminar esta licencia?
            </div>

            <div class="modal-footer">
                <form id="deleteForm" method="post" asp-action="Delete" asp-controller="License" onsubmit="showToast('Eliminando licencia...', 'info')">

                    @Html.AntiForgeryToken()
                    @{
                        RenderQpHidden();
                    }

                    <input type="hidden" name="id" id="deleteId" />
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger">Eliminar</button>
                </form>
            </div>

        </div>
    </div>
</div>

<!-- ✅ MODAL: ASIGNAR (BUSCADOR) -->
<div class="modal fade" id="assignModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <form id="assignForm" method="post" asp-action="Assign" asp-controller="License" onsubmit="showToast('Asignando licencia...', 'info')">
                @Html.AntiForgeryToken()
                @{
                    RenderQpHidden();
                }

                <div class="modal-header">
                    <h5 class="modal-title">Asignar licencia</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" name="id" id="assignLicenseId" />
                    <input type="hidden" name="userId" id="assignUserId" />

                    <label class="form-label">Buscar usuario</label>
                    <input type="text" class="form-control" id="assignUserSearch"
                           placeholder="Escribe nombre o apellido..." autocomplete="off" />

                    <div class="list-group mt-2" id="assignUserResults" style="max-height:260px; overflow:auto;">
                    </div>
                    <div id="assignEmptyState" class="text-muted small mt-2 d-none">
                        No hay usuarios que coincidan.
                    </div>

                    <div class="text-muted small mt-2">
                        Selecciona un usuario de la lista para habilitar “Asignar”.
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary" id="assignSubmit" disabled>Asignar</button>
                </div>
            </form>

        </div>
    </div>
</div>

<div class="position-fixed top-0 end-0 p-3" style="z-index: 9999">

    <div id="appToast" class="toast align-items-center text-white border-0" role="alert">

        <div class="d-flex">

            <div id="toastMessage" class="toast-body">
                Mensaje
            </div>

            <button type="button"
                    class="btn-close btn-close-white me-2 m-auto"
                    data-bs-dismiss="toast">
            </button>

        </div>

    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const users = @Html.Raw(JsonSerializer.Serialize(
                                                    (Model.Users ?? new List<ERP_BIEN.Models.User>())
                                                                    .Select(u => new { id = u.Id, name = ((u.Name ?? "") + " " + (u.LastName ?? "")).Trim() })
                                                                    .OrderBy(x => x.name)
                                                                    .ToList()
                                    ));

            // CLICK FILA -> detalles
            document.querySelectorAll(".clickable-row").forEach(row => {
                row.addEventListener("click", function (e) {
                    if (e.target.closest("button") || e.target.closest("form") || e.target.closest("input")) return;
                    loadDetails(row.dataset.id);
                });
            });

            // Eliminar
            document.querySelectorAll(".btn-delete").forEach(btn => {
                btn.addEventListener("click", function (e) {
                    e.stopPropagation();
                    document.getElementById("deleteId").value = this.dataset.id;
                });
            });

            // Histórico (TIMELINE PRO)
const historyModal = new bootstrap.Modal(document.getElementById("historyModal"));

document.querySelectorAll(".btn-history").forEach(btn => {
    btn.addEventListener("click", function (e) {
        e.stopPropagation();

        const licId = this.dataset.id;
        const code = this.dataset.code;

        document.getElementById("historyTitle").innerText = `Histórico - ${code}`;

        const body = document.getElementById("historyBody");
        body.innerHTML = '<div class="text-center text-muted">Cargando...</div>';

        fetch(`/License/HistoryJson?licenseId=${licId}`)
            .then(r => r.json())
            .then(rows => {

                let html = '<div class="timeline">';

                if (!rows.length) {
                    html += `<div class="text-muted">Sin histórico</div>`;
                } else {

                    rows.forEach(r => {
                        html += `
                            <div class="timeline-item">

                                <div class="timeline-dot"></div>

                                <div class="timeline-content">

                                    <div class="fw-bold">${r.userName}</div>


                                    <div class="small text-muted">
                                        Inicio: ${r.startDate}
                                    </div>

                                    <div class="small text-muted">
                                        Fin: ${r.endDate ?? "ACTUAL"}
                                    </div>

                                    <div class="badge bg-secondary mt-1" style="font-size:11px;">
                                        ${Math.round(parseFloat(r.duration))} min
                                    </div>

                                </div>
                            </div>
                        `;
                    });

                }

                html += '</div>';

                body.innerHTML = html;
                historyModal.show();
            });
    });
});


            // ASIGNAR
            const assignModal = new bootstrap.Modal(document.getElementById("assignModal"));
            const assignLicenseId = document.getElementById("assignLicenseId");
            const assignUserId = document.getElementById("assignUserId");
            const assignSearch = document.getElementById("assignUserSearch");
            const assignResults = document.getElementById("assignUserResults");
            const assignSubmit = document.getElementById("assignSubmit");

            document.querySelectorAll(".btn-open-assign").forEach(btn => {
                btn.addEventListener("click", function (e) {
                    e.stopPropagation();
                    assignLicenseId.value = this.dataset.id;

                    assignUserId.value = "";
                    assignSubmit.disabled = true;
                    assignSearch.value = "";
                    assignResults.innerHTML = "";

                    renderUserResults(users.slice(0, 15));
                    assignModal.show();
                    assignSearch.focus();
                });
            });

                    function renderUserResults(list) {
            assignResults.innerHTML = "";

            const empty = document.getElementById("assignEmptyState");

            if (!list.length) {
                empty.classList.remove("d-none");
                return;
            }

            empty.classList.add("d-none");

            list.forEach(u => {
                const b = document.createElement("button");
                b.type = "button";
                b.className = "list-group-item list-group-item-action";
                b.textContent = u.name;

                b.onclick = () => {
                    assignUserId.value = u.id;
                    assignSubmit.disabled = false;

                    // ✅ resaltar seleccionado
                    assignResults.querySelectorAll(".active")
                        .forEach(x => x.classList.remove("active"));
                    b.classList.add("active");
                };

                assignResults.appendChild(b);
            });
        }
                    // ✅ FILTRAR USUARIOS AL ESCRIBIR
        assignSearch.addEventListener("input", function () {
            const term = assignSearch.value.trim().toLowerCase();

            // Si el input está vacío, mostramos los primeros usuarios
            if (!term) {
                renderUserResults(users.slice(0, 15));
                return;
            }

            // Filtramos por nombre/apellido
            const filtered = users
                .filter(u => u.name.toLowerCase().includes(term))
                .slice(0, 15);

            renderUserResults(filtered);
        });

