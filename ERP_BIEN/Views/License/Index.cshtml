// ✅ TOAST DESPUÉS DE RECARGA
// ==============================
window.addEventListener("load", function () {

    const msg = '@TempData["ToastMsg"]';
    const type = '@TempData["ToastType"]';

    if (msg && msg !== "") {
        showToast(msg, type || "success");
    }

});



