@model ERP_BIEN.Models.ViewModels.RoleIndexMvcViewModel

@{
    ViewData["Title"] = "Gestión de Roles";
}

<style>
    tr:hover {
        background-color: #f8f9fa;
        transition: 0.2s;
    }

    .role-row {
        cursor: pointer;
    }
</style>

<div class="page-header d-flex justify-content-between align-items-center mb-3">
    <h2>Gestión de Roles</h2>

    <button type="button"
            class="btn btn-primary"
            data-bs-toggle="modal"
            data-bs-target="#createModal">
        Crear Rol
    </button>
</div>

<!-- ========================= -->
<!-- FILTROS -->
<!-- ========================= -->
<form method="get"
      asp-action="Index"
      asp-controller="Role"
      class="card shadow-sm border-0 mb-4 p-4">

    <div class="row g-3 align-items-end">

        <div class="col-auto">
            <label class="form-label text-muted small">Búsqueda</label>
            <input type="text"
                   name="Search"
                   value="@Model.Search"
                   class="form-control"
                   placeholder="Buscar código o nombre" />
        </div>

        <div class="col-auto">
            <label class="form-label text-muted small">Page size</label>
            <select name="PageSize" class="form-select">
                <option value="5" selected="@(Model.PageSize == 5)">5</option>
                <option value="10" selected="@(Model.PageSize == 10)">10</option>
                <option value="25" selected="@(Model.PageSize == 25)">25</option>
                <option value="50" selected="@(Model.PageSize == 50)">50</option>
            </select>
        </div>

        <div class="col-auto">
            <input type="hidden" name="PageNumber" value="1" />
            <button type="submit" class="btn btn-primary">
                Filtrar
            </button>
        </div>

        <div class="col-auto">
            <button type="button"
                    class="btn btn-outline-secondary"
                    onclick="window.location.href='/Roles'">
                Limpiar filtros
            </button>
        </div>

    </div>
</form>
<!-- ========================= -->
<!-- CHIPS FILTROS ACTIVOS -->
<!-- ========================= -->
@{
    var search = Model.Search;
}

@if (!string.IsNullOrEmpty(search))
{
    <div class="mb-3 d-flex flex-wrap gap-2 align-items-center">

        <span class="chip">
            <span class="text-primary">Búsqueda:</span> @search
            <a class="x text-decoration-none"
                   href="@Url.Action("Index", new { pageNumber = 1, search = (string)null })">
                ×
            </a>
        </span>

        <a class="btn btn-sm btn-outline-danger" href="@Url.Action("Index", "Role")">
            ✖ Limpiar todos
        </a>

    </div>
}

<!-- ========================= -->
<!-- TABLA -->
<!-- ========================= -->
<table class="table table-hover align-middle shadow-sm">
    <thead class="table-light">
        <tr>
            <th>Código</th>
            <th>Nombre</th>
            <th style="width:220px;">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Roles.Any())
        {
            <tr>
                <td colspan="3" class="text-center text-muted">
                    No se encontraron roles.
                </td>
            </tr>
        }
        else
        {
            foreach (var role in Model.Roles)
            {
                <tr class="role-row"
                    data-id="@role.Id"
                    data-code="@role.Code"
                    data-name="@role.Name">

                    <td>@role.Code</td>
                    <td>@role.Name</td>
                    <td>
                        <!-- ✅ EDITAR -->
                        <button type="button"
                                class="btn btn-sm btn-outline-warning btn-edit-role"
                                data-bs-toggle="modal"
                                data-bs-target="#editModal"
                                data-id="@role.Id"
                                data-code="@role.Code"
                                data-name="@role.Name">
                            ✏️ Editar
                        </button>

                        <!-- ✅ ELIMINAR -->
                        <button type="button"
                                class="btn btn-sm btn-outline-danger btn-delete-role"
                                data-bs-toggle="modal"
                                data-bs-target="#deleteModal"
                                data-id="@role.Id"
                                data-name="@role.Name">
                            🗑️ Eliminar
                        </button>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

<!-- ========================= -->
<!-- PAGINACIÓN -->
<!-- ========================= -->
<nav aria-label="Page navigation" class="mt-3">
    <ul class="pagination justify-content-center">

        <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
            <a class="page-link"
                   asp-action="Index"
                   asp-controller="Role"
                   asp-route-PageNumber="@(Model.PageNumber - 1)"
                   asp-route-PageSize="@Model.PageSize"
                   asp-route-Search="@Model.Search">
                Anterior
            </a>
        </li>

        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(Model.PageNumber == i ? "active" : "")">
                <a class="page-link"
                       asp-action="Index"
                       asp-controller="Role"
                       asp-route-PageNumber="@i"
                       asp-route-PageSize="@Model.PageSize"
                       asp-route-Search="@Model.Search">
                    @i
                </a>
            </li>
        }

        <li class="page-item @(Model.PageNumber == Model.TotalPages || Model.TotalPages == 0 ? "disabled" : "")">
            <a class="page-link"
                   asp-action="Index"
                   asp-controller="Role"
                   asp-route-PageNumber="@(Model.PageNumber + 1)"
                   asp-route-PageSize="@Model.PageSize"
                   asp-route-Search="@Model.Search">
                Siguiente
            </a>
        </li>

    </ul>
</nav>

<!-- ========================= -->
<!-- CREATE MODAL -->
<!-- ========================= -->
<div class="modal fade" id="createModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="Create" asp-controller="Role" method="post">
                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title">Crear Rol</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <label>Código</label>
                    <input class="form-control" name="Code" required />

                    <label class="mt-2">Nombre</label>
                    <input class="form-control" name="Name" required />

                    <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
                    <input type="hidden" name="PageSize" value="@Model.PageSize" />
                    <input type="hidden" name="Search" value="@Model.Search" />
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Crear</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ========================= -->
<!-- EDIT MODAL -->
<!-- ========================= -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="Edit" asp-controller="Role" method="post">
                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title">Editar Rol</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" id="edit-id" name="Id" />

                    <label>Código</label>
                    <input class="form-control" id="edit-code" name="Code" required />

                    <label class="mt-2">Nombre</label>
                    <input class="form-control" id="edit-name" name="Name" required />

                    <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
                    <input type="hidden" name="PageSize" value="@Model.PageSize" />
                    <input type="hidden" name="Search" value="@Model.Search" />
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-warning">Guardar cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ========================= -->
<!-- DELETE MODAL -->
<!-- ========================= -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="Delete" asp-controller="Role" method="post">
                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title">Eliminar Rol</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" id="delete-id" name="id" />

                    <p>
                        ¿Seguro que deseas eliminar el rol
                        <strong id="delete-name"></strong>?
                    </p>

                    <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
                    <input type="hidden" name="PageSize" value="@Model.PageSize" />
                    <input type="hidden" name="Search" value="@Model.Search" />
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger">Eliminar</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ========================= -->
<!-- DETAILS MODAL -->
<!-- ========================= -->
<div class="modal fade" id="detailsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Detalles del Rol</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <p><strong>Código:</strong> <span id="det-code"></span></p>
                <p><strong>Nombre:</strong> <span id="det-name"></span></p>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", () => {

            // =========================
            // RELLENAR EDIT MODAL (CLICK)
            // =========================
            document.querySelectorAll(".btn-edit-role").forEach(btn => {
                btn.addEventListener("click", function (e) {
                    e.stopPropagation(); // para que NO abra details

                    document.getElementById("edit-id").value = this.dataset.id || "";
                    document.getElementById("edit-code").value = this.dataset.code || "";
                    document.getElementById("edit-name").value = this.dataset.name || "";
                });
            });

            // =========================
            // RELLENAR DELETE MODAL (CLICK)
            // =========================
            document.querySelectorAll(".btn-delete-role").forEach(btn => {
                btn.addEventListener("click", function (e) {
                    e.stopPropagation(); // para que NO abra details

                    document.getElementById("delete-id").value = this.dataset.id || "";
                    document.getElementById("delete-name").innerText = this.dataset.name || "";
                });
            });

            // =========================
            // CLICK EN FILA → DETALLES
            // =========================
            document.querySelectorAll(".role-row").forEach(row => {
                row.addEventListener("click", function (e) {

                    // Si click en un botón, no abrir detalles
                    if (e.target.closest("button")) return;

                    const code = this.dataset.code || "";
                    const name = this.dataset.name || "";

                    document.getElementById("det-code").innerText = code;
                    document.getElementById("det-name").innerText = name;

                    new bootstrap.Modal(document.getElementById("detailsModal")).show();
                });
            });

        });
    </script>
}