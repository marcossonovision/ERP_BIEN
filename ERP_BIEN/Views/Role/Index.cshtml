@model ERP_BIEN.Models.ViewModels.RoleIndexMvcViewModel
<link rel="stylesheet" href="~/css/role.css" asp-append-version="true" />

@{
    ViewData["Title"] = "Gestión de Roles";
}



<!-- ========================= -->
<!-- HEADER PRO -->
<!-- ========================= -->
<div class="header-pro d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0 fw-bold">Gestión de Roles</h2>
        <small class="text-muted">Mostrando @Model.Roles.Count() roles</small>
    </div>

    <div class="d-flex gap-2">
        <button type="button"
                class="btn btn-pill btn-create"
                data-bs-toggle="modal"
                data-bs-target="#createModal">
            ➕ Crear Rol
        </button>
    </div>
</div>

<!-- ========================= -->
<!-- FILTROS -->
<!-- ========================= -->
<form method="get"
      asp-action="Index"
      asp-controller="Role"
      class="card-pro filters-pro mb-4">

    <div class="row g-3 align-items-end">

        <!-- BUSQUEDA -->
        <div class="col-md-5">
            <label class="form-label">Búsqueda</label>

            <input type="text"
                   name="Search"
                   value="@Model.Search"
                   class="form-control"
                   placeholder="Buscar código o nombre..." />
        </div>

        <!-- PAGE SIZE -->
        <div class="col-md-3">
            <label class="form-label">Page size</label>

            <select name="PageSize" class="form-select">
                <option value="5" selected="@(Model.PageSize == 5)">5</option>
                <option value="10" selected="@(Model.PageSize == 10)">10</option>
                <option value="25" selected="@(Model.PageSize == 25)">25</option>
                <option value="50" selected="@(Model.PageSize == 50)">50</option>
            </select>
        </div>

        <!-- BOTONES -->
        <div class="col-md-4 d-flex gap-2 justify-content-end">
            <input type="hidden" name="PageNumber" value="1" />

            <button type="submit"
                    class="btn btn-pill btn-filter">
                🔍 Filtrar
            </button>

            <button type="button"
                    class="btn btn-pill btn-clear"
                    onclick="window.location.href='@Url.Action("Index","Role")'">
                Limpiar
            </button>
        </div>

    </div>
</form>

<!-- ========================= -->
<!-- FILTROS ACTIVOS -->
<!-- ========================= -->
@{
    string? search = Model.Search;
}

@if (!string.IsNullOrWhiteSpace(search))
{
    <div class="mb-3 d-flex flex-wrap gap-2 align-items-center">

        <span class="chip">
            <span class="text-primary">Búsqueda:</span> @search
            <a class="x text-decoration-none"
               href="@Url.Action("Index", new { PageNumber = 1, Search = (string?)null, PageSize = Model.PageSize })">
                ×
            </a>
        </span>

        <a class="chip chip-danger"
           href="@Url.Action("Index", "Role")"
           title="Limpiar todos">
            ✖ Limpiar todos
        </a>

    </div>
}

<!-- ========================= -->
<!-- TABLA (MISMO LOOK QUE USERS) -->
<!-- ========================= -->
<div class="table-shell mb-3">
    <div class="table-responsive">
        <table class="table-style align-middle">
            <thead>
                <tr>
                    <th style="width:25%;">Código</th>
                    <th>Nombre</th>
                    <th style="width:260px;" class="text-end">Acciones</th>
                </tr>
            </thead>

            <tbody>
                @if (!Model.Roles.Any())
                {
                    <tr>
                        <td colspan="3" class="text-center text-muted py-4">
                            No se encontraron roles.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var role in Model.Roles)
                    {
                        <tr class="role-row"
                            data-id="@role.Id"
                            data-code="@role.Code"
                            data-name="@role.Name">

                            <td>
                                <div class="fw-bold">@role.Code</div>
                                <div class="cell-muted">ID: @role.Id</div>
                            </td>

                            <td>
                                <div class="fw-semibold">@role.Name</div>
                                <div class="cell-muted">Nombre del rol</div>
                            </td>

                            <td class="text-end">
                                <div class="actions-wrap">
                                    <button type="button"
                                            class="btn-action btn-edit btn-edit-role"
                                            data-bs-toggle="modal"
                                            data-bs-target="#editModal"
                                            data-id="@role.Id"
                                            data-code="@role.Code"
                                            data-name="@role.Name">
                                        ✏️ Editar
                                    </button>

                                    <button type="button"
                                            class="btn-action btn-delete btn-delete-role"
                                            data-bs-toggle="modal"
                                            data-bs-target="#deleteModal"
                                            data-id="@role.Id"
                                            data-name="@role.Name">
                                        🗑️ Eliminar
                                    </button>
                                </div>
                            </td>

                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- ========================= -->
<!-- PAGINACIÓN -->
<!-- ========================= -->
<nav aria-label="Page navigation" class="mt-3">

    <ul class="pagination justify-content-center">

        <!-- PREV -->
        <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">

            <a class="page-link"
               asp-action="Index"
               asp-controller="Role"
               asp-route-PageNumber="@(Model.PageNumber - 1)"
               asp-route-PageSize="@Model.PageSize"
               asp-route-Search="@Model.Search">

                Anterior

            </a>

        </li>

        <!-- CURRENT -->
        <li class="page-item active">

            <span class="page-link">
                @Model.PageNumber
            </span>

        </li>

        <!-- NEXT -->
        <li class="page-item @(Model.Roles.Count() < Model.PageSize ? "disabled" : "")">

            <a class="page-link"
               asp-action="Index"
               asp-controller="Role"
               asp-route-PageNumber="@(Model.PageNumber + 1)"
               asp-route-PageSize="@Model.PageSize"
               asp-route-Search="@Model.Search">

                Siguiente

            </a>

        </li>

    </ul>

</nav>

<!-- ========================= -->
<!-- CREATE MODAL (PRO) -->
<!-- ========================= -->
<div class="modal fade modal-pro" id="createModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <form asp-action="Create" asp-controller="Role" method="post">
                <div class="modal-header">  
                    <div class="d-flex align-items-center gap-3">
                        <div class="modal-icon navy">➕</div>
                        <div>
                            <h5 class="modal-title fw-bold mb-0">Crear Rol</h5>
                            <div class="small opacity-75">Define código y nombre del rol</div>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <div class="preview-box mb-3">
                        <div class="preview-title">Nuevo rol</div>
                        <div class="preview-sub">Se añadirá al catálogo de roles</div>
                    </div>

                    <label class="form-label">Código</label>
                    <input class="form-control" name="Code" required />

                    <label class="form-label mt-3">Nombre</label>
                    <input class="form-control" name="Name" required />

                    <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
                    <input type="hidden" name="PageSize" value="@Model.PageSize" />
                    <input type="hidden" name="Search" value="@Model.Search" />
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-pill btn-outline-pro" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-pill btn-create">Crear</button>
                </div>

            </form>

        </div>
    </div>
</div>

<!-- ========================= -->
<!-- EDIT MODAL (PRO) -->
<!-- ========================= -->
<div class="modal fade modal-pro" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <form asp-action="Edit" asp-controller="Role" method="post" id="editRoleForm">
                <div class="modal-header">
                    <div class="d-flex align-items-center gap-3">
                        <div class="modal-icon warning">✏️</div>
                        <div>
                            <h5 class="modal-title fw-bold mb-0">Editar Rol</h5>
                            <div class="small opacity-75">Actualiza código y nombre</div>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" id="edit-id" name="Id" />

                    <div class="preview-box mb-3">
                        <div class="preview-title" id="edit-preview-title">—</div>
                        <div class="preview-sub" id="edit-preview-sub">—</div>
                    </div>

                    <label class="form-label">Código</label>
                    <input class="form-control" id="edit-code" name="Code" required />

                    <label class="form-label mt-3">Nombre</label>
                    <input class="form-control" id="edit-name" name="Name" required />

                    <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
                    <input type="hidden" name="PageSize" value="@Model.PageSize" />
                    <input type="hidden" name="Search" value="@Model.Search" />
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-pill btn-outline-pro" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-pill btn-save" id="btnEditRoleSave">Guardar cambios</button>
                </div>

            </form>

        </div>
    </div>
</div>

<!-- ========================= -->
<!-- DELETE MODAL (PRO) -->
<!-- ========================= -->
<div class="modal fade modal-pro" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <form asp-action="Delete" asp-controller="Role" method="post" id="deleteRoleForm">
                <div class="modal-header">
                    <div class="d-flex align-items-center gap-3">
                        <div class="modal-icon danger">🗑️</div>
                        <div>
                            <h5 class="modal-title fw-bold mb-0">Eliminar Rol</h5>
                            <div class="small opacity-75">Esta acción no se puede deshacer</div>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" id="delete-id" name="id" />

                    <div class="preview-box">
                        <div class="preview-title">¿Seguro?</div>
                        <div class="preview-sub">
                            Vas a eliminar el rol <strong id="delete-name"></strong>.
                        </div>
                    </div>

                    <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
                    <input type="hidden" name="PageSize" value="@Model.PageSize" />
                    <input type="hidden" name="Search" value="@Model.Search" />
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-pill btn-outline-pro" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-pill btn-danger-pro" id="btnDeleteRoleConfirm">Eliminar</button>
                </div>

            </form>

        </div>
    </div>
</div>

<!-- DETAILS MODAL (PRO) -->
<div class="modal fade modal-pro" id="detailsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <div class="d-flex align-items-center gap-3">
                    <div class="modal-icon navy">📌</div>

                    <div>
                        <h5 class="modal-title fw-bold mb-0">Detalles del Rol</h5>
                        <div class="small opacity-75">Información general del rol</div>
                    </div>
                </div>

                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">

                <div class="preview-box mb-3">
                    <div class="preview-title" id="det-code">—</div>
                    <div class="preview-sub" id="det-name">—</div>
                </div>

                <div class="role-info-grid">

                    <div class="info-card">
                        <div class="info-label">Código</div>
                        <div class="info-value" id="det-code-2">—</div>
                    </div>

                    <div class="info-card">
                        <div class="info-label">Nombre</div>
                        <div class="info-value" id="det-name-2">—</div>
                    </div>

                    <div class="info-card full">
                        <div class="info-label">Descripción</div>
                        <div class="info-value text-muted" id="det-description">
                            Sin descripción disponible
                        </div>
                    </div>

                </div>

            </div>

        </div>
    </div>
</div>

@section Scripts {
<script>
document.addEventListener("DOMContentLoaded", () => {

    // =========================
    // RELLENAR EDIT MODAL (CLICK)
    // =========================
    document.querySelectorAll(".btn-edit-role").forEach(btn => {
        btn.addEventListener("click", function (e) {
            e.stopPropagation();

            document.getElementById("edit-id").value = this.dataset.id || "";
            document.getElementById("edit-code").value = this.dataset.code || "";
            document.getElementById("edit-name").value = this.dataset.name || "";

            // preview PRO
            document.getElementById("edit-preview-title").textContent = this.dataset.code || "—";
            document.getElementById("edit-preview-sub").textContent   = this.dataset.name || "—";
        });
    });

    // =========================
    // RELLENAR DELETE MODAL (CLICK)
    // =========================
    document.querySelectorAll(".btn-delete-role").forEach(btn => {
        btn.addEventListener("click", function (e) {
            e.stopPropagation();
            document.getElementById("delete-id").value = this.dataset.id || "";
            document.getElementById("delete-name").innerText = this.dataset.name || "";
        });
    });

    // =========================
    // CLICK EN FILA → DETALLES
    // =========================
            document.querySelectorAll(".role-row").forEach(row => {
            row.addEventListener("click", function (e) {
                if (e.target.closest("button")) return;

                const code = this.dataset.code || "";
                const name = this.dataset.name || "";

                document.getElementById("det-code").innerText = code;
                document.getElementById("det-name").innerText = name;

                document.getElementById("det-code-2").innerText = code;
                document.getElementById("det-name-2").innerText = name;

                // 👇 aquí si luego tienes descripción real del backend
                document.getElementById("det-description").innerText =
                    this.dataset.description || "Este rol define permisos y acceso dentro del sistema.";

                bootstrap.Modal.getOrCreateInstance(
                    document.getElementById("detailsModal")
                ).show();
            });
        });
});
</script>
}