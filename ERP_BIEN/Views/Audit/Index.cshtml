@model ERP_BIEN.ViewModels.AuditIndexViewModel

@{
    ViewData["Title"] = "Auditoría";

    var qUser = Context.Request.Query["user"];
    var qAction = Context.Request.Query["action"];
    var qEntity = Context.Request.Query["entity"];
    var qFrom = Context.Request.Query["from"];
    var qTo = Context.Request.Query["to"];
}

<link rel="stylesheet" href="~/css/audit.css" asp-append-version="true" />

<h2 class="audit-title">Auditoría del sistema</h2>

<!-- ========================= -->
<!-- FILTROS -->
<!-- ========================= -->
<form method="get" class="audit-filters mb-4">

    <div class="row g-3">

        <div class="col-md-3">
            <label>Usuario</label>
            <input name="user" class="form-control" value="@qUser" />
        </div>

        <div class="col-md-2">
            <label>Acción</label>
            <select name="action" class="form-select">
                <option value="">Todas</option>
                <option value="Create" selected="@(qAction=="Create")">Create</option>
                <option value="Edit" selected="@(qAction=="Edit")">Edit</option>
                <option value="Delete" selected="@(qAction=="Delete")">Delete</option>
                <option value="Assign" selected="@(qAction=="Assign")">Assign</option>
                <option value="Remove" selected="@(qAction=="Remove")">Remove</option>
            </select>
        </div>

        <div class="col-md-2">
            <label>Entidad</label>
            <select name="entity" class="form-select">
                <option value="">Todas</option>
                <option value="Employee" selected="@(qEntity=="Employee")">Employee</option>
                <option value="Device" selected="@(qEntity=="Device")">Device</option>
                <option value="License" selected="@(qEntity=="License")">License</option>
                <option value="Role" selected="@(qEntity=="Role")">Role</option>
            </select>
        </div>

        <div class="col-md-2">
            <label>Desde</label>
            <input type="date" name="from" class="form-control" value="@qFrom" />
        </div>

        <div class="col-md-2">
            <label>Hasta</label>
            <input type="date" name="to" class="form-control" value="@qTo" />
        </div>

        <div class="col-md-1 d-flex align-items-end">
            <button class="btn btn-primary audit-btn w-100">
                Filtrar
            </button>
        </div>

    </div>

</form>

<!-- ========================= -->
<!-- TABLA -->
<!-- ========================= -->
<div class="audit-table-wrapper">

    <div class="table-responsive">

        <table class="table audit-table align-middle">

            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Usuario</th>
                    <th>Acción</th>
                    <th>Entidad</th>
                    <th>ID</th>
                    <th>Detalles</th>
                </tr>
            </thead>

            <tbody>
                @if (!Model.Logs.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">
                            No hay registros de auditoría
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var log in Model.Logs)
                    {
                        <tr>
                            <td>@log@log.Timestamp.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@log.UserName</td>

                            <td>
                                @if (log.Action == "Create")
                                {
                                    <span class="audit-badge audit-create">Create</span>
                                }
                                else if (log.Action == "Edit")
                                {
                                    <span class="audit-badge audit-edit">Edit</span>
                                }
                                else if (log.Action == "Delete")
                                {
                                    <span class="audit-badge audit-delete">Delete</span>
                                }
                                else
                                {
                                    <span class="audit-badge">Other</span>
                                }
                            </td>

                            <td>@log.Entity</td>
                            <td>#@log.EntityId</td>
                            <td>@log.Details</td>
                        </tr>
                    }
                }
            </tbody>

        </table>

    </div>

</div>

<!-- ========================= -->
<!-- PAGINACIÓN -->
<!-- ========================= -->
@if (Model.TotalPages > 1)
{
    <nav class="mt-4">
        <ul class="pagination justify-content-center">

            <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                <a class="page-link"
                   href="@Url.Action("Index", new {
                       page = Model.Page - 1,
                       pageSize = Model.PageSize,
                       user = qUser,
                       action = qAction,
                       entity = qEntity,
                       from = qFrom,
                       to = qTo
                   })">
                    «
                </a>
            </li>

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link"
                       href="@Url.Action("Index", new {
                           page = i,
                           pageSize = Model.PageSize,
                           user = qUser,
                           action = qAction,
                           entity = qEntity,
                           from = qFrom,
                           to = qTo
                       })">
                        @i
                    </a>
                </li>
            }

            <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
                <a class="page-link"
                   href="@Url.Action("Index", new {
                       page = Model.Page + 1,
                       pageSize = Model.PageSize,
                       user = qUser,
                       action = qAction,
                       entity = qEntity,
                       from = qFrom,
                       to = qTo
                   })">
                    »
                </a>
            </li>

        </ul>
    </nav>
}
