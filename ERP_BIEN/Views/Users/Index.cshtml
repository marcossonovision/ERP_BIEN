@using Microsoft.AspNetCore.Mvc.Rendering
@model List<ERP_BIEN.Models.ViewModels.UserViewModel>

<link rel="stylesheet" href="~/css/users.css" asp-append-version="true" />

@Html.AntiForgeryToken()

<details class="mb-3">
    <summary class="text-muted small">Ver claims (debug)</summary>
    <pre style="background:#111;color:#0f0;padding:10px;margin-top:10px;border-radius:10px;overflow:auto;">
MODULES:
@string.Join(", ", User.Claims.Where(c => c.Type == "module").Select(c => c.Value))

PERMISSIONS:
@string.Join(", ", User.Claims.Where(c => c.Type == "permission").Select(c => c.Value))
    </pre>
</details>

<!-- HEADER PRO -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0 fw-semibold">Gestión de Usuarios</h2>
        <small class="text-muted">Mostrando @(Model?.Count ?? 0) usuarios</small>
    </div>

    <div class="d-flex gap-2">
        <a asp-action="ExportExcel"
   asp-controller="Users"
   asp-route-searchName="@ViewBag.SearchName"
   asp-route-searchDomain="@ViewBag.SearchDomain"
   asp-route-searchTeamId="@ViewBag.SearchTeamId"
   asp-route-searchRoleId="@ViewBag.SearchRoleId"
   asp-route-searchIsActive="@ViewBag.SearchIsActive"
               class="btn-excel"
               id="btnExportExcel">
    📊 Excel
</a>


        <button type="button"
        class="btn-save-pro"
        data-bs-toggle="modal"
        data-bs-target="#createModal">
    ➕ Crear Usuario
</button>
    </div>
</div>




<!-- ========================= -->
<!-- FILTROS -->
<!-- ========================= -->
<form method="get" asp-action="Index" asp-controller="Users" class="filters-shell mb-3" id="usersFiltersForm">
    <div class="row g-3 align-items-end">
        <input type="hidden" name="pageNumber" value="1" />

        <div class="col-md-3">
            <label class="form-label text-muted small">Nombre</label>
            <input name="searchName" value="@ViewBag.SearchName" class="form-control" placeholder="Buscar por nombre..." />
        </div>

        <div class="col-md-3">
            <label class="form-label text-muted small">Usuario</label>
            <input name="searchDomain" value="@ViewBag.SearchDomain" class="form-control" placeholder="Buscar por usuario..." />
        </div>

        <div class="col-md-2">
            <label class="form-label text-muted small">Equipo</label>
            <select name="searchTeamId" class="form-select">
                <option value="">Todos</option>
                @foreach (var t in ViewBag.TeamList)
                {
                    <option value="@t.Value" selected="@(ViewBag.SearchTeamId?.ToString() == t.Value)">
                        @t.Text
                    </option>
                }
            </select>
        </div>

        <!-- ✅ NUEVO → ROL -->
        <div class="col-md-2">
            <label class="form-label text-muted small">Rol</label>
            <select name="searchRoleId" class="form-select">
                <option value="">Todos</option>
                @foreach (var r in ViewBag.RoleList)
                {
                    <option value="@r.Value" selected="@(ViewBag.SearchRoleId?.ToString() == r.Value)">
                        @r.Text
                    </option>
                }
            </select>
        </div>

        <!-- ✅ NUEVO → ESTADO -->
        <div class="col-md-2">
            <label class="form-label text-muted small">Estado</label>
            <select name="searchIsActive" class="form-select">
                <option value="">Todos</option>
                <option value="true" selected="@(((bool?)ViewBag.SearchIsActive) == true)">Activo</option>
                <option value="false" selected="@(((bool?)ViewBag.SearchIsActive) == false)">Inactivo</option>

            </select>
        </div>

        <div class="col-md-12 d-flex gap-2">
            <button type="submit" class="btn-filter-pro">
    🔎 Filtrar
</button>
        </div>

    </div>
</form>

@{
    var sn = ViewBag.SearchName as string;
    var sd = ViewBag.SearchDomain as string;
    var stId = ViewBag.SearchTeamId;
    var srId = ViewBag.SearchRoleId;
    var sa = ViewBag.SearchIsActive;
}

<!-- ========================= -->
<!-- CHIPS FILTROS ACTIVOS -->
<!-- ========================= -->
@if (!string.IsNullOrEmpty(sn) || !string.IsNullOrEmpty(sd) || stId != null || srId != null || sa != null)
{
    <div class="mb-3 d-flex flex-wrap gap-2 align-items-center">

        <!-- NOMBRE -->
        @if (!string.IsNullOrEmpty(sn))
        {
            <span class="chip">
                <span class="text-primary">Nombre:</span> @sn
                <a class="x text-decoration-none"
                   href="@Url.Action("Index", new { pageNumber = 1, searchName = (string)null, searchDomain = sd, searchTeamId = stId, searchRoleId = srId, searchIsActive = sa })">
                    ×
                </a>
            </span>
        }

        <!-- USUARIO -->
        @if (!string.IsNullOrEmpty(sd))
        {
            <span class="chip">
                <span class="text-info">Usuario:</span> @sd
                <a class="x text-decoration-none"
                   href="@Url.Action("Index", new { pageNumber = 1, searchName = sn, searchDomain = (string)null, searchTeamId = stId, searchRoleId = srId, searchIsActive = sa })">
                    ×
                </a>
            </span>
        }

        <!-- EQUIPO -->
        @if (stId != null)
        {
            var teamList = ViewBag.TeamList as IEnumerable<dynamic>;
            var selectedTeam = teamList?.FirstOrDefault(t => t.Value.ToString() == stId?.ToString());

            <span class="chip">
                <span class="text-secondary">Equipo:</span> @(selectedTeam?.Text ?? "—")
                <a class="x text-decoration-none"
                   href="@Url.Action("Index", new { pageNumber = 1, searchName = sn, searchDomain = sd, searchTeamId = (int?)null, searchRoleId = srId, searchIsActive = sa })">
                    ×
                </a>
            </span>
        }

        <!-- ROL -->
        @if (srId != null)
        {
            var roleList = ViewBag.RoleList as IEnumerable<dynamic>;
            var selectedRole = roleList?.FirstOrDefault(r => r.Value.ToString() == srId?.ToString());

            <span class="chip">
                <span class="text-info">Rol:</span> @(selectedRole?.Text ?? "—")
                <a class="x text-decoration-none"
                   href="@Url.Action("Index", new { pageNumber = 1, searchName = sn, searchDomain = sd, searchTeamId = stId, searchRoleId = (int?)null, searchIsActive = sa })">
                    ×
                </a>
            </span>
        }

        <!-- ESTADO -->
        @if (sa != null)
        {
            <span class="chip">
                <span class="text-secondary">Estado:</span> @(((bool?)sa) == true ? "Activo" : "Inactivo")
                <a class="x text-decoration-none"
                   href="@Url.Action("Index", new { pageNumber = 1, searchName = sn, searchDomain = sd, searchTeamId = stId, searchRoleId = srId, searchIsActive = (bool?)null })">
                    ×
                </a>
            </span>
        }

        <!-- ✅ LIMPIAR TODO (NUEVO) -->
        <a class="chip text-danger fw-semibold text-decoration-none"
           href="@Url.Action("Index", "Users")"
           title="Limpiar todos los filtros">
            ✖ Limpiar todo
        </a>

    </div>
}



<!-- ========================= -->
<!-- TABLA USERS (ESTILO GUÍA) -->
<!-- Wrapper: table-shell | Tabla: table-style -->
<!-- ========================= -->
<div class="table-shell mb-3">
  <div class="table-responsive">
    <table class="table-style align-middle">
      <thead>
        <tr>
          <th style="width:28%">Nombre</th>
          <th style="width:22%">Usuario</th>
          <th style="width:18%">Equipo</th>
          <th style="width:12%">Rol</th>
          <th style="width:10%">Estado</th>
          <th style="width:10%" class="text-end">Acciones</th>
        </tr>
      </thead>

      <tbody>
        @if (Model == null || !Model.Any())
        {
          <tr>
            <td colspan="6" class="text-center text-muted py-4">
              No se encontraron usuarios.
            </td>
          </tr>
        }
        else
        {
          foreach (var u in Model)
          {
            <tr class="user-row" data-id="@u.Id">
              <td>
                <div class="fw-bold">@u.Name @u.LastName</div>
                <div class="cell-muted">@u.Id</div>
              </td>

              <td>
                <div class="fw-semibold">@u.DomainUser</div>
                <div class="cell-muted">Usuario dominio</div>
              </td>

              <td>
                @if (!string.IsNullOrWhiteSpace(u.TeamName))
                {
                  <span class="pill pill-team">@u.TeamName</span>
                }
                else
                {
                  <span class="cell-muted">—</span>
                }
              </td>

              <td>
                <span class="pill pill-role">@u.RoleName</span>
              </td>

              <td class="text-center">
                <!-- ✅ Toggle: mantiene tu funcionalidad -->
                <button type="button"
                        class="toggle-active-btn @(u.IsActive ? "pill-active" : "pill-inactive")"
                        data-id="@u.Id">
                  @(u.IsActive ? "Activo" : "Inactivo")
                </button>
              </td>

              <td class="text-end">
                <div class="actions-wrap">
                  <!-- ✅ Mantiene tu JS (edit-btn/delete-btn) -->
                  <button type="button"
                          class="btn-action btn-edit edit-btn"
                          data-id="@u.Id">
                    Editar
                  </button>

                  <button type="button"
                          class="btn-action btn-delete delete-btn"
                          data-id="@u.Id">
                    Eliminar
                  </button>
                </div>
              </td>
            </tr>
          }
        }
      </tbody>
    </table>
  </div>
</div>

<!-- ========================= -->
<!-- PAGINACIÓN -->
<!-- ========================= -->
<nav aria-label="Paginación">
    <ul class="pagination justify-content-center">

        <li class="page-item @(((int)ViewBag.PageNumber) == 1 ? "disabled" : "")">
            @if (((int)ViewBag.PageNumber) > 1)
            {
                <a class="page-link"
                   href="@Url.Action("Index", new {
    pageNumber = (int)ViewBag.PageNumber - 1,
    searchName = ViewBag.SearchName,
    searchDomain = ViewBag.SearchDomain,
    searchTeamId = ViewBag.SearchTeamId,
    searchRoleId = ViewBag.SearchRoleId,
    searchIsActive = ViewBag.SearchIsActive
})">
                    Anterior
                </a>
            }
            else
            {
                <span class="page-link">Anterior</span>
            }
        </li>

        @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
        {
            var active = i == (int)ViewBag.PageNumber ? "active" : "";
            <li class="page-item @active">
                @if (i == (int)ViewBag.PageNumber)
                {
                    <span class="page-link">@i</span>
                }
                else
                {
                    <a class="page-link"
                       href="@Url.Action("Index", new { pageNumber = i, searchName = ViewBag.SearchName, searchDomain = ViewBag.SearchDomain, searchTeamId = ViewBag.SearchTeamId })">
                        @i
                    </a>
                }
            </li>
        }

        <li class="page-item @(((int)ViewBag.PageNumber) == (int)ViewBag.TotalPages || ((int)ViewBag.TotalPages) == 0 ? "disabled" : "")">
            @if (((int)ViewBag.TotalPages) > 0 && ((int)ViewBag.PageNumber) < (int)ViewBag.TotalPages)
            {
                <a class="page-link"
                   href="@Url.Action("Index", new {
    pageNumber = (int)ViewBag.PageNumber + 1,
    searchName = ViewBag.SearchName,
    searchDomain = ViewBag.SearchDomain,
    searchTeamId = ViewBag.SearchTeamId,
    searchRoleId = ViewBag.SearchRoleId,
    searchIsActive = ViewBag.SearchIsActive
})">
                    Siguiente
                </a>
            }
            else
            {
                <span class="page-link">Siguiente</span>
            }
        </li>

    </ul>
</nav>

<!-- ========================= -->
<!-- MODAL: CREAR USUARIO -->
<!-- ========================= -->
<div class="modal fade modal-pro" id="createModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-pro-card">

            <form method="post" asp-action="Create" asp-controller="Users">
                @Html.AntiForgeryToken()

                <!-- mantener filtros -->
                <input type="hidden" name="pageNumber" value="@ViewBag.PageNumber" />
                <input type="hidden" name="searchName" value="@ViewBag.SearchName" />
                <input type="hidden" name="searchDomain" value="@ViewBag.SearchDomain" />
                <input type="hidden" name="searchTeamId" value="@ViewBag.SearchTeamId" />
                <input type="hidden" name="searchRoleId" value="@ViewBag.SearchRoleId" />
                <input type="hidden" name="searchIsActive" value="@ViewBag.SearchIsActive" />

                <!-- HEADER -->
                <div class="modal-header modal-pro-header">
                    <div class="d-flex align-items-center gap-3">
                        <div class="modal-pro-icon">➕</div>
                        <div>
                            <h5 class="modal-title fw-bold mb-0">Crear usuario</h5>
                            <div class="small opacity-75">Nuevo registro en el sistema</div>
                        </div>
                    </div>

                    <button type="button"
                            class="btn-close btn-close-white"
                            data-bs-dismiss="modal"></button>
                </div>

                <!-- BODY -->
                <div class="modal-body">

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label class="form-label small text-muted">Nombre</label>
                            <input name="Name" class="form-control" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small text-muted">Apellidos</label>
                            <input name="LastName" class="form-control" required />
                        </div>

                        <div class="col-12">
                            <label class="form-label small text-muted">Usuario de dominio</label>
                            <input name="DomainUser" class="form-control" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small text-muted">Equipo</label>
                            <select name="TeamId" class="form-select">
                                <option value="">-- Sin equipo --</option>
                                @foreach (var t in ViewBag.TeamList)
                                {
                                    <option value="@t.Value">@t.Text</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small text-muted">Rol</label>
                            <select name="RoleId" class="form-select" required>
                                @foreach (var r in ViewBag.RoleList)
                                {
                                    <option value="@r.Value">@r.Text</option>
                                }
                            </select>
                        </div>

                        <div class="col-12">
                            <label class="form-label small text-muted">Estado</label>
                            <select name="IsActive" class="form-select">
                                <option value="true">Activo</option>
                                <option value="false">Inactivo</option>
                            </select>
                        </div>

                    </div>

                </div>

                <!-- FOOTER -->
                <div class="modal-footer modal-pro-footer">

                    <button type="button"
                            class="btn-cancel-pro"
                            data-bs-dismiss="modal">
                        Cancelar
                    </button>

                    <button type="submit" class="btn-save-pro">
                        <span>💾</span>
                        Crear usuario
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>
<!-- ========================= -->
<!-- MODAL: DETALLES (USER PRO) -->
<!-- ========================= -->
<div class="modal fade modal-pro" id="detailsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content modal-pro-card">

            <!-- HEADER -->
            <div class="modal-header modal-pro-header">
                <div class="d-flex align-items-center gap-3">

                    <div class="modal-pro-icon">👤</div>

                    <div>
                        <h5 class="modal-title fw-bold mb-0" id="det-name">—</h5>
                        <div class="small opacity-75" id="det-domain">—</div>
                    </div>

                </div>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"></button>
            </div>

            <!-- BODY -->
            <div class="modal-body">

                <!-- HERO USER -->
                <div class="detail-hero">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>
                            <div class="detail-name" id="det-name">—</div>
                            <div class="detail-domain" id="det-domain">—</div>
                        </div>

                        <div id="det-status" class="detail-status inactive">
                            —
                        </div>

                    </div>

                </div>

                <!-- INFO GRID -->
                <div class="info-grid">

                    <!-- EQUIPO -->
                    <div class="info-card">
                        <div class="info-label">
                            Equipo
                        </div>

                        <div class="info-value" id="det-team">
                            —
                        </div>
                    </div>

                    <!-- ROL -->
                    <div class="info-card">
                        <div class="info-label">
                            Rol
                        </div>

                        <div class="info-value" id="det-role">
                            —
                        </div>
                    </div>

                </div>

            </div>

            <!-- FOOTER -->
            <div class="modal-footer modal-pro-footer">

                <button type="button"
                        class="btn-cancel-pro"
                        data-bs-dismiss="modal">
                    Cerrar
                </button>

            </div>

        </div>
    </div>
</div>
<!-- ========================= -->
<!-- MODAL: ELIMINAR (PRO+) -->
<!-- ========================= -->
<div class="modal fade modal-pro" id="deleteModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content modal-pro-card">

      <div class="modal-header modal-pro-header">
        <div class="d-flex align-items-center gap-3">
          <div class="modal-pro-icon danger">🗑️</div>
          <div>
            <h5 class="modal-title fw-bold mb-0">Eliminar usuario</h5>
            <div class="small opacity-75">Esta acción no se puede deshacer</div>
          </div>
        </div>

        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>

      <div class="modal-body">
        <div class="modal-pro-warning">
          <div class="fw-bold mb-1">¿Seguro que deseas eliminar este usuario?</div>
          <div class="small">Se eliminará el registro.</div>
        </div>

        <!-- Opcional: si quieres mostrar a quién estás borrando -->
        <div class="modal-pro-target mt-3">
          <div class="text-muted small mb-1">Usuario seleccionado</div>
          <div class="fw-bold" id="deleteUserName">—</div>
          <div class="text-muted small" id="deleteUserDomain"></div>
        </div>
      </div>

      <div class="modal-footer modal-pro-footer">
        <button type="button" class="btn btn-outline-secondary btn-pill" data-bs-dismiss="modal">
          Cancelar
        </button>

        <!-- ✅ Botón rojo PRO (mantengo el ID para tu JS) -->
        <button type="button" id="confirmDeleteBtn" class="btn btn-pill btn-danger-pro">
          Eliminar
        </button>
      </div>

    </div>
  </div>
</div>



<!-- ========================= -->
<!-- MODAL: ELIMINADO CORRECTAMENTE -->
<!-- ========================= -->
<div class="modal fade" id="deleteSuccessModal" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Usuario eliminado</h5>
            </div>

            <div class="modal-body">
                <p>El usuario se ha eliminado correctamente.</p>
            </div>

            <div class="modal-footer">
                <button type="button" id="closeSuccessBtn" class="btn btn-primary">Aceptar</button>
            </div>

        </div>
    </div>
</div>
<!-- ========================= -->
<!-- MODAL: EDITAR USUARIO PRO -->
<!-- ========================= -->
<div class="modal fade modal-pro" id="editModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content modal-pro-card">

            <form method="post" asp-action="Edit" asp-controller="Users">

                @Html.AntiForgeryToken()

                <input type="hidden" id="edit-id" name="Id" />

                <!-- mantener filtros -->
                <input type="hidden" name="pageNumber" value="@ViewBag.PageNumber" />
                <input type="hidden" name="searchName" value="@ViewBag.SearchName" />
                <input type="hidden" name="searchDomain" value="@ViewBag.SearchDomain" />
                <input type="hidden" name="searchTeamId" value="@ViewBag.SearchTeamId" />
                <input type="hidden" name="searchRoleId" value="@ViewBag.SearchRoleId" />
                <input type="hidden" name="searchIsActive" value="@ViewBag.SearchIsActive" />

                <!-- HEADER -->
                <div class="modal-header modal-pro-header">

                    <div class="d-flex align-items-center gap-3">

                        <div class="modal-pro-icon">
                            ✏️
                        </div>

                        <div>
                            <h5 class="modal-title fw-bold mb-0">
                                Editar usuario
                            </h5>

                            <div class="small opacity-75">
                                Modifica la información del usuario
                            </div>
                        </div>

                    </div>

                    <button type="button"
                            class="btn-close btn-close-white"
                            data-bs-dismiss="modal">
                    </button>

                </div>

                <!-- BODY -->
                <div class="modal-body p-4">

                    <!-- PREVIEW USER -->
                    <div class="edit-preview-card mb-4">

                        <div class="edit-preview-avatar">
                            👤
                        </div>

                        <div>
                            <div class="edit-preview-name" id="edit-preview-name">
                                —
                            </div>

                            <div class="edit-preview-domain" id="edit-preview-domain">
                                —
                            </div>
                        </div>

                    </div>

                    <!-- FORM -->
                    <div class="row g-3">

                        <!-- NOMBRE -->
                        <div class="col-md-6">
                            <label class="form-label edit-label">
                                Nombre
                            </label>

                            <input id="edit-name"
                                   name="Name"
                                   class="form-control edit-input"
                                   required />
                        </div>

                        <!-- APELLIDOS -->
                        <div class="col-md-6">
                            <label class="form-label edit-label">
                                Apellidos
                            </label>

                            <input id="edit-lastname"
                                   name="LastName"
                                   class="form-control edit-input"
                                   required />
                        </div>

                        <!-- DOMAIN -->
                        <div class="col-12">
                            <label class="form-label edit-label">
                                Usuario dominio
                            </label>

                            <input id="edit-domain"
                                   name="DomainUser"
                                   class="form-control edit-input"
                                   required />
                        </div>

                        <!-- TEAM -->
                        <div class="col-md-6">
                            <label class="form-label edit-label">
                                Equipo
                            </label>

                            <select id="edit-team"
                                    name="TeamId"
                                    class="form-select edit-input">

                                <option value="">
                                    -- Sin equipo --
                                </option>

                                @foreach (var t in ViewBag.TeamList)
                                {
                                    <option value="@t.Value">
                                        @t.Text
                                    </option>
                                }

                            </select>
                        </div>

                        <!-- ROLE -->
                        <div class="col-md-6">
                            <label class="form-label edit-label">
                                Rol
                            </label>

                            <select id="edit-role"
                                    name="RoleId"
                                    class="form-select edit-input">

                                @foreach (var r in ViewBag.RoleList)
                                {
                                    <option value="@r.Value">
                                        @r.Text
                                    </option>
                                }

                            </select>
                        </div>

                        <!-- STATUS -->
                        <div class="col-12">
                            <label class="form-label edit-label">
                                Estado
                            </label>

                            <select id="edit-isactive"
                                    name="IsActive"
                                    class="form-select edit-input">

                                <option value="true">
                                    ✅ Activo
                                </option>

                                <option value="false">
                                    ⛔ Inactivo
                                </option>

                            </select>
                        </div>

                    </div>

                </div>

                <!-- FOOTER -->
                <div class="modal-footer modal-pro-footer">

                    <button type="button"
                            class="btn-cancel-pro"
                            data-bs-dismiss="modal">
                        Cancelar
                    </button>

                    <button type="submit"
                            class="btn-save-pro">

                        <span>💾</span>

                        Guardar cambios

                    </button>

                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', () => {

    // ============================
    // ✅ TOAST GLOBAL USERS (CORRECTO)
    // ============================
    function showToast(message, type = "success") {
        let toastEl = document.getElementById("usersToast");

        if (!toastEl) {
            const container = document.createElement("div");
            container.className = "toast-container position-fixed bottom-0 end-0 p-3";
            container.style.zIndex = "9999";

            container.innerHTML = `
                <div id="usersToast" class="toast text-white border-0 shadow-lg">
                    <div class="d-flex">
                        <div class="toast-body fw-semibold" id="usersToastMsg"></div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                    </div>
                </div>`;

            document.body.appendChild(container);
            toastEl = document.getElementById("usersToast");
        }

        const msgEl = document.getElementById("usersToastMsg");
        if (msgEl) msgEl.textContent = message;

        toastEl.className = "toast text-white border-0 shadow-lg";
        if (type === "success") toastEl.classList.add("bg-success");
        if (type === "error") toastEl.classList.add("bg-danger");
        if (type === "info") toastEl.classList.add("bg-primary");

        new bootstrap.Toast(toastEl, { delay: 2500 }).show();
    }

    // ============================
    // ✅ TOAST BACKEND
    // ============================
    const serverToastMsg = '@(TempData["ToastMsg"] ?? "")';
    const serverToastType = '@(TempData["ToastType"] ?? "")';
    if (serverToastMsg) {
        showToast(serverToastMsg, serverToastType || "info");
    }

    // ============================
    // ✅ SIN VALIDACIÓN (QUITADO)
    // ============================

    const createForm = document.querySelector('#createModal form');
    const editForm   = document.querySelector('#editModal form');

    console.log("CreateForm:", createForm);
    console.log("EditForm:", editForm);

    createForm?.addEventListener("submit", function () {
        console.log("Submit CREATE OK");
    });

    editForm?.addEventListener("submit", function () {

    console.log("Submit EDIT OK");

    // Botón guardar
    const btn = this.querySelector(".btn-save-pro");

    if (btn) {

        // Deshabilitar para evitar doble submit
        btn.disabled = true;

        // Cambiar contenido visual
        btn.innerHTML = `
            <span class="spinner-border spinner-border-sm"></span>
            Guardando...
        `;
    }
});
    // ============================
    // TOOLTIPS
    // ============================
    document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(el => new bootstrap.Tooltip(el));

    let lastDetailsUser = null;

    // ============================
    // CLICK EN FILA → DETALLES
    // ============================
    document.querySelectorAll(".user-row").forEach(row => {
        row.addEventListener("click", async (e) => {
            if (e.target.closest("button") || e.target.closest("[data-bs-toggle]")) return;
            const id = row.dataset.id;
            if (!id) return;
            await loadDetails(id);
        });
    });

    // ============================
    // EDITAR
    // ============================
    document.querySelectorAll(".edit-btn").forEach(btn => {
        btn.addEventListener("click", async (e) => {
            e.stopPropagation();
            const id = btn.dataset.id;
            if (!id) return;

            try {
                const res = await fetch(`/Users/Details/${id}`);
                if (!res.ok) throw new Error("Error fetching details");
                const u = await res.json();

                fillEditModal(u);
                new bootstrap.Modal(document.getElementById("editModal")).show();
            } catch {
                showToast("No se pudo cargar el usuario ❌", "error");
            }
        });
    });

    // ============================
// DELETE (PRO + ROBUSTO)
// ============================
let userIdToDelete = null;

document.querySelectorAll(".delete-btn").forEach(btn => {
    btn.addEventListener("click", (e) => {
        e.stopPropagation();

        userIdToDelete = btn.dataset.id;

        // ✅ OPCIONAL: mostrar info del usuario en el modal (si existen estos IDs)
        // (Si no existen, no pasa nada)
        const row = document.querySelector(`tr[data-id="${userIdToDelete}"]`);
        const fullName = row?.querySelector("td:nth-child(1)")?.innerText?.trim();
        const domain = row?.querySelector("td:nth-child(2)")?.innerText?.trim();

        const nameEl = document.getElementById("deleteUserName");
        const domEl  = document.getElementById("deleteUserDomain");
        if (nameEl) nameEl.textContent = fullName || "—";
        if (domEl)  domEl.textContent  = domain || "";

        // ✅ Abrir modal (evita instancias duplicadas)
        bootstrap.Modal.getOrCreateInstance(document.getElementById("deleteModal")).show();
    });
});

document.getElementById("confirmDeleteBtn")?.addEventListener("click", async () => {
    if (!userIdToDelete) return;

    const btn = document.getElementById("confirmDeleteBtn");
    const oldBtnText = btn?.innerText;

    // ✅ Evitar doble click
    if (btn) {
        btn.disabled = true;
        btn.innerText = "Eliminando...";
    }

    // ✅ Antiforgery token (desde tu input global)
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

    try {
        const response = await fetch("/Users/Delete", {
            method: "POST",
            headers: {
                "Content-Type": "application/json",
                "RequestVerificationToken": token
            },
            body: JSON.stringify({ id: userIdToDelete })
        });

        if (!response.ok) throw new Error();

        // ✅ Cerrar modal
        bootstrap.Modal.getOrCreateInstance(document.getElementById("deleteModal")).hide();

        // ✅ Quitar fila
        document.querySelector(`tr[data-id="${userIdToDelete}"]`)?.remove();

        showToast("Usuario eliminado correctamente ✅", "success");

        // ✅ reset
        userIdToDelete = null;

    } catch {
        showToast("Error al eliminar usuario ❌", "error");
    } finally {
        if (btn) {
            btn.disabled = false;
            btn.innerText = oldBtnText || "Eliminar";
        }
    }
});


// ============================
// TOGGLE ACTIVO (usa pill-active/pill-inactive)
// ============================
document.querySelectorAll(".toggle-active-btn").forEach(btn => {
  btn.addEventListener("click", async function (e) {
    e.stopPropagation();

    const id = this.dataset.id;
    const oldText = this.innerText;

    this.disabled = true;
    this.innerText = "Guardando...";

    try {
      const response = await fetch(`/Users/ToggleActive?id=${id}`, { method: "POST" });
      if (!response.ok) throw new Error();

      const data = await response.json();
      const isActive = !!data.isActive;

      // Texto
      this.innerText = isActive ? "Activo" : "Inactivo";

      // ✅ Clases correctas (verde/rojo)
      this.classList.remove("pill-active", "pill-inactive");
      this.classList.add(isActive ? "pill-active" : "pill-inactive");

      showToast(isActive ? "Usuario activado ✅" : "Usuario desactivado ✅", "info");
    } catch {
      this.innerText = oldText;
      showToast("Error al cambiar el estado ❌", "error");
    } finally {
      this.disabled = false;
    }
  });
});

    // ============================
    // EXPORT EXCEL
    // ============================
    document.getElementById("btnExportExcel")?.addEventListener("click", () => {
        showToast("Generando archivo Excel...", "info");
    });

   // ============================
// DETAILS (PRO)
// ============================
async function loadDetails(id) {
    try {
        const res = await fetch(`/Users/Details/${id}`);
        if (!res.ok) throw new Error();
        const u = await res.json();

        lastDetailsUser = u;

        // Nombre + dominio
        const fullName = `${u.name ?? ''} ${u.lastName ?? ''}`.trim();
        document.getElementById("det-name").innerText = fullName || "—";
        document.getElementById("det-domain").innerText = u.domainUser ?? "—";

        // Equipo (badge-team)
        const teamEl = document.getElementById("det-team");
        if (teamEl) {
            teamEl.innerHTML = u.teamName
                ? `<span class="badge-team">${escapeHtml(u.teamName)}</span>`
                : `<span class="text-muted">Sin equipo</span>`;
        }

        // Rol (badge-role)
        const roleEl = document.getElementById("det-role");
        if (roleEl) {
            roleEl.innerHTML = `<span class="badge-role">${escapeHtml(u.roleName ?? "Sin rol")}</span>`;
        }

        // Estado (badge)
        const statusEl = document.getElementById("det-status");
        if (statusEl) {
            statusEl.innerHTML = u.isActive
                ? `<span class="badge bg-success px-3 py-2">✅ Activo</span>`
                : `<span class="badge bg-secondary px-3 py-2">⛔ Inactivo</span>`;
        }

        // Abrir modal
        new bootstrap.Modal(document.getElementById("detailsModal")).show();

    } catch {
        showToast("No se pudieron cargar los detalles ❌", "error");
    }
}

// Helper para evitar problemas si algún texto trae caracteres raros
function escapeHtml(str) {
    return (str ?? "").toString()
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
}


    function fillEditModal(u) {
  document.getElementById("edit-id").value = u.id ?? '';
  document.getElementById("edit-name").value = u.name ?? '';
  document.getElementById("edit-lastname").value = u.lastName ?? '';
  document.getElementById("edit-domain").value = u.domainUser ?? '';
  document.getElementById("edit-team").value = u.teamId ?? '';
  document.getElementById("edit-role").value = u.roleId ?? '';
  document.getElementById("edit-isactive").value = u.isActive ? "true" : "false";

  const full = `${u.name ?? ""} ${u.lastName ?? ""}`.trim();
  document.getElementById("edit-preview-name").textContent = full || "—";
  document.getElementById("edit-preview-domain").textContent = u.domainUser ?? "—";
}


});


</script>
}