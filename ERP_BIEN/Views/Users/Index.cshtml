@using Microsoft.AspNetCore.Mvc.Rendering
@model List<ERP_BIEN.Models.ViewModels.UserViewModel>

@Html.AntiForgeryToken()

<details class="mb-3">
    <summary class="text-muted small">Ver claims (debug)</summary>
    <pre style="background:#111;color:#0f0;padding:10px;margin-top:10px;border-radius:10px;overflow:auto;">
MODULES:
@string.Join(", ", User.Claims.Where(c => c.Type == "module").Select(c => c.Value))

PERMISSIONS:
@string.Join(", ", User.Claims.Where(c => c.Type == "permission").Select(c => c.Value))
    </pre>
</details>

<!-- HEADER PRO -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0 fw-semibold">Gestión de Usuarios</h2>
        <small class="text-muted">Mostrando @(Model?.Count ?? 0) usuarios</small>
    </div>

    <div class="d-flex gap-2">
        <a asp-action="ExportExcel"
   asp-controller="Users"
   asp-route-searchName="@ViewBag.SearchName"
   asp-route-searchDomain="@ViewBag.SearchDomain"
   asp-route-searchTeamId="@ViewBag.SearchTeamId"
   asp-route-searchRoleId="@ViewBag.SearchRoleId"
   asp-route-searchIsActive="@ViewBag.SearchIsActive"
   class="btn btn-success">
    📊 Excel
</a>


        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createModal">
            ➕ Crear Usuario
        </button>
    </div>
</div>

<style>
    /* ===== Chips ===== */
    .chip {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: 6px 12px;
        border-radius: 999px;
        font-size: .85rem;
        font-weight: 500;
        border: 1px solid rgba(0,0,0,.08);
        background: #fff;
    }

    .chip .x {
        border: 0;
        background: transparent;
        padding: 0 4px;
        cursor: pointer;
        font-weight: 700;
        opacity: .7;
    }

    .chip .x:hover { opacity: 1; }

    /* ===== Layout ===== */
    .card-pro {
        background: #fff;
        border: 0;
        border-radius: 12px;
        box-shadow: 0 2px 10px rgba(0,0,0,.06);
    }

    .form-control, .form-select { border-radius: 10px; }

    /* ===== Tabla “card rows” ===== */
    .table-card {
        border-collapse: separate;
        border-spacing: 0 8px;
    }

    .table-card thead th {
        font-size: .78rem;
        text-transform: uppercase;
        letter-spacing: .6px;
        color: #6c757d;
    }

    .table-card tbody tr {
        background: #fff;
        box-shadow: 0 1px 6px rgba(0,0,0,0.05);
        transition: transform .12s ease, background-color .12s ease, box-shadow .12s ease;
    }

    .table-card tbody tr td:first-child {
        border-top-left-radius: 12px;
        border-bottom-left-radius: 12px;
    }

    .table-card tbody tr td:last-child {
        border-top-right-radius: 12px;
        border-bottom-right-radius: 12px;
    }

    .table-card tbody td {
        border-top: none !important;
        padding: 12px 14px;
        vertical-align: middle;
    }

    .user-row { cursor: pointer; }

    .user-row:hover {
        background-color: #f8fafc;
        transform: scale(1.001);
        box-shadow: 0 4px 16px rgba(0,0,0,.08);
    }

    /* ===== Acciones en hover ===== */
    .actions-col { width: 190px; white-space: nowrap; }
    .actions-wrap { opacity: 0; transition: opacity .15s ease; }
    .user-row:hover .actions-wrap { opacity: 1; }

    /* ===== Badges ===== */
    .badge-team {
        background: linear-gradient(135deg, #eef2ff, #e0e7ff);
        color: #3730a3;
        padding: 6px 12px;
        font-size: 0.75rem;
        border-radius: 999px;
        font-weight: 600;
        display: inline-block;
        max-width: 260px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .badge-role {
        background: linear-gradient(135deg, #dbeafe, #bfdbfe);
        color: #1e3a8a;
        padding: 6px 12px;
        font-size: 0.75rem;
        border-radius: 999px;
        font-weight: 500;
        display: inline-block;
    }

    /* ===== Botones acciones ===== */
    .btn-group .btn {
        border-radius: 10px !important;
        padding: 6px 10px;
        border: 1px solid #dee2e6;
        background: #fff;
    }

    .btn-group .btn:hover { background: #f1f3f5; }
    .btn-group .btn.text-danger:hover { background: #ffe5e5; }

    /* Evitar que click de fila pise botones */
    .user-row button { pointer-events: auto !important; position: relative; z-index: 10; }

    .pagination .page-link { border-radius: 10px; margin: 0 2px; }
</style>

<!-- ========================= -->
<!-- FILTROS -->
<!-- ========================= -->
<form method="get" asp-action="Index" asp-controller="Users" class="card-pro p-4 mb-3" id="usersFiltersForm">
    <div class="row g-3 align-items-end">
        <input type="hidden" name="pageNumber" value="1" />

        <div class="col-md-3">
            <label class="form-label text-muted small">Nombre</label>
            <input name="searchName" value="@ViewBag.SearchName" class="form-control" placeholder="Buscar por nombre..." />
        </div>

        <div class="col-md-3">
            <label class="form-label text-muted small">Usuario</label>
            <input name="searchDomain" value="@ViewBag.SearchDomain" class="form-control" placeholder="Buscar por usuario..." />
        </div>

        <div class="col-md-2">
            <label class="form-label text-muted small">Equipo</label>
            <select name="searchTeamId" class="form-select">
                <option value="">Todos</option>
                @foreach (var t in ViewBag.TeamList)
                {
                    <option value="@t.Value" selected="@(ViewBag.SearchTeamId?.ToString() == t.Value)">
                        @t.Text
                    </option>
                }
            </select>
        </div>

        <!-- ✅ NUEVO → ROL -->
        <div class="col-md-2">
            <label class="form-label text-muted small">Rol</label>
            <select name="searchRoleId" class="form-select">
                <option value="">Todos</option>
                @foreach (var r in ViewBag.RoleList)
                {
                    <option value="@r.Value" selected="@(ViewBag.SearchRoleId?.ToString() == r.Value)">
                        @r.Text
                    </option>
                }
            </select>
        </div>

        <!-- ✅ NUEVO → ESTADO -->
        <div class="col-md-2">
            <label class="form-label text-muted small">Estado</label>
            <select name="searchIsActive" class="form-select">
                <option value="">Todos</option>
                <option value="true" selected="@(ViewBag.SearchIsActive?.ToString() == "true")">Activo</option>
                <option value="false" selected="@(ViewBag.SearchIsActive?.ToString() == "false")">Inactivo</option>
            </select>
        </div>

        <div class="col-md-12 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Filtrar</button>
        </div>

    </div>
</form>

@{
    var sn = ViewBag.SearchName as string;
    var sd = ViewBag.SearchDomain as string;
    var stId = ViewBag.SearchTeamId;
    var srId = ViewBag.SearchRoleId;
    var sa = ViewBag.SearchIsActive;
}

<!-- ========================= -->
<!-- CHIPS FILTROS ACTIVOS -->
<!-- ========================= -->
@if (!string.IsNullOrEmpty(sn) || !string.IsNullOrEmpty(sd) || stId != null || srId != null || sa != null)
{
    <div class="mb-3 d-flex flex-wrap gap-2 align-items-center">

        <!-- NOMBRE -->
        @if (!string.IsNullOrEmpty(sn))
        {
            <span class="chip">
                <span class="text-primary">Nombre:</span> @sn
                <a class="x text-decoration-none"
                   href="@Url.Action("Index", new { pageNumber = 1, searchName = (string)null, searchDomain = sd, searchTeamId = stId, searchRoleId = srId, searchIsActive = sa })">
                    ×
                </a>
            </span>
        }

        <!-- USUARIO -->
        @if (!string.IsNullOrEmpty(sd))
        {
            <span class="chip">
                <span class="text-info">Usuario:</span> @sd
                <a class="x text-decoration-none"
                   href="@Url.Action("Index", new { pageNumber = 1, searchName = sn, searchDomain = (string)null, searchTeamId = stId, searchRoleId = srId, searchIsActive = sa })">
                    ×
                </a>
            </span>
        }

        <!-- EQUIPO -->
        @if (stId != null)
        {
            var teamList = ViewBag.TeamList as IEnumerable<dynamic>;
            var selectedTeam = teamList?.FirstOrDefault(t => t.Value.ToString() == stId?.ToString());

            <span class="chip">
                <span class="text-secondary">Equipo:</span> @(selectedTeam?.Text ?? "—")
                <a class="x text-decoration-none"
                   href="@Url.Action("Index", new { pageNumber = 1, searchName = sn, searchDomain = sd, searchTeamId = (int?)null, searchRoleId = srId, searchIsActive = sa })">
                    ×
                </a>
            </span>
        }

        <!-- ROL -->
        @if (srId != null)
        {
            var roleList = ViewBag.RoleList as IEnumerable<dynamic>;
            var selectedRole = roleList?.FirstOrDefault(r => r.Value.ToString() == srId?.ToString());

            <span class="chip">
                <span class="text-info">Rol:</span> @(selectedRole?.Text ?? "—")
                <a class="x text-decoration-none"
                   href="@Url.Action("Index", new { pageNumber = 1, searchName = sn, searchDomain = sd, searchTeamId = stId, searchRoleId = (int?)null, searchIsActive = sa })">
                    ×
                </a>
            </span>
        }

        <!-- ESTADO -->
        @if (sa != null)
        {
            <span class="chip">
                <span class="text-secondary">Estado:</span> @(sa.ToString() == "true" ? "Activo" : "Inactivo")
                <a class="x text-decoration-none"
                   href="@Url.Action("Index", new { pageNumber = 1, searchName = sn, searchDomain = sd, searchTeamId = stId, searchRoleId = srId, searchIsActive = (bool?)null })">
                    ×
                </a>
            </span>
        }

        <!-- ✅ LIMPIAR TODO (NUEVO) -->
        <a class="chip text-danger fw-semibold text-decoration-none"
           href="@Url.Action("Index", "Users")"
           title="Limpiar todos los filtros">
            ✖ Limpiar todo
        </a>

    </div>
}



<!-- ========================= -->
<!-- TABLA -->
<!-- ========================= -->
<div class="card-pro p-3 mb-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 table-card">
            <thead class="table-light">
                <tr>
                    <th style="width:35%">Nombre</th>
                    <th style="width:35%">Usuario</th>
                    <th style="width:20%">Equipo</th>
                    <th style="width:15%">Rol</th>
                    <th style="width:10%">Estado</th>
                    <th style="width:10%" class="text-end">Acciones</th>
                </tr>
            </thead>

            <tbody>
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            No se encontraron usuarios.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var u in Model)
                    {
                        <tr class="user-row" data-id="@u.Id">
                            <td>
                                <div class="fw-semibold">@u.Name @u.LastName</div>
                            </td>

                            <td>
                                <div class="fw-semibold">@u.DomainUser</div>
                                <small class="text-muted">Usuario de dominio</small>
                            </td>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(u.TeamName))
                                {
                                    <span class="badge-team">@u.TeamName</span>
                                }
                                else
                                {
                                    <span class="text-muted">Sin equipo</span>
                                }
                            </td>

                            <!-- ROL -->
                            <td>
                                <span class="badge-role">@u.RoleName</span>
                            </td>

                            <!-- ESTADO (TOGGLE) -->
                            <td class="text-center">
                                <button type="button"
                                        class="btn btn-sm toggle-active-btn @(u.IsActive ? "btn-success" : "btn-secondary")"
                                        data-id="@u.Id">
                                    @(u.IsActive ? "Activo" : "Inactivo")
                                </button>
                            </td>

                            <!-- ACCIONES -->
                            <td class="actions-col text-end">
                                <div class="actions-wrap">
                                    <div class="btn-group" role="group">
                                        <button type="button"
                                                class="btn btn-sm btn-light edit-btn"
                                                data-id="@u.Id"
                                                data-bs-toggle="tooltip"
                                                data-bs-title="Editar">
                                            ✏️
                                        </button>

                                        <button type="button"
                                                class="btn btn-sm btn-light delete-btn text-danger"
                                                data-id="@u.Id"
                                                data-bs-toggle="tooltip"
                                                data-bs-title="Eliminar">
                                            🗑️
                                        </button>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>

        </table>
    </div>
</div>

<!-- ========================= -->
<!-- PAGINACIÓN -->
<!-- ========================= -->
<nav aria-label="Paginación">
    <ul class="pagination justify-content-center">

        <li class="page-item @(((int)ViewBag.PageNumber) == 1 ? "disabled" : "")">
            @if (((int)ViewBag.PageNumber) > 1)
            {
                <a class="page-link"
                   href="@Url.Action("Index", new { pageNumber = (int)ViewBag.PageNumber - 1, searchName = ViewBag.SearchName, searchDomain = ViewBag.SearchDomain, searchTeamId = ViewBag.SearchTeamId })">
                    Anterior
                </a>
            }
            else
            {
                <span class="page-link">Anterior</span>
            }
        </li>

        @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
        {
            var active = i == (int)ViewBag.PageNumber ? "active" : "";
            <li class="page-item @active">
                @if (i == (int)ViewBag.PageNumber)
                {
                    <span class="page-link">@i</span>
                }
                else
                {
                    <a class="page-link"
                       href="@Url.Action("Index", new { pageNumber = i, searchName = ViewBag.SearchName, searchDomain = ViewBag.SearchDomain, searchTeamId = ViewBag.SearchTeamId })">
                        @i
                    </a>
                }
            </li>
        }

        <li class="page-item @(((int)ViewBag.PageNumber) == (int)ViewBag.TotalPages || ((int)ViewBag.TotalPages) == 0 ? "disabled" : "")">
            @if (((int)ViewBag.TotalPages) > 0 && ((int)ViewBag.PageNumber) < (int)ViewBag.TotalPages)
            {
                <a class="page-link"
                   href="@Url.Action("Index", new { pageNumber = (int)ViewBag.PageNumber + 1, searchName = ViewBag.SearchName, searchDomain = ViewBag.SearchDomain, searchTeamId = ViewBag.SearchTeamId })">
                    Siguiente
                </a>
            }
            else
            {
                <span class="page-link">Siguiente</span>
            }
        </li>

    </ul>
</nav>

<!-- ========================= -->
<!-- MODAL: CREAR USUARIO -->
<!-- ========================= -->
<div class="modal fade" id="createModal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <form method="post" asp-action="Create" asp-controller="Users">
                @Html.AntiForgeryToken()

                <!-- MANTENER FILTROS -->
                <input type="hidden" name="pageNumber" value="@ViewBag.PageNumber" />
                <input type="hidden" name="searchName" value="@ViewBag.SearchName" />
                <input type="hidden" name="searchDomain" value="@ViewBag.SearchDomain" />
                <input type="hidden" name="searchTeamId" value="@ViewBag.SearchTeamId" />
                <input type="hidden" name="searchRoleId" value="@ViewBag.SearchRoleId" />
                <input type="hidden" name="searchIsActive" value="@ViewBag.SearchIsActive" />

                <div class="modal-header">
                    <h5 class="modal-title fw-semibold">Crear Usuario</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">

                    <!-- NOMBRE -->
                    <div class="mb-3">
                        <label class="form-label small text-muted">Nombre</label>
                        <input name="Name" class="form-control" required />
                    </div>

                    <!-- APELLIDOS -->
                    <div class="mb-3">
                        <label class="form-label small text-muted">Apellidos</label>
                        <input name="LastName" class="form-control" required />
                    </div>

                    <!-- DOMAIN USER -->
                    <div class="mb-3">
                        <label class="form-label small text-muted">Usuario de Dominio</label>
                        <input name="DomainUser" class="form-control" required />
                    </div>

                    <!-- EQUIPO -->
                    <div class="mb-3">
                        <label class="form-label small text-muted">Equipo</label>
                        <select name="TeamId" class="form-select">
                            <option value="">-- Sin equipo --</option>
                            @foreach (var t in ViewBag.TeamList)
                            {
                                <option value="@t.Value">@t.Text</option>
                            }
                        </select>
                    </div>

                    <!-- ✅ NUEVO → ROL -->
                    <div class="mb-3">
                        <label class="form-label small text-muted">Rol</label>
                        <select name="RoleId" class="form-select" required>
                            @foreach (var r in ViewBag.RoleList)
                            {
                                <option value="@r.Value">@r.Text</option>
                            }
                        </select>
                    </div>

                    <!-- ✅ NUEVO → ESTADO -->
                    <div class="mb-3">
                        <label class="form-label small text-muted">Estado</label>
                        <select name="IsActive" class="form-select">
                            <option value="true">Activo</option>
                            <option value="false">Inactivo</option>
                        </select>
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        Cancelar
                    </button>

                    <button type="submit" class="btn btn-primary">
                        Crear Usuario
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>
<!-- ========================= -->
<!-- MODAL: DETALLES -->
<!-- ========================= -->
<div class="modal fade" id="detailsModal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Detalles del Usuario</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <p><strong>Nombre:</strong> <span id="det-name"></span></p>
                <p><strong>Usuario:</strong> <span id="det-domain"></span></p>
                <p><strong>Equipo:</strong> <span id="det-team"></span></p>
                <p><strong>Rol:</strong> <span id="det-role">—</span></p>
                <p><strong>Estado:</strong> <span id="det-status">—</span></p>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-outline-warning" id="openEditFromDetails">✏️ Editar</button>
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<!-- ========================= -->
<!-- MODAL: EDITAR -->
<!-- ========================= -->
<div class="modal fade" id="editModal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <form method="post" asp-action="Edit" asp-controller="Users">
                @Html.AntiForgeryToken()

                <input type="hidden" name="Id" id="edit-id" />
                <input type="hidden" name="pageNumber" value="@ViewBag.PageNumber" />
                <input type="hidden" name="searchName" value="@ViewBag.SearchName" />
                <input type="hidden" name="searchDomain" value="@ViewBag.SearchDomain" />
                <input type="hidden" name="searchTeamId" value="@ViewBag.SearchTeamId" />
                <input type="hidden" name="searchRoleId" value="@ViewBag.SearchRoleId" />
                <input type="hidden" name="searchIsActive" value="@ViewBag.SearchIsActive" />

                <div class="modal-header">
                    <h5 class="modal-title">Editar Usuario</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body">

                    <!-- NOMBRE -->
                    <div class="mb-3">
                        <label class="form-label">Nombre</label>
                        <input name="Name" id="edit-name" class="form-control" />
                    </div>

                    <!-- APELLIDOS -->
                    <div class="mb-3">
                        <label class="form-label">Apellidos</label>
                        <input name="LastName" id="edit-lastname" class="form-control" />
                    </div>

                    <!-- DOMAIN -->
                    <div class="mb-3">
                        <label class="form-label">Usuario de Dominio</label>
                        <input name="DomainUser" id="edit-domain" class="form-control" />
                    </div>

                    <!-- EQUIPO -->
                    <div class="mb-3">
                        <label class="form-label">Equipo</label>
                        <select name="TeamId" id="edit-team" class="form-select">
                            @foreach (var t in ViewBag.TeamList)
                            {
                                <option value="@t.Value">@t.Text</option>
                            }
                        </select>
                    </div>

                    <!-- ✅ NUEVO → ROL -->
                    <div class="mb-3">
                        <label class="form-label">Rol</label>
                        <select name="RoleId" id="edit-role" class="form-select">
                            @foreach (var r in ViewBag.RoleList)
                            {
                                <option value="@r.Value">@r.Text</option>
                            }
                        </select>
                    </div>

                    <!-- ✅ NUEVO → ESTADO -->
                    <div class="mb-3">
                        <label class="form-label">Estado</label>
                        <select name="IsActive" id="edit-isactive" class="form-select">
                            <option value="true">Activo</option>
                            <option value="false">Inactivo</option>
                        </select>
                    </div>

                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        Cancelar
                    </button>
                    <button type="submit" class="btn btn-warning">
                        Guardar Cambios
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>


<!-- ========================= -->
<!-- MODAL: CONFIRMAR ELIMINACIÓN -->
<!-- ========================= -->
<div class="modal fade" id="deleteModal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Eliminar Usuario</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <p>¿Seguro que deseas eliminar este usuario?</p>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" id="confirmDeleteBtn" class="btn btn-danger">Eliminar</button>
            </div>

        </div>
    </div>
</div>

<!-- ========================= -->
<!-- MODAL: ELIMINADO CORRECTAMENTE -->
<!-- ========================= -->
<div class="modal fade" id="deleteSuccessModal" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Usuario eliminado</h5>
            </div>

            <div class="modal-body">
                <p>El usuario se ha eliminado correctamente.</p>
            </div>

            <div class="modal-footer">
                <button type="button" id="closeSuccessBtn" class="btn btn-primary">Aceptar</button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', () => {

    // ============================
    // ✅ TOAST GLOBAL USERS (CORRECTO)
    // ============================
    function showToast(message, type = "success") {
        let toastEl = document.getElementById("usersToast");

        if (!toastEl) {
            const container = document.createElement("div");
            container.className = "toast-container position-fixed bottom-0 end-0 p-3";
            container.style.zIndex = "9999";

            container.innerHTML = `
                <div id="usersToast" class="toast text-white border-0 shadow-lg">
                    <div class="d-flex">
                        <div class="toast-body fw-semibold" id="usersToastMsg"></div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                    </div>
                </div>`;

            document.body.appendChild(container);
            toastEl = document.getElementById("usersToast");
        }

        const msgEl = document.getElementById("usersToastMsg");
        if (msgEl) msgEl.textContent = message;

        toastEl.className = "toast text-white border-0 shadow-lg";
        if (type === "success") toastEl.classList.add("bg-success");
        if (type === "error") toastEl.classList.add("bg-danger");
        if (type === "info") toastEl.classList.add("bg-primary");

        new bootstrap.Toast(toastEl, { delay: 2500 }).show();
    }

    // ============================
    // ✅ TOAST BACKEND
    // ============================
    const serverToastMsg = '@(TempData["ToastMsg"] ?? "")';
    const serverToastType = '@(TempData["ToastType"] ?? "")';
    if (serverToastMsg) {
        showToast(serverToastMsg, serverToastType || "info");
    }

    // ============================
    // ✅ SIN VALIDACIÓN (QUITADO)
    // ============================

    const createForm = document.querySelector('#createModal form');
    const editForm   = document.querySelector('#editModal form');

    console.log("CreateForm:", createForm);
    console.log("EditForm:", editForm);

    createForm?.addEventListener("submit", function () {
        console.log("Submit CREATE OK");
    });

    editForm?.addEventListener("submit", function () {
        console.log("Submit EDIT OK");
    });

    // ============================
    // TOOLTIPS
    // ============================
    document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(el => new bootstrap.Tooltip(el));

    let lastDetailsUser = null;

    // ============================
    // CLICK EN FILA → DETALLES
    // ============================
    document.querySelectorAll(".user-row").forEach(row => {
        row.addEventListener("click", async (e) => {
            if (e.target.closest("button") || e.target.closest("[data-bs-toggle]")) return;
            const id = row.dataset.id;
            if (!id) return;
            await loadDetails(id);
        });
    });

    // ============================
    // EDITAR
    // ============================
    document.querySelectorAll(".edit-btn").forEach(btn => {
        btn.addEventListener("click", async (e) => {
            e.stopPropagation();
            const id = btn.dataset.id;
            if (!id) return;

            try {
                const res = await fetch(`/Users/Details/${id}`);
                if (!res.ok) throw new Error("Error fetching details");
                const u = await res.json();

                fillEditModal(u);
                new bootstrap.Modal(document.getElementById("editModal")).show();
            } catch {
                showToast("No se pudo cargar el usuario ❌", "error");
            }
        });
    });

    // ============================
    // DELETE
    // ============================
    let userIdToDelete = null;

    document.querySelectorAll(".delete-btn").forEach(btn => {
        btn.addEventListener("click", (e) => {
            e.stopPropagation();
            userIdToDelete = btn.dataset.id;
            new bootstrap.Modal(document.getElementById("deleteModal")).show();
        });
    });

    document.getElementById("confirmDeleteBtn")?.addEventListener("click", async () => {
        if (!userIdToDelete) return;

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        const response = await fetch("/Users/Delete", {
            method: "POST",
            headers: {
                "Content-Type": "application/json",
                "RequestVerificationToken": token
            },
            body: JSON.stringify({ id: userIdToDelete })
        });

        if (response.ok) {
            bootstrap.Modal.getInstance(document.getElementById("deleteModal"))?.hide();
            document.querySelector(`tr[data-id="${userIdToDelete}"]`)?.remove();
            showToast("Usuario eliminado correctamente ✅", "success");
        } else {
            showToast("Error al eliminar usuario ❌", "error");
        }
    });

    // ============================
    // TOGGLE ACTIVO
    // ============================
    document.querySelectorAll(".toggle-active-btn").forEach(btn => {
        btn.addEventListener("click", async function (e) {
            e.stopPropagation();

            const id = this.dataset.id;
            const oldText = this.innerText;

            this.disabled = true;
            this.innerText = "Guardando...";

            try {
                const response = await fetch(`/Users/ToggleActive?id=${id}`, { method: "POST" });
                if (!response.ok) throw new Error();

                const data = await response.json();
                const isActive = !!data.isActive;

                this.innerText = isActive ? "Activo" : "Inactivo";
                this.classList.remove("btn-success", "btn-secondary");
                this.classList.add(isActive ? "btn-success" : "btn-secondary");

                showToast(isActive ? "Usuario activado ✅" : "Usuario desactivado ✅", "info");
            } catch {
                this.innerText = oldText;
                showToast("Error al cambiar el estado ❌", "error");
            } finally {
                this.disabled = false;
            }
        });
    });

    // ============================
    // EXPORT EXCEL
    // ============================
    document.getElementById("btnExportExcel")?.addEventListener("click", () => {
        showToast("Generando archivo Excel...", "info");
    });

    // ============================
    // DETAILS
    // ============================
    async function loadDetails(id) {
        try {
            const res = await fetch(`/Users/Details/${id}`);
            if (!res.ok) throw new Error();
            const u = await res.json();

            lastDetailsUser = u;

            document.getElementById("det-name").innerText = `${u.name ?? ''} ${u.lastName ?? ''}`;
            document.getElementById("det-domain").innerText = u.domainUser ?? '';
            document.getElementById("det-team").innerText = u.teamName ?? '—';
            document.getElementById("det-role").innerText = u.roleName ?? '—';
            document.getElementById("det-status").innerText = u.isActive ? "Activo" : "Inactivo";

            new bootstrap.Modal(document.getElementById("detailsModal")).show();
        } catch {
            showToast("No se pudieron cargar los detalles ❌", "error");
        }
    }

    function fillEditModal(u) {
        document.getElementById("edit-id").value = u.id ?? '';
        document.getElementById("edit-name").value = u.name ?? '';
        document.getElementById("edit-lastname").value = u.lastName ?? '';
        document.getElementById("edit-domain").value = u.domainUser ?? '';
        document.getElementById("edit-team").value = u.teamId ?? '';
        document.getElementById("edit-role").value = u.roleId ?? '';
        document.getElementById("edit-isactive").value = u.isActive ? "true" : "false";
    }

});
</script>
}