        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Eliminar Usuario</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <p>¿Seguro que deseas eliminar este usuario?</p>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" id="confirmDeleteBtn" class="btn btn-danger">Eliminar</button>
            </div>

        </div>
    </div>
</div>

<!-- ========================= -->
<!-- MODAL: ELIMINADO CORRECTAMENTE -->
<!-- ========================= -->
<div class="modal fade" id="deleteSuccessModal" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Usuario eliminado</h5>
            </div>

            <div class="modal-body">
                <p>El usuario se ha eliminado correctamente.</p>
            </div>

            <div class="modal-footer">
                <button type="button" id="closeSuccessBtn" class="btn btn-primary">Aceptar</button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', () => {

    // Tooltips (Bootstrap)
    document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(el => new bootstrap.Tooltip(el));

    // LIMPIAR FILTROS
    const clearFiltersBtnEl = document.getElementById('clearFiltersBtn');
    if (clearFiltersBtnEl) {
        clearFiltersBtnEl.addEventListener('click', (e) => {
            e.preventDefault();
            window.location.href = '/Users/Index';
        });
    }

    let lastDetailsUser = null;

    // CLICK EN FILA → DETALLES
    document.querySelectorAll(".user-row").forEach(row => {
        row.addEventListener("click", async (e) => {
            if (e.target.closest("button") || e.target.closest("[data-bs-toggle]")) return;
            const id = row.dataset.id;
            if (!id) return;
            await loadDetails(id);
        });
    });

    // EDITAR
    document.querySelectorAll(".edit-btn").forEach(btn => {
        btn.addEventListener("click", async (e) => {
            e.stopPropagation();
            const id = btn.dataset.id;
            if (!id) return;

            try {
                const res = await fetch(`/Users/Details/${id}`);
                if (!res.ok) throw new Error('Error fetching details');
                const u = await res.json();

                fillEditModal(u);
                new bootstrap.Modal(document.getElementById("editModal")).show();
            } catch (err) {
                console.error('Error al cargar datos para editar:', err);
            }
        });
    });

    // ELIMINAR (AJAX)
    let userIdToDelete = null;

    document.querySelectorAll(".delete-btn").forEach(btn => {
        btn.addEventListener("click", (e) => {
            e.stopPropagation();
            userIdToDelete = btn.dataset.id;
            new bootstrap.Modal(document.getElementById("deleteModal")).show();
        });
    });

    const confirmDeleteBtn = document.getElementById("confirmDeleteBtn");
    if (confirmDeleteBtn) {
        confirmDeleteBtn.addEventListener("click", async () => {
            if (!userIdToDelete) return;

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            const response = await fetch('/Users/Delete', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify({ id: userIdToDelete })
            });

            if (response.ok) {
                bootstrap.Modal.getInstance(document.getElementById("deleteModal"))?.hide();
                // quitar fila sin recargar
                const row = document.querySelector(`tr.user-row[data-id="${userIdToDelete}"]`);
                row?.remove();

                new bootstrap.Modal(document.getElementById("deleteSuccessModal")).show();
            } else {
                alert("No se pudo eliminar el usuario.");
            }
        });
    }

    const closeSuccessBtn = document.getElementById("closeSuccessBtn");
    if (closeSuccessBtn) {
        closeSuccessBtn.addEventListener("click", () => {
            bootstrap.Modal.getInstance(document.getElementById("deleteSuccessModal"))?.hide();
        });
    }

    // DETALLES
    async function loadDetails(id) {
        try {
            const res = await fetch(`/Users/Details/${id}`);
            if (!res.ok) throw new Error('Error fetching details');
            const u = await res.json();

            lastDetailsUser = u;

            document.getElementById("det-name").innerText = (u.name ?? '') + ' ' + (u.lastName ?? '');
            document.getElementById("det-domain").innerText = u.domainUser ?? '';
            document.getElementById("det-team").innerText = u.teamName ?? '—';
            document.getElementById("det-role").innerText = u.roleName ?? '—';

            if (typeof u.isActive !== "undefined") {
                document.getElementById("det-status").innerText = u.isActive ? "Activo" : "Inactivo";
            } else {
                document.getElementById("det-status").innerText = '—';
            }

            new bootstrap.Modal(document.getElementById("detailsModal")).show();
        } catch (err) {
            console.error('Error al cargar detalles:', err);
        }
    }

    function fillEditModal(u) {
        document.getElementById("edit-id").value = u.id ?? '';
        document.getElementById("edit-name").value = u.name ?? '';
        document.getElementById("edit-lastname").value = u.lastName ?? '';
        document.getElementById("edit-domain").value = u.domainUser ?? '';
        document.getElementById("edit-team").value = u.teamId ?? '';

        // Si activas RoleId editable:
        // document.getElementById("edit-role").value = u.roleId ?? '';
    }

    // EDITAR desde DETALLES
    const openEditFromDetails = document.getElementById("openEditFromDetails");
    if (openEditFromDetails) {
        openEditFromDetails.addEventListener("click", () => {
            if (!lastDetailsUser) return;

            fillEditModal(lastDetailsUser);

            bootstrap.Modal.getInstance(document.getElementById("detailsModal"))?.hide();
            new bootstrap.Modal(document.getElementById("editModal")).show();
        });
    }

    // TOGGLE ACTIVO/INACTIVO (SIN RECARGAR)
    document.querySelectorAll(".toggle-active-btn").forEach(btn => {
        btn.addEventListener("click", async function (e) {
            e.stopPropagation();

            const id = this.dataset.id;
            const oldText = this.innerText;

            this.disabled = true;
            this.innerText = "Guardando...";

            try {
                const response = await fetch(`/Users/ToggleActive?id=${id}`, { method: "POST" });
                if (!response.ok) throw new Error();

                const data = await response.json();
                const isActive = !!data.isActive;

                this.innerText = isActive ? "Activo" : "Inactivo";
                this.classList.remove("btn-success", "btn-secondary");
                this.classList.add(isActive ? "btn-success" : "btn-secondary");

            } catch {
                this.innerText = oldText;
                alert("No se pudo cambiar el estado");
            } finally {
                this.disabled = false;
            }
        });
    });

});
</script>
}