@using Microsoft.AspNetCore.Mvc.Rendering
@model List<ERP_BIEN.Models.ViewModels.UserViewModel>

@Html.AntiForgeryToken()

<details class="mb-3">
    <summary class="text-muted small">Ver claims (debug)</summary>
    <pre style="background:#111;color:#0f0;padding:10px;margin-top:10px;border-radius:10px;overflow:auto;">
MODULES:
@string.Join(", ", User.Claims.Where(c => c.Type == "module").Select(c => c.Value))

PERMISSIONS:
@string.Join(", ", User.Claims.Where(c => c.Type == "permission").Select(c => c.Value))
    </pre>
</details>

<!-- HEADER PRO -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0 fw-semibold">Gestión de Usuarios</h2>
        <small class="text-muted">Mostrando @(Model?.Count ?? 0) usuarios</small>
    </div>

    <div class="d-flex gap-2">
        <a asp-action="ExportExcel"
   asp-controller="Users"
   asp-route-searchName="@ViewBag.SearchName"
   asp-route-searchDomain="@ViewBag.SearchDomain"
   asp-route-searchTeamId="@ViewBag.SearchTeamId"
   asp-route-searchRoleId="@ViewBag.SearchRoleId"
   asp-route-searchIsActive="@ViewBag.SearchIsActive"
   class="btn-excel">
    📊 Excel
</a>


        <button type="button"
        class="btn-save-pro"
        data-bs-toggle="modal"
        data-bs-target="#createModal">
    ➕ Crear Usuario
</button>
    </div>
</div>

<style>
/* =========================================================
   0) PALETA (TU GUÍA)
   ========================================================= */
:root{
  --w:#ffffff;
  --b:#000000;

  --c-cyan:#0090E0;
  --c-navy:#032966;   /* Azul marino profundo (principal) */
  --c-navy2:#004080;  /* Azul oscuro profundo (secundario) */

  --c-success:#28A745;
  --c-warning:#FFC107;
  --c-danger:#DC3545;
  --c-info:#17A2B8;

  --border:#E6EAF2;

  /* Zebra azul claro estilo tu ejemplo */
  --row-alt:#D9F1FF;
  --row-hover:#C7EBFF;
}

/* =========================================================
   1) CHIPS (filtros activos)
   ========================================================= */
.chip{
  display:inline-flex;
  align-items:center;
  gap:.35rem;
  padding:6px 12px;
  border-radius:999px;
  font-size:.85rem;
  font-weight:500;
  border:1px solid rgba(0,0,0,.08);
  background:#fff;
}
.chip .x{
  border:0;
  background:transparent;
  padding:0 4px;
  cursor:pointer;
  font-weight:700;
  opacity:.7;
}
.chip .x:hover{ opacity:1; }

/* =========================================================
   2) LAYOUT GENERAL
   ========================================================= */
.card-pro{
  background:#fff;
  border:0;
  border-radius:12px;
  box-shadow:0 2px 10px rgba(0,0,0,.06);
}
.form-control, .form-select{ border-radius:10px; }
.pagination .page-link{ border-radius:10px; margin:0 2px; }

/* =========================================================
   3) TABLA "CARD ROWS" (lo que ya tenías)
   - La dejamos por compatibilidad (por si la usas en otras páginas)
   ========================================================= */
.table-card{
  border-collapse:separate;
  border-spacing:0 8px;
}
.table-card thead th{
  font-size:.78rem;
  text-transform:uppercase;
  letter-spacing:.6px;
  color:#6c757d;
}
.table-card tbody tr{
  background:#fff;
  box-shadow:0 1px 6px rgba(0,0,0,0.05);
  transition:transform .12s ease, background-color .12s ease, box-shadow .12s ease;
}
.table-card tbody tr td:first-child{
  border-top-left-radius:12px;
  border-bottom-left-radius:12px;
}
.table-card tbody tr td:last-child{
  border-top-right-radius:12px;
  border-bottom-right-radius:12px;
}
.table-card tbody td{
  border-top:none !important;
  padding:12px 14px;
  vertical-align:middle;
}

/* Hover fila (si lo usas) */
.user-row{ cursor:pointer; }
.user-row:hover{
  background-color:#f8fafc;
  transform:scale(1.001);
  box-shadow:0 4px 16px rgba(0,0,0,.08);
}

/* Acciones en hover (si lo usas) */
.actions-col{ width:190px; white-space:nowrap; }
.actions-wrap{ opacity:0; transition:opacity .15s ease; }
.user-row:hover .actions-wrap{ opacity:1; }

/* Evitar que click de fila pise botones */
.user-row button{ pointer-events:auto !important; position:relative; z-index:10; }

/* =========================================================
   4) BADGES (los tuyos originales, por compatibilidad)
   ========================================================= */
.badge-team{
  background:linear-gradient(135deg, #eef2ff, #e0e7ff);
  color:#3730a3;
  padding:6px 12px;
  font-size:.75rem;
  border-radius:999px;
  font-weight:600;
  display:inline-block;
  max-width:260px;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}
.badge-role{
  background:linear-gradient(135deg, #dbeafe, #bfdbfe);
  color:#1e3a8a;
  padding:6px 12px;
  font-size:.75rem;
  border-radius:999px;
  font-weight:500;
  display:inline-block;
  white-space:nowrap;
}

/* =========================================================
   5) TABLA ESTILO (LA DE TU IMAGEN / GUÍA)
   - Compatibilidad: sirve si usas .table-shell/.table-style
   ========================================================= */
.table-shell{
  background:var(--w);
  border-radius:12px;
  box-shadow:0 2px 10px rgba(0,0,0,.06);
  overflow:hidden;
  border:1px solid var(--border);
}
.table-style{
  width:100%;
  margin:0;
  border-collapse:separate;
  border-spacing:0;
}
.table-style thead th{
  background:var(--c-navy);
  color:var(--w);
  font-weight:800;
  padding:14px 12px;
  border-bottom:0;
  white-space:nowrap;
  font-size:.9rem;
}
.table-style tbody td{
  padding:12px 12px;
  border-top:0;
  vertical-align:middle;
}
.table-style tbody tr:nth-child(even){
  background:var(--row-alt);
}
.table-style tbody tr:hover{
  background:var(--row-hover);
}

/* Texto auxiliar */
.cell-muted{
  color:rgba(0,0,0,.55);
  font-size:.85rem;
}

/* =========================================================
   6) TABLA "Licenses look" (USERS)
   - Compatibilidad: sirve si usas .users-table-wrap/.table-users
   - La mapeamos a la MISMA estética de tu guía
   ========================================================= */
.users-table-wrap{
  background:var(--w);
  border-radius:12px;
  box-shadow:0 2px 10px rgba(0,0,0,.06);
  overflow:hidden;
  border:1px solid var(--border);
}
.table-users{
  width:100%;
  margin:0;
  border-collapse:separate;
  border-spacing:0;
}
.table-users thead th{
  background:var(--c-navy) !important;
  color:var(--w) !important;
  font-weight:800;
  padding:14px 12px;
  border-bottom:0 !important;
  white-space:nowrap;
  font-size:.9rem;
}
.table-users tbody td{
  padding:12px 12px;
  vertical-align:middle;
  border-top:0 !important;
}
.table-users tbody tr:nth-child(even){
  background:var(--row-alt);
}
.table-users tbody tr:hover{
  background:var(--row-hover);
}

/* =========================================================
   7) PILLS (para equipo/rol/estado como tu tabla ejemplo)
   ========================================================= */
.pill{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  padding:6px 12px;
  border-radius:999px;
  font-weight:800;
  font-size:.78rem;
  line-height:1;
  white-space:nowrap;
}
.pill-team{
  background:rgba(0,0,0,.55);
  color:#fff;
}
.pill-role{
  background:var(--c-navy2);
  color:#fff;
}
.pill-active{ background:var(--c-success); color:#fff; }
.pill-inactive{ background:var(--c-danger); color:#fff; }

/* =========================================================
   8) BOTONES ACCIÓN (Editar/Borrar estilo tu ejemplo)
   - Importante: No usamos el mismo .btn-edit para 2 cosas distintas.
   ========================================================= */
.actions-wrap{
  display:flex;
  justify-content:flex-end;
  gap:10px;
  flex-wrap:nowrap;
}

/* Botón acción redondeado */
.btn-action{
  border:0 !important;
  border-radius:999px !important;
  padding:7px 12px !important;
  font-weight:800 !important;
  font-size:.78rem !important;
  line-height:1 !important;
  color:#fff !important;
  white-space:nowrap;
}

/* Variantes (paleta tu guía) */
.btn-action.btn-edit{
  background:var(--c-navy2) !important;
}
.btn-action.btn-delete{
  background:var(--c-danger) !important;
}
.btn-action:hover{ filter:brightness(.95); }

/* =========================================================
   9) TOGGLE ACTIVO (píldora con colores)
   - Solo define estética; el JS debe poner/quitar pill-active/pill-inactive
   ========================================================= */
.toggle-active-btn{
  border:0 !important;
  border-radius:999px !important;
  padding:7px 12px !important;
  font-weight:800 !important;
  font-size:.78rem !important;
  line-height:1 !important;
  color:#fff !important;
  white-space:nowrap;
  box-shadow:none !important;
}

/* =========================================================
   10) (Opcional) Botonera en tablas tipo Licenses
   - Si lo usas (users-actions), queda consistente
   ========================================================= */
.users-actions{
  display:flex;
  gap:10px;
  justify-content:flex-end;
  align-items:center;
  flex-wrap:nowrap;
}
/* ===== Modal PRO (coherente con tu paleta guía) ===== */
.modal-pro .modal-pro-card{
  border:1px solid var(--border, #E6EAF2);
  border-radius:16px;
  overflow:hidden;
  box-shadow:0 12px 40px rgba(0,0,0,.20);
}

.modal-pro .modal-pro-header{
  background: linear-gradient(135deg, var(--c-navy, #032966), var(--c-navy2, #004080));
  color:#fff;
  border-bottom:0;
}

.modal-pro .modal-pro-footer{
  background:#fff;
  border-top:1px solid var(--border, #E6EAF2);
  padding:14px 16px;
}

.modal-pro .modal-pro-icon{
  width:46px;height:46px;
  border-radius:999px;
  display:flex;
  align-items:center;
  justify-content:center;
  font-weight:900;
}

.modal-pro .modal-pro-icon.danger{
  background: var(--c-danger, #DC3545);
  color:#fff;
}

/* Caja warning bonita */
.modal-pro-warning{
  background: rgba(255, 193, 7, .20);
  border:1px solid rgba(255, 193, 7, .35);
  border-radius:14px;
  padding:14px 16px;
  color:#111;
}

/* Caja de usuario seleccionado */
.modal-pro-target{
  background:#fff;
  border:1px solid var(--border, #E6EAF2);
  border-radius:14px;
  padding:12px 14px;
}

/* Botones pill */
.btn-pill{
  border-radius:999px !important;
  padding:10px 16px !important;
  font-weight:900 !important;
}

/* ✅ Eliminar rojo PRO */
.btn-danger-pro{
  background: var(--c-danger, #DC3545) !important;
  border:0 !important;
  color:#fff !important;
}
.btn-danger-pro:hover{
  filter:brightness(.95);
}
/* =========================================
   BOTÓN SAVE PRO
   ========================================= */
.btn-save-pro{
    border:0;
    border-radius:999px;
    padding:12px 20px;
    font-weight:800;
    font-size:.9rem;
    color:#fff;
    background:linear-gradient(135deg, var(--c-navy), var(--c-navy2));
    display:inline-flex;
    align-items:center;
    gap:8px;
    transition:all .18s ease;
    box-shadow:0 6px 18px rgba(3,41,102,.25);
}

.btn-save-pro:hover{
    transform:translateY(-1px);
    filter:brightness(1.03);
    box-shadow:0 10px 24px rgba(3,41,102,.35);
}

.btn-save-pro:active{
    transform:scale(.98);
}

.btn-save-pro:disabled{
    opacity:.7;
    cursor:not-allowed;
    transform:none;
    box-shadow:none;
}
.btn-excel{
    display:inline-flex;
    align-items:center;
    gap:8px;

    padding:10px 16px;
    border-radius:999px;

    font-weight:800;
    font-size:.85rem;

    color:#fff;
    background:linear-gradient(135deg, #28A745, #1f8a38);

    border:0;
    text-decoration:none;

    box-shadow:0 6px 18px rgba(40,167,69,.25);
    transition:all .18s ease;
}

.btn-excel:hover{
    transform:translateY(-1px);
    filter:brightness(1.05);
    box-shadow:0 10px 24px rgba(40,167,69,.35);
}

.btn-excel:active{
    transform:scale(.98);
}
/* ================================
   FILTROS PRO (CONSISTENCIA UI)
   ================================ */
.filters-shell{
    background:var(--w);
    border:1px solid var(--border);
    border-radius:12px;
    box-shadow:0 2px 10px rgba(0,0,0,.06);
    padding:18px;
}

/* labels */
.filters-shell .form-label{
    font-size:.75rem;
    font-weight:700;
    color:#6c757d;
    margin-bottom:6px;
}

/* inputs coherentes con tu sistema */
.filters-shell .form-control,
.filters-shell .form-select{
    border-radius:10px;
    border:1px solid #e3e6ee;
    font-size:.9rem;
    padding:10px 12px;
    transition:all .15s ease;
}

.filters-shell .form-control:focus,
.filters-shell .form-select:focus{
    border-color:var(--c-navy2);
    box-shadow:0 0 0 3px rgba(0,64,128,.15);
}

/* botón filtrar alineado con sistema */
.btn-filter-pro{
    background:linear-gradient(135deg, var(--c-navy), var(--c-navy2));
    color:#fff;
    border:0;
    border-radius:999px;
    padding:10px 18px;
    font-weight:800;
    font-size:.85rem;
    transition:all .18s ease;
}

.btn-filter-pro:hover{
    transform:translateY(-1px);
    filter:brightness(1.05);
}
.btn-cancel-pro{
    border:1px solid var(--border);
    background:#fff;
    color:#6c757d;

    border-radius:999px;
    padding:10px 16px;

    font-weight:800;
    font-size:.85rem;

    transition:all .15s ease;
}

.btn-cancel-pro:hover{
    background:#f8f9fa;
    color:#000;
    border-color:#d0d5dd;
}

.btn-cancel-pro:active{
    transform:scale(.98);
}


</style>


<!-- ========================= -->
<!-- FILTROS -->
<!-- ========================= -->
<form method="get" asp-action="Index" asp-controller="Users" class="filters-shell mb-3" id="usersFiltersForm">
    <div class="row g-3 align-items-end">
        <input type="hidden" name="pageNumber" value="1" />

        <div class="col-md-3">
            <label class="form-label text-muted small">Nombre</label>
            <input name="searchName" value="@ViewBag.SearchName" class="form-control" placeholder="Buscar por nombre..." />
        </div>

        <div class="col-md-3">
            <label class="form-label text-muted small">Usuario</label>
            <input name="searchDomain" value="@ViewBag.SearchDomain" class="form-control" placeholder="Buscar por usuario..." />
        </div>

        <div class="col-md-2">
            <label class="form-label text-muted small">Equipo</label>
            <select name="searchTeamId" class="form-select">
                <option value="">Todos</option>
                @foreach (var t in ViewBag.TeamList)
                {
                    <option value="@t.Value" selected="@(ViewBag.SearchTeamId?.ToString() == t.Value)">
                        @t.Text
                    </option>
                }
            </select>
        </div>

        <!-- ✅ NUEVO → ROL -->
        <div class="col-md-2">
            <label class="form-label text-muted small">Rol</label>
            <select name="searchRoleId" class="form-select">
                <option value="">Todos</option>
                @foreach (var r in ViewBag.RoleList)
                {
                    <option value="@r.Value" selected="@(ViewBag.SearchRoleId?.ToString() == r.Value)">
                        @r.Text
                    </option>
                }
            </select>
        </div>

        <!-- ✅ NUEVO → ESTADO -->
        <div class="col-md-2">
            <label class="form-label text-muted small">Estado</label>
            <select name="searchIsActive" class="form-select">
                <option value="">Todos</option>
                <option value="true" selected="@(ViewBag.SearchIsActive?.ToString() == "true")">Activo</option>
                <option value="false" selected="@(ViewBag.SearchIsActive?.ToString() == "false")">Inactivo</option>
            </select>
        </div>

        <div class="col-md-12 d-flex gap-2">
            <button type="submit" class="btn-filter-pro">
    🔎 Filtrar
</button>
        </div>

    </div>
</form>

@{
    var sn = ViewBag.SearchName as string;
    var sd = ViewBag.SearchDomain as string;
    var stId = ViewBag.SearchTeamId;
    var srId = ViewBag.SearchRoleId;
    var sa = ViewBag.SearchIsActive;
}

<!-- ========================= -->
<!-- CHIPS FILTROS ACTIVOS -->
<!-- ========================= -->
@if (!string.IsNullOrEmpty(sn) || !string.IsNullOrEmpty(sd) || stId != null || srId != null || sa != null)
{
    <div class="mb-3 d-flex flex-wrap gap-2 align-items-center">

        <!-- NOMBRE -->
        @if (!string.IsNullOrEmpty(sn))
        {
            <span class="chip">
                <span class="text-primary">Nombre:</span> @sn
                <a class="x text-decoration-none"
                   href="@Url.Action("Index", new { pageNumber = 1, searchName = (string)null, searchDomain = sd, searchTeamId = stId, searchRoleId = srId, searchIsActive = sa })">
                    ×
                </a>
            </span>
        }

        <!-- USUARIO -->
        @if (!string.IsNullOrEmpty(sd))
        {
            <span class="chip">
                <span class="text-info">Usuario:</span> @sd
                <a class="x text-decoration-none"
                   href="@Url.Action("Index", new { pageNumber = 1, searchName = sn, searchDomain = (string)null, searchTeamId = stId, searchRoleId = srId, searchIsActive = sa })">
                    ×
                </a>
            </span>
        }

        <!-- EQUIPO -->
        @if (stId != null)
        {
            var teamList = ViewBag.TeamList as IEnumerable<dynamic>;
            var selectedTeam = teamList?.FirstOrDefault(t => t.Value.ToString() == stId?.ToString());

            <span class="chip">
                <span class="text-secondary">Equipo:</span> @(selectedTeam?.Text ?? "—")
                <a class="x text-decoration-none"
                   href="@Url.Action("Index", new { pageNumber = 1, searchName = sn, searchDomain = sd, searchTeamId = (int?)null, searchRoleId = srId, searchIsActive = sa })">
                    ×
                </a>
            </span>
        }

        <!-- ROL -->
        @if (srId != null)
        {
            var roleList = ViewBag.RoleList as IEnumerable<dynamic>;
            var selectedRole = roleList?.FirstOrDefault(r => r.Value.ToString() == srId?.ToString());

            <span class="chip">
                <span class="text-info">Rol:</span> @(selectedRole?.Text ?? "—")
                <a class="x text-decoration-none"
                   href="@Url.Action("Index", new { pageNumber = 1, searchName = sn, searchDomain = sd, searchTeamId = stId, searchRoleId = (int?)null, searchIsActive = sa })">
                    ×
                </a>
            </span>
        }

        <!-- ESTADO -->
        @if (sa != null)
        {
            <span class="chip">
                <span class="text-secondary">Estado:</span> @(sa.ToString() == "true" ? "Activo" : "Inactivo")
                <a class="x text-decoration-none"
                   href="@Url.Action("Index", new { pageNumber = 1, searchName = sn, searchDomain = sd, searchTeamId = stId, searchRoleId = srId, searchIsActive = (bool?)null })">
                    ×
                </a>
            </span>
        }

        <!-- ✅ LIMPIAR TODO (NUEVO) -->
        <a class="chip text-danger fw-semibold text-decoration-none"
           href="@Url.Action("Index", "Users")"
           title="Limpiar todos los filtros">
            ✖ Limpiar todo
        </a>

    </div>
}



<!-- ========================= -->
<!-- TABLA USERS (ESTILO GUÍA) -->
<!-- Wrapper: table-shell | Tabla: table-style -->
<!-- ========================= -->
<div class="table-shell mb-3">
  <div class="table-responsive">
    <table class="table-style align-middle">
      <thead>
        <tr>
          <th style="width:28%">Nombre</th>
          <th style="width:22%">Usuario</th>
          <th style="width:18%">Equipo</th>
          <th style="width:12%">Rol</th>
          <th style="width:10%">Estado</th>
          <th style="width:10%" class="text-end">Acciones</th>
        </tr>
      </thead>

      <tbody>
        @if (Model == null || !Model.Any())
        {
          <tr>
            <td colspan="6" class="text-center text-muted py-4">
              No se encontraron usuarios.
            </td>
          </tr>
        }
        else
        {
          foreach (var u in Model)
          {
            <tr class="user-row" data-id="@u.Id">
              <td>
                <div class="fw-bold">@u.Name @u.LastName</div>
                <div class="cell-muted">@u.Id</div>
              </td>

              <td>
                <div class="fw-semibold">@u.DomainUser</div>
                <div class="cell-muted">Usuario dominio</div>
              </td>

              <td>
                @if (!string.IsNullOrWhiteSpace(u.TeamName))
                {
                  <span class="pill pill-team">@u.TeamName</span>
                }
                else
                {
                  <span class="cell-muted">—</span>
                }
              </td>

              <td>
                <span class="pill pill-role">@u.RoleName</span>
              </td>

              <td class="text-center">
                <!-- ✅ Toggle: mantiene tu funcionalidad -->
                <button type="button"
                        class="toggle-active-btn @(u.IsActive ? "pill-active" : "pill-inactive")"
                        data-id="@u.Id">
                  @(u.IsActive ? "Activo" : "Inactivo")
                </button>
              </td>

              <td class="text-end">
                <div class="actions-wrap">
                  <!-- ✅ Mantiene tu JS (edit-btn/delete-btn) -->
                  <button type="button"
                          class="btn-action btn-edit edit-btn"
                          data-id="@u.Id">
                    Editar
                  </button>

                  <button type="button"
                          class="btn-action btn-delete delete-btn"
                          data-id="@u.Id">
                    Eliminar
                  </button>
                </div>
              </td>
            </tr>
          }
        }
      </tbody>
    </table>
  </div>
</div>

<!-- ========================= -->
<!-- PAGINACIÓN -->
<!-- ========================= -->
<nav aria-label="Paginación">
    <ul class="pagination justify-content-center">

        <li class="page-item @(((int)ViewBag.PageNumber) == 1 ? "disabled" : "")">
            @if (((int)ViewBag.PageNumber) > 1)
            {
                <a class="page-link"
                   href="@Url.Action("Index", new { pageNumber = (int)ViewBag.PageNumber - 1, searchName = ViewBag.SearchName, searchDomain = ViewBag.SearchDomain, searchTeamId = ViewBag.SearchTeamId })">
                    Anterior
                </a>
            }
            else
            {
                <span class="page-link">Anterior</span>
            }
        </li>

        @for (int i = 1; i <= (int)ViewBag.TotalPages; i++)
        {
            var active = i == (int)ViewBag.PageNumber ? "active" : "";
            <li class="page-item @active">
                @if (i == (int)ViewBag.PageNumber)
                {
                    <span class="page-link">@i</span>
                }
                else
                {
                    <a class="page-link"
                       href="@Url.Action("Index", new { pageNumber = i, searchName = ViewBag.SearchName, searchDomain = ViewBag.SearchDomain, searchTeamId = ViewBag.SearchTeamId })">
                        @i
                    </a>
                }
            </li>
        }

        <li class="page-item @(((int)ViewBag.PageNumber) == (int)ViewBag.TotalPages || ((int)ViewBag.TotalPages) == 0 ? "disabled" : "")">
            @if (((int)ViewBag.TotalPages) > 0 && ((int)ViewBag.PageNumber) < (int)ViewBag.TotalPages)
            {
                <a class="page-link"
                   href="@Url.Action("Index", new { pageNumber = (int)ViewBag.PageNumber + 1, searchName = ViewBag.SearchName, searchDomain = ViewBag.SearchDomain, searchTeamId = ViewBag.SearchTeamId })">
                    Siguiente
                </a>
            }
            else
            {
                <span class="page-link">Siguiente</span>
            }
        </li>

    </ul>
</nav>

