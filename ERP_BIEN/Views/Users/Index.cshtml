                    <label class="form-label mt-3">Equipo</label>
                    <select name="TeamId" id="edit-team" class="form-select">
                        @foreach (var t in ViewBag.TeamList)
                        {
                            <option value="@t.Value">@t.Text</option>
                        }
                    </select>

                    <!-- Si ya tienes rol editable, añade aquí tu select RoleId -->
                    @* <label class="form-label mt-3">Rol</label>
                    <select name="RoleId" id="edit-role" class="form-select">
                        @foreach (var r in ViewBag.RoleList)
                        {
                            <option value="@r.Value">@r.Text</option>
                        }
                    </select> *@
