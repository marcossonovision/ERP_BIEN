@model ERP_BIEN.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}
<link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />


<div class="dashboard-shell">

    <!-- HEADER PRO -->
    <div class="dashboard-header-pro">
        <div class="dashboard-title">Bienvenido, @Model.UserName</div>
        <p class="dashboard-subtitle">
            Accede a los módulos disponibles según tus permisos.
        </p>

        <div class="dashboard-meta">
            <span class="dashboard-chip">🧭 Accesos rápidos</span>
            <span class="dashboard-chip">🛡️ RBAC por módulos</span>
        </div>
    </div>

    <!-- GRID PRO -->
    <div class="dashboard-grid">

        @if (User.HasClaim("module", "USERS"))
        {
            <a href="/Users" class="dashboard-card-pro">
                <div class="card-icon-pro icon-users">👤</div>
                <div class="card-main">
                    <div class="card-title">Gestionar Usuarios</div>
                    <p class="card-desc">Alta, baja y edición de usuarios.</p>
                    <div class="card-footer">
                        <span class="card-tag">USERS</span>
                        <span class="card-cta">Entrar →</span>
                    </div>
                </div>
            </a>
        }

        @if (User.HasClaim("module", "ROLES"))
        {
            <a href="/Roles" class="dashboard-card-pro">
                <div class="card-icon-pro icon-roles">🛡️</div>
                <div class="card-main">
                    <div class="card-title">Gestionar Roles</div>
                    <p class="card-desc">Control de permisos y perfiles.</p>
                    <div class="card-footer">
                        <span class="card-tag">ROLES</span>
                        <span class="card-cta">Entrar →</span>
                    </div>
                </div>
            </a>
        }

        @if (User.HasClaim("module", "DEVICES"))
        {
            <a href="/Devices" class="dashboard-card-pro">
                <div class="card-icon-pro icon-devices">💻</div>
                <div class="card-main">
                    <div class="card-title">Dispositivos</div>
                    <p class="card-desc">Inventario de equipos, asignación e histórico.</p>
                    <div class="card-footer">
                        <span class="card-tag">DEVICES</span>
                        <span class="card-cta">Entrar →</span>
                    </div>
                </div>
            </a>
        }

        @if (User.HasClaim("module", "LICENSES"))
        {
            <a href="/Licenses" class="dashboard-card-pro">
                <div class="card-icon-pro icon-licenses">🔑</div>
                <div class="card-main">
                    <div class="card-title">Licencias</div>
                    <p class="card-desc">Gestión de licencias, asignación e histórico.</p>
                    <div class="card-footer">
                        <span class="card-tag">LICENSES</span>
                        <span class="card-cta">Entrar →</span>
                    </div>
                </div>
            </a>
        }

        @if (User.HasClaim("module", "EMPLOYEES"))
        {
            <a href="/Employees" class="dashboard-card-pro">
                <div class="card-icon-pro icon-employees">👥</div>
                <div class="card-main">
                    <div class="card-title">Empleados</div>
                    <p class="card-desc">Datos y organización del personal.</p>
                    <div class="card-footer">
                        <span class="card-tag">EMPLOYEES</span>
                        <span class="card-cta">Entrar →</span>
                    </div>
                </div>
            </a>
        }

        @if (User.HasClaim("module", "ROLES"))
        {
            <a href="/Audit" class="dashboard-card-pro">
                <div class="card-icon-pro icon-audit">📊</div>
                <div class="card-main">
                    <div class="card-title">Auditoría</div>
                    <p class="card-desc">Registro de acciones y cambios.</p>
                    <div class="card-footer">
                        <span class="card-tag">AUDIT</span>
                        <span class="card-cta">Entrar →</span>
                    </div>
                </div>
            </a>

            <a href="/Import" class="dashboard-card-pro">
                <div class="card-icon-pro icon-audit">📥</div>
                <div class="card-main">
                    <div class="card-title">Importación</div>
                    <p class="card-desc">Carga masiva de datos.</p>
                    <div class="card-footer">
                        <span class="card-tag">IMPORT</span>
                        <span class="card-cta">Entrar →</span>
                    </div>
                </div>
            </a>
        }

        @if (User.HasClaim("module", "MY_DEVICES"))
        {
            <a href="/MyDevices" class="dashboard-card-pro">
                <div class="card-icon-pro icon-devices">🖥️</div>
                <div class="card-main">
                    <div class="card-title">Mis Dispositivos</div>
                    <p class="card-desc">Tus equipos asignados.</p>
                    <div class="card-footer">
                        <span class="card-tag">MY_DEVICES</span>
                        <span class="card-cta">Entrar →</span>
                    </div>
                </div>
            </a>
        }

        @if (User.HasClaim("module", "MY_LICENSES"))
        {
            <a href="/MyLicenses" class="dashboard-card-pro">
                <div class="card-icon-pro icon-licenses">🧾</div>
                <div class="card-main">
                    <div class="card-title">Mis Licencias</div>
                    <p class="card-desc">Software que puedes usar.</p>
                    <div class="card-footer">
                        <span class="card-tag">MY_LICENSES</span>
                        <span class="card-cta">Entrar →</span>
                    </div>
                </div>
            </a>
        }

        @if (User.HasClaim("module", "TEAM"))
        {
            <a href="/Team" class="dashboard-card-pro">
                <div class="card-icon-pro icon-employees">👨‍💼</div>
                <div class="card-main">
                    <div class="card-title">Equipo a tu cargo</div>
                    <p class="card-desc">Personas que gestionas.</p>
                    <div class="card-footer">
                        <span class="card-tag">TEAM</span>
                        <span class="card-cta">Entrar →</span>
                    </div>
                </div>
            </a>
        }

        @if (User.HasClaim("module", "MY_DATA"))
        {
            <a href="/MyData" class="dashboard-card-pro">
                <div class="card-icon-pro icon-users">📄</div>
                <div class="card-main">
                    <div class="card-title">Mis Datos</div>
                    <p class="card-desc">Información personal del usuario.</p>
                    <div class="card-footer">
                        <span class="card-tag">MY_DATA</span>
                        <span class="card-cta">Entrar →</span>
                    </div>
                </div>
            </a>
        }

    </div>
</div>
