@model ERP_BIEN.Models.ViewModels.TeamModuleIndexViewModel

@{
    ViewData["Title"] = "Equipo";
}
<link rel="stylesheet" href="~/css/team.css" asp-append-version="true" />


<!-- HEADER -->
<div class="mb-3">
    <h2 class="page-title">Equipo a tu cargo</h2>
    <div class="page-subtitle">Gestión de miembros del equipo</div>
</div>

<!-- ALERTAS -->
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

@if (!string.IsNullOrWhiteSpace(Model.InfoMessage))
{
    <div class="alert alert-info">@Model.InfoMessage</div>
}

@if (Model.ManagedTeams == null || Model.ManagedTeams.Count == 0)
{
    <div class="table-shell p-3 text-muted">
        No hay equipos asignados.
    </div>
}
else
{
    <!-- SELECTOR -->
    <form method="get" asp-controller="Team" asp-action="Index" class="filters-shell mb-3">
        <div class="row align-items-center">
            <div class="col-md-6">
                <label class="form-label fw-bold">Equipo</label>
                <select class="form-select" name="teamId" onchange="this.form.submit()">
                    @foreach (var t in Model.ManagedTeams)
                    {
                        <option value="@t.Id" selected="@(t.Id == Model.SelectedTeamId)">
                            @t.Name
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-6 text-end">
                <span class="cell-muted">
                    @Model.Members.Count miembros
                </span>
            </div>
        </div>
    </form>

    <div class="row g-3">

        <!-- MIEMBROS -->
        <div class="col-md-8">
            <div class="table-shell">

                <div class="panel-head">
                    <div class="panel-title">Miembros del equipo</div>
                    <div class="panel-sub">Usuarios asignados</div>
                </div>

                @if (Model.Members.Count == 0)
                {
                    <div class="p-3 text-muted">No hay miembros.</div>
                }
                else
                {
                    <table class="table-style">
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Usuario</th>
                                <th class="text-end">Acción</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var m in Model.Members)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold">@m.FullName</div>
                                        <div class="cell-muted">Miembro</div>
                                    </td>

                                    <td>
                                        <div class="fw-bold">@m.DomainUser</div>
                                        <div class="cell-muted">Dominio</div>
                                    </td>

                                    <td class="text-end">
                                        @if (User.HasClaim("module", "TEAM"))
                                        {
                                            <form method="post"
                                                  asp-controller="Team"
                                                  asp-action="RemoveMember"
                                                  class="d-inline">
                                                @Html.AntiForgeryToken()

                                                <input type="hidden" name="selectedTeamId" value="@Model.SelectedTeamId" />
                                                <input type="hidden" name="userId" value="@m.Id" />

                                                <button type="submit" class="btn-delete">
                                                    Quitar
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="cell-muted">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>

        <!-- AÑADIR -->
        <div class="col-md-4">
            @if (User.HasClaim("module", "TEAM"))
            {
                <div class="table-shell">

                    <div class="panel-head">
                        <div class="panel-title">Añadir miembro</div>
                        <div class="panel-sub">Usuarios disponibles</div>
                    </div>

                    <div class="p-3">
                        @if (Model.Candidates.Count == 0)
                        {
                            <div class="text-muted">No hay candidatos.</div>
                        }
                        else
                        {
                            <form method="post" asp-controller="Team" asp-action="AddMember">

                                @Html.AntiForgeryToken()

                                <input type="hidden" name="selectedTeamId" value="@Model.SelectedTeamId" />

                                <label class="form-label fw-bold">Usuario</label>

                                <select class="form-select mb-3" name="userId" required>
                                    @foreach (var c in Model.Candidates)
                                    {
                                        <option value="@c.Id">
                                            @c.FullName (@c.DomainUser)
                                        </option>
                                    }
                                </select>

                                <button type="submit" class="btn-save-pro w-100">
                                    ➕ Añadir al equipo
                                </button>
                            </form>
                        }
                    </div>
                </div>
            }
        </div>

    </div>
}