@using System.Text.Json
@model ERP_BIEN.Models.ViewModels.DevicesViewModel
@using ERP_BIEN.Common.Enums
@using ERP_BIEN.Models
<link rel="stylesheet" href="~/css/devices.css" asp-append-version="true" />


@{
    ViewData["Title"] = "Gestión de Dispositivos";

    // Helper: mantener filtros + paginación en POST (como en Licenses)
    void RenderQpHidden()
    {
        <input type="hidden" name="pageNumber" value="@Model.PageNumber" />
        <input type="hidden" name="deviceTypeFilter" value="@Model.DeviceTypeFilter" />
        <input type="hidden" name="statusFilter" value="@Model.StatusFilter" />
        <input type="hidden" name="userIdFilter" value="@Model.UserIdFilter" />
        <input type="hidden" name="hostnameFilter" value="@Model.HostnameFilter" />
        <input type="hidden" name="modelFilter" value="@Model.ModelFilter" />
        <input type="hidden" name="snFilter" value="@Model.SNFilter" />
        <input type="hidden" name="manufacturingFrom" value="@(Model.ManufacturingFrom?.ToString("yyyy-MM-dd"))" />
        <input type="hidden" name="manufacturingTo" value="@(Model.ManufacturingTo?.ToString("yyyy-MM-dd"))" />
        <input type="hidden" name="useFrom" value="@(Model.UseFrom?.ToString("yyyy-MM-dd"))" />
        <input type="hidden" name="useTo" value="@(Model.UseTo?.ToString("yyyy-MM-dd"))" />
    }
    string BuildUrl(object overrides)
{
    var route = new
    {
        pageNumber = 1,

        deviceTypeFilter = Model.DeviceTypeFilter,
        statusFilter = Model.StatusFilter,
        userIdFilter = Model.UserIdFilter,
        hostnameFilter = Model.HostnameFilter,
        modelFilter = Model.ModelFilter,
        snFilter = Model.SNFilter,

        manufacturingFrom = Model.ManufacturingFrom?.ToString("yyyy-MM-dd"),
        manufacturingTo = Model.ManufacturingTo?.ToString("yyyy-MM-dd"),
        useFrom = Model.UseFrom?.ToString("yyyy-MM-dd"),
        useTo = Model.UseTo?.ToString("yyyy-MM-dd")
    };

    return Url.Action("Index", route);
}
}

<!-- ========================= -->
<!-- HEADER PRO (igual que Users) -->
<!-- ========================= -->
<div class="header-pro d-flex justify-content-between align-items-center mb-3">

    <div>
        <h2 class="mb-0 fw-bold">Gestión de Dispositivos</h2>
        <small class="text-muted">
            Mostrando @(Model?.Devices?.Count ?? 0) dispositivos
        </small>
    </div>

    <div class="d-flex gap-2">

    <button type="button"
            class="btn btn-pill btn-create"
            data-bs-toggle="modal"
            data-bs-target="#createModal">
        + Crear Dispositivo
    </button>

    <!-- EXPORT EXCEL -->
    <a asp-controller="Devices"
       asp-action="ExportExcel"
       asp-route-pageNumber="@Model.PageNumber"
       asp-route-deviceTypeFilter="@Model.DeviceTypeFilter"
       asp-route-statusFilter="@Model.StatusFilter"
       asp-route-userIdFilter="@Model.UserIdFilter"
       asp-route-hostnameFilter="@Model.HostnameFilter"
       asp-route-modelFilter="@Model.ModelFilter"
       asp-route-snFilter="@Model.SNFilter"
       asp-route-manufacturingFrom="@(Model.ManufacturingFrom?.ToString("yyyy-MM-dd"))"
       asp-route-manufacturingTo="@(Model.ManufacturingTo?.ToString("yyyy-MM-dd"))"
       asp-route-useFrom="@(Model.UseFrom?.ToString("yyyy-MM-dd"))"
       asp-route-useTo="@(Model.UseTo?.ToString("yyyy-MM-dd"))"
       class="btn btn-pill btn-excel">

         Excel
    </a>

</div>
</div>



<!-- FILTROS AVANZADOS (PRO) CON TOGGLE -->
<form method="get">

    <div class="filters-shell mb-4">

        <!-- CABECERA CON FLECHA -->
        <div class="filters-head" onclick="toggleFilters()">
  <div>
    <div class="filters-title">Filtros de búsqueda</div>
    <div class="filters-sub">Refina por tipo, estado, usuario, hostname, modelo, SN y fechas</div>
  </div>
  <span id="filterArrow" class="filters-arrow">▼</span>
</div>

        <!-- CONTENIDO -->
        <div id="filtersBody" class="filters-body" style="display:none;">


            <!-- FILA 1 -->
            <div class="row g-3">

                <!-- TIPO -->
                <div class="col-md-2">
                    <label class="form-label text-muted small">
                        Tipo
                    </label>

                    <select class="form-select" name="DeviceTypeFilter">
                        <option value="">Todos</option>

                        <option value="Computer"
                                selected="@(Model.DeviceTypeFilter == "Computer")">
                            Computer
                        </option>

                        <option value="Phone"
                                selected="@(Model.DeviceTypeFilter == "Phone")">
                            Phone
                        </option>

                        <option value="Screen"
                                selected="@(Model.DeviceTypeFilter == "Screen")">
                            Screen
                        </option>

                        <option value="DockStation"
                                selected="@(Model.DeviceTypeFilter == "DockStation")">
                            DockStation
                        </option>
                    </select>
                </div>

                <!-- ESTADO -->
                <div class="col-md-2">
                    <label class="form-label text-muted small">
                        Estado
                    </label>

                    <select class="form-select" name="StatusFilter">
                        <option value="">Todos</option>

                        @foreach (StatusDevice s in Enum.GetValues(typeof(StatusDevice)))
                        {
                            <option value="@s"
                                    selected="@(Model.StatusFilter == s)">
                                @s
                            </option>
                        }
                    </select>
                </div>

                <!-- USUARIO -->
                <div class="col-md-2">
                    <label class="form-label text-muted small">
                        Usuario
                    </label>

                    <select class="form-select" name="UserIdFilter">
                        <option value="">Todos</option>

                        @foreach (var u in Model.Users)
                        {
                            <option value="@u.Id"
                                    selected="@(Model.UserIdFilter == u.Id)">
                                @u.Name @u.LastName
                            </option>
                        }
                    </select>
                </div>

                <!-- HOSTNAME -->
                <div class="col-md-2">
                    <label class="form-label text-muted small">
                        Hostname
                    </label>

                    <input class="form-control"
                           name="HostnameFilter"
                           value="@Model.HostnameFilter" />
                </div>

                <!-- MODELO -->
                <div class="col-md-2">
                    <label class="form-label text-muted small">
                        Modelo
                    </label>

                    <input class="form-control"
                           name="ModelFilter"
                           value="@Model.ModelFilter" />
                </div>

                <!-- SERIAL NUMBER -->
                <div class="col-md-2">
                    <label class="form-label text-muted small">
                        SN
                    </label>

                    <input class="form-control"
                           name="SNFilter"
                           value="@Model.SNFilter" />
                </div>

            </div>

            <!-- FILA 2 -->
            <div class="row g-3 mt-3">

                <!-- FABRICACION -->
                <div class="col-md-3">

                    <label class="form-label text-muted small">
                        Fabricación
                    </label>

                    <div class="d-flex gap-2">

                        <input type="date"
                               class="form-control"
                               name="ManufacturingFrom"
                               value="@(Model.ManufacturingFrom?.ToString("yyyy-MM-dd"))" />

                        <input type="date"
                               class="form-control"
                               name="ManufacturingTo"
                               value="@(Model.ManufacturingTo?.ToString("yyyy-MM-dd"))" />

                    </div>
                </div>

                <!-- USO -->
                <div class="col-md-3">

                    <label class="form-label text-muted small">
                        Uso
                    </label>

                    <div class="d-flex gap-2">

                        <input type="date"
                               class="form-control"
                               name="UseFrom"
                               value="@(Model.UseFrom?.ToString("yyyy-MM-dd"))" />

                        <input type="date"
                               class="form-control"
                               name="UseTo"
                               value="@(Model.UseTo?.ToString("yyyy-MM-dd"))" />

                    </div>
                </div>

            </div>

            <!-- BOTONES -->
            <div class="d-flex justify-content-between align-items-center mt-4">

                <div>

                    <!-- FILTRAR -->
                    
<div class="filters-actions">
  <button type="submit" class="btn btn-pill btn-filter-pro">🔍 Filtrar</button>


                    <!-- LIMPIAR -->
                    <a asp-controller="Devices" asp-action="Index" class="btn btn-pill btn-clear-pro">
                        Limpiar
                    </a>

                </div>

            </div>

        </div>

    </div>

</form>
<!-- ========================= -->
<!-- CHIPS FILTROS ACTIVOS -->
<!-- ========================= -->
<div class="mb-3 d-flex flex-wrap gap-2">

    @if (!string.IsNullOrWhiteSpace(Model.DeviceTypeFilter))
    {
        <span class="chip">
            Tipo: @Model.DeviceTypeFilter
            <a class="x"
               href="@Url.Action("Index", new {
                   deviceTypeFilter = (string)null,
                   statusFilter = Model.StatusFilter,
                   userIdFilter = Model.UserIdFilter,
                   hostnameFilter = Model.HostnameFilter,
                   modelFilter = Model.ModelFilter,
                   snFilter = Model.SNFilter,
                   manufacturingFrom = Model.ManufacturingFrom,
                   manufacturingTo = Model.ManufacturingTo,
                   useFrom = Model.UseFrom,
                   useTo = Model.UseTo
               })">✕</a>
        </span>
    }

    @if (Model.StatusFilter != null)
    {
        <span class="chip">
            Estado: @Model.StatusFilter
            <a class="x"
               href="@Url.Action("Index", new {
                   deviceTypeFilter = Model.DeviceTypeFilter,
                   statusFilter = (StatusDevice?)null,
                   userIdFilter = Model.UserIdFilter,
                   hostnameFilter = Model.HostnameFilter,
                   modelFilter = Model.ModelFilter,
                   snFilter = Model.SNFilter,
                   manufacturingFrom = Model.ManufacturingFrom,
                   manufacturingTo = Model.ManufacturingTo,
                   useFrom = Model.UseFrom,
                   useTo = Model.UseTo
               })">✕</a>
        </span>
    }

    @if (Model.UserIdFilter.HasValue)
    {
        var u = Model.Users.FirstOrDefault(x => x.Id == Model.UserIdFilter);

        <span class="chip">
            Usuario: @(u != null ? u.Name + " " + u.LastName : "")
            <a class="x"
               href="@Url.Action("Index", new {
                   deviceTypeFilter = Model.DeviceTypeFilter,
                   statusFilter = Model.StatusFilter,
                   userIdFilter = (int?)null,
                   hostnameFilter = Model.HostnameFilter,
                   modelFilter = Model.ModelFilter,
                   snFilter = Model.SNFilter,
                   manufacturingFrom = Model.ManufacturingFrom,
                   manufacturingTo = Model.ManufacturingTo,
                   useFrom = Model.UseFrom,
                   useTo = Model.UseTo
               })">✕</a>
        </span>
    }

    @if (!string.IsNullOrWhiteSpace(Model.HostnameFilter))
    {
        <span class="chip">
            Hostname: @Model.HostnameFilter
            <a class="x"
               href="@Url.Action("Index", new {
                   deviceTypeFilter = Model.DeviceTypeFilter,
                   statusFilter = Model.StatusFilter,
                   userIdFilter = Model.UserIdFilter,
                   hostnameFilter = (string)null,
                   modelFilter = Model.ModelFilter,
                   snFilter = Model.SNFilter,
                   manufacturingFrom = Model.ManufacturingFrom,
                   manufacturingTo = Model.ManufacturingTo,
                   useFrom = Model.UseFrom,
                   useTo = Model.UseTo
               })">✕</a>
        </span>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ModelFilter))
    {
        <span class="chip">
            Modelo: @Model.ModelFilter
            <a class="x"
               href="@Url.Action("Index", new {
                   deviceTypeFilter = Model.DeviceTypeFilter,
                   statusFilter = Model.StatusFilter,
                   userIdFilter = Model.UserIdFilter,
                   hostnameFilter = Model.HostnameFilter,
                   modelFilter = (string)null,
                   snFilter = Model.SNFilter,
                   manufacturingFrom = Model.ManufacturingFrom,
                   manufacturingTo = Model.ManufacturingTo,
                   useFrom = Model.UseFrom,
                   useTo = Model.UseTo
               })">✕</a>
        </span>
    }

    @if (!string.IsNullOrWhiteSpace(Model.SNFilter))
    {
        <span class="chip">
            SN: @Model.SNFilter
            <a class="x"
               href="@Url.Action("Index", new {
                   deviceTypeFilter = Model.DeviceTypeFilter,
                   statusFilter = Model.StatusFilter,
                   userIdFilter = Model.UserIdFilter,
                   hostnameFilter = Model.HostnameFilter,
                   modelFilter = Model.ModelFilter,
                   snFilter = (string)null,
                   manufacturingFrom = Model.ManufacturingFrom,
                   manufacturingTo = Model.ManufacturingTo,
                   useFrom = Model.UseFrom,
                   useTo = Model.UseTo
               })">✕</a>
        </span>
    }

    @if (Model.ManufacturingFrom.HasValue || Model.ManufacturingTo.HasValue)
{
    <span class="chip">
        Fabricación:
        @(Model.ManufacturingFrom?.ToString("dd/MM/yyyy") ?? "-")
        →
        @(Model.ManufacturingTo?.ToString("dd/MM/yyyy") ?? "-")

        <a class="x"
           href="@Url.Action("Index", new {
               deviceTypeFilter = Model.DeviceTypeFilter,
               statusFilter = Model.StatusFilter,
               userIdFilter = Model.UserIdFilter,
               hostnameFilter = Model.HostnameFilter,
               modelFilter = Model.ModelFilter,
               snFilter = Model.SNFilter,
               manufacturingFrom = (DateTime?)null,
               manufacturingTo = (DateTime?)null,
               useFrom = Model.UseFrom,
               useTo = Model.UseTo
           })">✕</a>
    </span>
}

    @if (Model.UseFrom.HasValue || Model.UseTo.HasValue)
{
    <span class="chip">
        Uso:
        @(Model.UseFrom?.ToString("dd/MM/yyyy") ?? "-")
        →
        @(Model.UseTo?.ToString("dd/MM/yyyy") ?? "-")

        <a class="x"
           href="@Url.Action("Index", new {
               deviceTypeFilter = Model.DeviceTypeFilter,
               statusFilter = Model.StatusFilter,
               userIdFilter = Model.UserIdFilter,
               hostnameFilter = Model.HostnameFilter,
               modelFilter = Model.ModelFilter,
               snFilter = Model.SNFilter,
               manufacturingFrom = Model.ManufacturingFrom,
               manufacturingTo = Model.ManufacturingTo,
               useFrom = (DateTime?)null,
               useTo = (DateTime?)null
           })">✕</a>
    </span>
}


    @{
        var hasFilters =
            !string.IsNullOrWhiteSpace(Model.DeviceTypeFilter) ||
            Model.StatusFilter != null ||
            Model.UserIdFilter.HasValue ||
            !string.IsNullOrWhiteSpace(Model.HostnameFilter) ||
            !string.IsNullOrWhiteSpace(Model.ModelFilter) ||
            !string.IsNullOrWhiteSpace(Model.SNFilter) ||
            Model.ManufacturingFrom.HasValue ||
            Model.ManufacturingTo.HasValue ||
            Model.UseFrom.HasValue ||
            Model.UseTo.HasValue;
    }

    @if (hasFilters)
    {
        <a class="btn btn-sm btn-outline-danger ms-2"
           href="@Url.Action("Index")">
            ✖ Limpiar todo
        </a>
    }

</div>

<div class="table-shell mb-3">
    <div class="table-responsive">

        <table class="table-style align-middle text-center">

            <thead>
                <tr>
                    <th>Tipo</th>
                    <th>Hostname</th>
                    <th>Modelo</th>
                    <th>SN</th>
                    <th>Estado</th>
                    <th>Usuario</th>
                    <th>Fecha uso</th>
                    <th style="width:420px;">Controles</th>
                </tr>
            </thead>

            <tbody>

            @foreach (var d in Model.Devices)
            {
                var tipo = d switch
                {
                    Computer => "Computer",
                    Phone => "Phone",
                    Screen => "Screen",
                    DockStation => "DockStation",
                    _ => "Device"
                };

                <tr class="device-row" data-id="@d.Id">

                    <!-- TIPO -->
                    <td>
    <span class="device-type-pill
        @(tipo == "Computer" ? "type-computer" :
          tipo == "Phone" ? "type-phone" :
          tipo == "Screen" ? "type-screen" :
          tipo == "DockStation" ? "type-dock" :
          "type-other")">
        @tipo
    </span>
</td>


                    <!-- HOSTNAME -->
                    <td class="fw-semibold">
                        @d.Hostname
                    </td>

                    <!-- MODELO -->
                    <td>
                        @d.Model
                    </td>

                    <!-- SN -->
                    <td class="text-muted">
                        @d.SN
                    </td>

                    <!-- ESTADO -->
                    <td>
    @if (d.Status == StatusDevice.BuenEstado)
    {
        <span class="device-status-pill status-ok">✅ Buen estado</span>
    }
    else
    {
        <span class="device-status-pill status-bad">⛔ Defectuoso</span>
    }
</td>


                    <!-- USUARIO -->
                    <td>
                        @(d.User != null
                            ? d.User.Name + " " + d.User.LastName
                            : "-")
                    </td>

                    <!-- FECHA -->
                    <td>
                        @(d.UseDate?.ToString("dd/MM/yyyy") ?? "-")
                    </td>

                    <!-- ACCIONES -->
                    <td>
                        <div class="actions-wrap device-actions">

                            @if (d.UserId == null)
                            {
                                <button type="button"
                                        class="btn-action btn-assign"
                                        onclick="event.stopPropagation(); openAssignModal(@d.Id);">
                                    👤 Asignar
                                </button>
                            }
                            else
                            {
                                <form class="d-inline"
                                      method="post"
                                      asp-action="Unassign"
                                      asp-controller="Devices"
                                      onclick="event.stopPropagation();">

                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="deviceId" value="@d.Id" />
                                    @{ RenderQpHidden(); }

                                    <button type="submit"
                                            class="btn-action btn-unassign">
                                        ❌ Quitar
                                    </button>

                                </form>
                            }

                            <button type="button"
                                    class="btn-action btn-history"
                                    onclick="event.stopPropagation(); loadHistory(@d.Id, '@d.Hostname');">
                                🔍 Histórico
                            </button>

                            <button type="button"
                                    class="btn-action btn-delete"
                                    data-bs-toggle="modal"
                                    data-bs-target="#deleteModal"
                                    data-id="@d.Id"
                                    data-name="@d.Hostname"
                                    onclick="event.stopPropagation();">
                                🗑️ Eliminar
                            </button>

                        </div>
                    </td>

                </tr>
            }

            </tbody>

        </table>

    </div>
</div>
  @if (Model.TotalPages > 1)
{
    <nav class="mt-2 d-flex justify-content-center">

        <ul class="pagination justify-content-center">

            <!-- Anterior -->
            <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                <a class="page-link"
   href="@Url.Action("Index", new {
        pageNumber = Model.PageNumber - 1,
        deviceTypeFilter = Model.DeviceTypeFilter,
        statusFilter = Model.StatusFilter,
        userIdFilter = Model.UserIdFilter,
        hostnameFilter = Model.HostnameFilter,
        modelFilter = Model.ModelFilter,
        snFilter = Model.SNFilter,
        manufacturingFrom = Model.ManufacturingFrom,
        manufacturingTo = Model.ManufacturingTo,
        useFrom = Model.UseFrom,
        useTo = Model.UseTo
   })">
    «
</a>
            </li>

            <!-- NÚMEROS -->
@for (int i = 1; i <= Model.TotalPages; i++)
{
    <li class="page-item @(i == Model.PageNumber ? "active" : "")">

        <a class="page-link"
           href="@Url.Action("Index", new {
                pageNumber = i,
                deviceTypeFilter = Model.DeviceTypeFilter,
                statusFilter = Model.StatusFilter,
                userIdFilter = Model.UserIdFilter,
                hostnameFilter = Model.HostnameFilter,
                modelFilter = Model.ModelFilter,
                snFilter = Model.SNFilter,
                manufacturingFrom = Model.ManufacturingFrom,
                manufacturingTo = Model.ManufacturingTo,
                useFrom = Model.UseFrom,
                useTo = Model.UseTo
           })">

            @i

        </a>

    </li>
}

            <!-- Siguiente -->
            <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : "")">
                <a class="page-link"
   href="@Url.Action("Index", new {
        pageNumber = Model.PageNumber + 1,
        deviceTypeFilter = Model.DeviceTypeFilter,
        statusFilter = Model.StatusFilter,
        userIdFilter = Model.UserIdFilter,
        hostnameFilter = Model.HostnameFilter,
        modelFilter = Model.ModelFilter,
        snFilter = Model.SNFilter,
        manufacturingFrom = Model.ManufacturingFrom,
        manufacturingTo = Model.ManufacturingTo,
        useFrom = Model.UseFrom,
        useTo = Model.UseTo
   })">
    »
</a>

            </li>

        </ul>
    </nav>
}

@if (!Model.Devices.Any())
{
    <p class="text-muted mt-3">No se encontraron dispositivos.</p>
}
<!-- ========================= -->
<!-- CREATE MODAL (PRO + WIZARD 2 PASOS) -->
<!-- ========================= -->
<div class="modal fade modal-pro" id="createModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content modal-pro-card">

      <!-- FORM -->
      <form method="post"
            asp-action="Create"
            asp-controller="Devices"
            onsubmit="showToast('Creando dispositivo...', 'info')">

        <!-- HEADER -->
        <div class="modal-header d-flex align-items-center justify-content-between">

          <div class="d-flex align-items-center gap-3">
            <div class="modal-pro-icon navy">➕</div>
            <div>
              <h5 class="modal-title fw-bold mb-0">Crear Dispositivo</h5>
              <div class="small opacity-75">Alta de dispositivo en el inventario</div>
            </div>
          </div>

          <button type="button"
                  class="btn-close btn-close-white"
                  data-bs-dismiss="modal"
                  aria-label="Cerrar"></button>

        </div>

        <!-- BODY -->
        <div class="modal-body modal-pro-body">

          <!-- PREVIEW -->
          <div class="preview-box mb-4">
            <div class="preview-title" id="createWizardTitle">
              Paso 1/2 · Información básica
            </div>
            <div class="preview-sub">
              Completa los datos principales del dispositivo
            </div>
          </div>

          <!-- STEP 1 -->
          <div id="step1">
            <div class="row g-3">

              <div class="col-md-6">
                <label class="form-label tiny-label">Tipo</label>
                <select class="form-select input-pro" name="deviceType" required>
                  <option value="">-- Seleccionar --</option>
                  <option value="Computer">Computer</option>
                  <option value="Phone">Phone</option>
                  <option value="Screen">Screen</option>
                  <option value="DockStation">DockStation</option>
                </select>
              </div>

              <div class="col-md-6">
                <label class="form-label tiny-label">Hostname</label>
                <input class="form-control input-pro" name="hostname" required />
              </div>

              <div class="col-md-6">
                <label class="form-label tiny-label">Modelo</label>
                <input class="form-control input-pro" name="model" />
              </div>

              <div class="col-md-6">
                <label class="form-label tiny-label">SN</label>
                <input class="form-control input-pro" name="sn" />
              </div>

            </div>
          </div>

          <!-- STEP 2 -->
          <div id="step2" style="display:none;">
            <div class="row g-3">

              <div class="col-md-4">
                <label class="form-label tiny-label">Número</label>
                <input type="number" class="form-control input-pro" name="numberOfDevice" value="1" min="1" />
              </div>

              <div class="col-md-4">
                <label class="form-label tiny-label">Fabricación</label>
                <input type="date" class="form-control input-pro" name="manufacturingDate" />
              </div>

              <div class="col-md-4">
                <label class="form-label tiny-label">Estado</label>
                <select class="form-select input-pro" name="status">
                  @foreach (StatusDevice s in Enum.GetValues(typeof(StatusDevice)))
                  {
                    <option value="@s">@s</option>
                  }
                </select>
              </div>

              <div class="col-12">
                <label class="form-label tiny-label">Comentario</label>
                <textarea class="form-control input-pro" name="comment" rows="2"></textarea>
              </div>

              <div class="col-12">
                <label class="form-label tiny-label">Usuario</label>
                <select class="form-select input-pro" name="userId">
                  <option value="">-- Sin asignar --</option>
                  @foreach (var u in Model.Users)
                  {
                    <option value="@u.Id">@u.Name @u.LastName</option>
                  }
                </select>
              </div>

            </div>
          </div>

        </div>

        <!-- FOOTER -->
        <div class="modal-footer modal-pro-footer d-flex justify-content-between">

          <button type="button"
                  class="btn-pill btn-cancel-pro"
                  onclick="prevStep()"
                  id="btnPrev"
                  style="display:none;">
            ← Atrás
          </button>

          <div class="d-flex gap-2">

            <button type="button"
                    class="btn-pill btn-next-pro"
                    onclick="nextStep()"
