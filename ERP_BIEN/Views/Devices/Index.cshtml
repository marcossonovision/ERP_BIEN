// ======================================
// FILTROS DEVICES: TOGGLE + PERSISTENCIA (COMPLETO)
// ======================================

// Deja el estado visual consistente (y evita errores si faltan elementos)
function setFiltersOpen(isOpen) {
    const body = document.getElementById("filtersBody");
    const arrow = document.getElementById("filterArrow");

    // Si no existe el DOM todavía, no hagas nada (evita errores)
    if (!body || !arrow) return;

    body.style.display = isOpen ? "block" : "none";
    arrow.innerText = isOpen ? "▲" : "▼";
    localStorage.setItem("devicesFiltersOpen", isOpen ? "true" : "false");
}

// Mantiene el mismo nombre porque tu HTML llama onclick="toggleFilters()"
function toggleFilters() {
    const body = document.getElementById("filtersBody");
    const arrow = document.getElementById("filterArrow");

    // Si faltan IDs, no rompas nada
    if (!body || !arrow) return;

    // Si está visible => cerrar, si no => abrir
    const isCurrentlyOpen = body.style.display === "block";
    setFiltersOpen(!isCurrentlyOpen);
}

// Restaurar estado al cargar (SOLO UNA VEZ)
document.addEventListener("DOMContentLoaded", function () {
    const savedState = localStorage.getItem("devicesFiltersOpen");

    // Si es la primera vez, elige comportamiento por defecto:
    // - true  => abierto por defecto (recomendado para que "se vea" que hay filtros)
    // - false => cerrado por defecto
    const defaultOpen = true;

    if (savedState === null) {
        setFiltersOpen(defaultOpen);
        return;
    }

    setFiltersOpen(savedState === "true");
});

    </script>
  
}