// ========= HISTÓRICO TIMELINE PRO (FIX)
// - Usa endpoint JSON correcto
// - Maneja HTML/redirect/errores sin romper
async function loadHistory(deviceId, hostname) {

    // UI refs
    const modalEl  = document.getElementById("historyModal");
    const modal    = bootstrap.Modal.getOrCreateInstance(modalEl);

    const titleEl  = document.getElementById("historyTitle");              // si existe en tu modal antiguo
    const nameEl   = document.getElementById("history-device-name");       // en tu modal pro
    const timeline = document.getElementById("historyTimeline");           // en tu modal pro
    const empty    = document.getElementById("historyEmpty");              // en tu modal pro

    if (titleEl) titleEl.innerText = `Histórico - ${hostname || ""}`;
    if (nameEl)  nameEl.innerText  = hostname || "Dispositivo";

    if (timeline) timeline.innerHTML = "";
    if (empty) { empty.style.display = "none"; empty.innerText = "Sin histórico disponible"; }

    // ✅ IMPORTANTE: endpoint JSON (el que suele existir en DevicesController)
    // Cambia SOLO esta ruta si tu controller usa otro nombre.
    const url = `/Devices/HistoryJson?deviceId=${encodeURIComponent(deviceId)}`;

    try {
        const res = await fetch(url, { headers: { "Accept": "application/json" } });

        if (!res.ok) {
            // Si es 302/login o 500, aquí cae
            throw new Error(`HTTP ${res.status}`);
        }

        // ✅ Verifica que realmente sea JSON
        const ct = res.headers.get("content-type") || "";
        if (!ct.includes("application/json")) {
            const txt = await res.text();
            console.error("History endpoint NO devolvió JSON. Content-Type:", ct, "Body:", txt);
            throw new Error("El histórico no devolvió JSON (posible redirect o vista HTML).");
        }

        const rows = await res.json();

        if (!rows || rows.length === 0) {
            if (empty) empty.style.display = "block";
            modal.show();
            return;
        }

        // ✅ Normaliza distintos formatos de backend
        // Soporta: {userName, startDate, endDate} o {UserName, StartDate, EndDate}
        // o tu formato nuevo {title, date, description}
        rows.forEach(r => {

            // Caso A: formato “asignaciones”
            const user = r.userName ?? r.UserName ?? null;
            const start = r.startDate ?? r.StartDate ?? null;
            const end = r.endDate ?? r.EndDate ?? null;

            // Caso B: formato “timeline”
            const title = r.title ?? r.Title ?? (user ? `Asignado a ${user}` : "Evento");
            const date  = r.date  ?? r.Date  ?? start ?? "-";
            const desc  = r.description ?? r.Description
                       ?? (user ? `Desde ${start ?? "-"}${end ? ` → ${end}` : " → Actual"}` : "");

            if (timeline) {
                const item = document.createElement("div");
                item.className = "history-item";
                item.innerHTML = `
                    <div class="dot"></div>
                    <div class="content">
                        <div class="d-flex justify-content-between">
                            <div class="fw-bold">${escapeHtml(title)}</div>
                            <div class="text-muted small">${escapeHtml(date)}</div>
                        </div>
                        <div class="text-muted small">${escapeHtml(desc)}</div>
                    </div>
                `;
                timeline.appendChild(item);
            }
        });

        modal.show();

    } catch (err) {
        console.error("Error cargando histórico:", err);

        if (empty) {
            empty.style.display = "block";
            empty.innerText = "Error cargando histórico ❌";
        }

        showToast("Error cargando histórico ❌", "error");
        modal.show();
    }
}

// helper seguro
function escapeHtml(str) {
    return (str ?? "").toString()
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
}


// ========= TOAST (ARREGLADO: NO contiene otras funciones dentro)
function showToast(message, type = "success") {
    const toastEl = document.getElementById('appToast');
    const toastMessage = document.getElementById('toastMessage');

    toastMessage.innerText = message;

    toastEl.className = "toast align-items-center text-white border-0";
    if (type === "success") toastEl.classList.add("bg-success");
    if (type === "error") toastEl.classList.add("bg-danger");
    if (type === "info") toastEl.classList.add("bg-primary");

    new bootstrap.Toast(toastEl).show();
}

// ========= ASSIGN MODAL (lista + buscador)
const assignModalInstance = new bootstrap.Modal(document.getElementById("assignModal"));
const assignDeviceId = document.getElementById("assignDeviceId");
const assignUserId = document.getElementById("assignUserId");
const assignSearch = document.getElementById("assignUserSearch");
const assignResults = document.getElementById("assignUserResults");
const assignSubmit = document.getElementById("assignSubmit");

function renderUserResults(list) {
    assignResults.innerHTML = "";

    if (!list || list.length === 0) {
        const empty = document.createElement("div");
        empty.className = "list-group-item text-muted";
        empty.textContent = "No hay resultados";
        assignResults.appendChild(empty);
        return;
    }

    list.forEach(u => {
        const b = document.createElement("button");
        b.type = "button";
        b.className = "list-group-item list-group-item-action";
        b.textContent = u.name;

        b.addEventListener("click", () => {
            assignUserId.value = u.id;
            assignSubmit.disabled = false;

            [...assignResults.children].forEach(x => x.classList.remove("active"));
            b.classList.add("active");
        });

        assignResults.appendChild(b);
    });
}

function openAssignModal(deviceId) {
    assignDeviceId.value = deviceId;
    assignUserId.value = "";
    assignSubmit.disabled = true;
    assignSearch.value = "";
    assignResults.innerHTML = "";

    renderUserResults(users.slice(0, 15));

    assignModalInstance.show();
    setTimeout(() => assignSearch.focus(), 200);
}

assignSearch?.addEventListener("input", function () {
    const q = (this.value || "").trim().toLowerCase();
    if (!q) { renderUserResults(users.slice(0, 15)); return; }
    renderUserResults(users.filter(u => (u.name || "").toLowerCase().includes(q)).slice(0, 20));
});

// ========= ✅ ACTUALIZAR UI INMEDIATA (ESTO TE FALTABA)
function updateAssignedUI(deviceId, userId) {

    const row = document.querySelector(`tr.device-row[data-id="${deviceId}"]`);
    if (!row) return;

    // ✅ USUARIO
    const userCell = row.children[5];
